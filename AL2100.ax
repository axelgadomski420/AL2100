// ============================================================================
// AL2100 — JEDEN PLIK. JEDEN KOD. CAŁA APLIKACJA.
// Prywatny, polskojęzyczny system operacyjny AI dla Axela.
// Kompilacja: node axc.js AL2100.ax --out dist/
// Sekrety (Cloudflare): AL_MASTER_ENCRYPTION_KEY, AL_DEV_LOGIN
// ============================================================================
// SEKCJE: app, theme, permissions, sync, ai, state, storage, component*,
//         screen*, logic, flow, on, every, api, deploy, test*
// ============================================================================

app "AL2100" {
  version: "1.0.0",
  lang: ["pl", "en"],
  author: "Axel G"
}

theme {
  bg: "#06080F",
  surface: "#121A2E",
  text: "#EAF2FF",
  primary: "#00E5FF",
  muted: "#8A99B8",
  border: "#2A3550",
  secondary: "#7C4DFF",
  success: "#22D3A6",
  warning: "#FFB020",
  danger: "#FF4D6D",
  radius: 14,
  font: "system-ui"
}

permissions {
  internet: ["api.github.com", "api.mistral.ai", "api.groq.com", "openrouter.ai", "api.openai.com"],
  microphone: "ask",
  camera: "ask",
  notifications: "ask"
}

sync {
  scope: ["Conversation", "Message", "MemoryFact", "Project"],
  encrypt: "atRest",
  offlineQueue: false
}

ai {
  budget_daily: 10.0,
  budget_monthly: 100.0,
  default: "mistral",
  max_output_tokens: 8000
}

// ============================================================================
// STATE (reaktywny, client-side)
// ============================================================================
state {
  auth.user_id = null
  auth.login = null
  auth.name = null
  auth.checked = false
  auth.onboarding_complete = false
  auth.sessions = []
  nav.current_screen = "Login"
  nav.command_palette = false
  chat.current_conversation_id = null
  chat.conversations = []
  chat.messages = []
  chat.draft = ""
  chat.is_streaming = false
  chat.stream_handle = null
  chat.selected_provider = null
  memory.facts = []
  memory.new_kind = "fact"
  memory.new_content = ""
  providers.list = []
  providers.new_provider = "mistral"
  providers.new_model = ""
  providers.new_key = ""
  approvals.list = []
  approvals.current = null
  diagnostics.today_cost = 0
  diagnostics.audit = []
  ui.toast = null
  ui.confirm = null

  computed is_authenticated {
    if auth.user_id != null { return true }
    return false
  }
  computed context_status_label {
    if chat.is_streaming { return "Generuję odpowiedź…" }
    return "Kontekst rozmowy gotowy"
  }
  computed current_conversation {
    let found = null
    for c in chat.conversations {
      if c.id == chat.current_conversation_id { found = c }
    }
    return found
  }

  event auth.user_id changed {
    if auth.user_id != null { nav.go("Chat") } else { nav.go("Login") }
  }
  event chat.current_conversation_id changed {
    if chat.current_conversation_id != null {
      loadMessages(chat.current_conversation_id)
    } else {
      chat.messages = []
    }
  }
}

// ============================================================================
// STORAGE (modele D1; user_id owner = automatyczna izolacja per user)
// ============================================================================
storage local "al2100" version 1 {
  model User {
    id text primary;
    github_login text unique;
    display_name text;
    onboarding_complete bool = false;
    created_at datetime
  }
  model Session {
    id text primary;
    user_id text owner index;
    created_at datetime;
    expires_at datetime;
    revoked_at datetime optional;
    user_agent text optional
  }
  model Conversation {
    id text primary;
    user_id text owner index;
    title text;
    is_private bool = false;
    archived_at datetime optional;
    created_at datetime;
    updated_at datetime
  }
  model Message {
    id text primary;
    conversation_id text index;
    user_id text owner index;
    role enum ["user", "assistant", "system"];
    content text;
    status enum ["pending", "streaming", "completed", "interrupted", "failed"] = "pending";
    provider text optional;
    model text optional;
    tokens_out int = 0;
    created_at datetime
  }
  model MemoryFact {
    id text primary;
    user_id text owner index;
    kind enum ["preference", "decision", "fact", "style"];
    content text;
    source text optional;
    pinned bool = false;
    disabled bool = false;
    created_at datetime
  }
  model Provider {
    id text primary;
    user_id text owner index;
    provider text;
    encrypted_key text secret;
    key_version int = 1;
    model text optional;
    status text = "unverified";
    last_error text optional;
    created_at datetime
  }
  model Approval {
    id text primary;
    user_id text owner index;
    action text;
    parameters text optional;
    token_hash text optional;
    status text = "pending";
    approved_at datetime optional;
    consumed_at datetime optional;
    expires_at datetime;
    created_at datetime
  }
  model AuditLog {
    id text primary;
    user_id text owner index;
    action text;
    target_id text optional;
    metadata text optional;
    created_at datetime
  }
  model UsageRecord {
    id text primary;
    user_id text owner index;
    kind text;
    provider text optional;
    model text optional;
    tokens_out int = 0;
    cost_usd real = 0;
    created_at datetime
  }
}

// ============================================================================
// COMPONENTS
// ============================================================================
component AppShell {
  row gap=0 {
    if is_authenticated { Sidebar() }
    main { slot }
  }
  ToastBanner()
  ConfirmDialog()
  if nav.command_palette { CommandPalette() }
}

component Sidebar {
  sidebar {
    text "AL2100" style="heading"
    divider
    NavItem("Czat", "Chat")
    NavItem("Pamięć", "Memory")
    NavItem("Dostawcy", "Providers")
    NavItem("Bezpieczeństwo", "Security")
    NavItem("Diagnostyka", "Diagnostics")
    NavItem("Zatwierdzenia", "Approvals")
    divider
    button "Wyloguj" tone="ghost" { on click { logout() } }
  }
}

component NavItem(label, target) {
  button label=label tone=(target == nav.current_screen ? "primary" : "ghost") { on click { nav.go(target) } }
}

component ToastBanner {
  if ui.toast != null {
    banner tone=(ui.toast.kind == null ? "info" : ui.toast.kind) {
      text value=ui.toast.message
    }
  }
}

component ConfirmDialog {
  if ui.confirm != null {
    modal {
      text "Potwierdzenie" style="heading"
      text value=ui.confirm.message
      row gap=8 {
        button "Potwierdź" tone="danger" {
          on click {
            if ui.confirm != null { ui.confirm.on_yes() }
            ui.confirm = null
          }
        }
        button "Anuluj" tone="ghost" { on click { ui.confirm = null } }
      }
    }
  }
}

component CommandPalette {
  modal {
    text "Paleta komend" style="heading"
    text "Ctrl/Cmd+K otwiera i zamyka" style="muted"
    button "Nowa rozmowa" tone="primary" { on click { nav.command_palette = false; newConversation() } }
    button "Czat" tone="ghost" { on click { nav.command_palette = false; nav.go("Chat") } }
    button "Pamięć" tone="ghost" { on click { nav.command_palette = false; nav.go("Memory") } }
    button "Dostawcy AI" tone="ghost" { on click { nav.command_palette = false; nav.go("Providers") } }
    button "Diagnostyka" tone="ghost" { on click { nav.command_palette = false; nav.go("Diagnostics") } }
    button "Zatwierdzenia" tone="ghost" { on click { nav.command_palette = false; nav.go("Approvals") } }
    button "Wyloguj" tone="danger" { on click { nav.command_palette = false; logout() } }
    button "Zamknij" tone="ghost" { on click { nav.command_palette = false } }
  }
}

component EmptyState(icon_name, title, desc) {
  center {
    badge value=icon_name tone="muted"
    text value=title style="heading" align="center"
    text value=desc tone="muted" align="center"
  }
}

component MessageBubble(m) {
  card {
    row gap=8 {
      badge value=m.role
      if m.status != "completed" { badge value=m.status tone="warning" }
      button "Kopiuj" tone="ghost" { on click { clipboard.write(m.content); toast("Skopiowano", "success") } }
      if m.role == "user" {
        button "Usuń" tone="danger" { on click { deleteMessage(m.id) } }
      }
    }
    markdown value=m.content
  }
}

component MemoryItem(f) {
  card {
    row gap=8 {
      badge value=f.kind
      if f.pinned { badge value="przypięty" tone="success" }
      if f.disabled { badge value="wyłączony" tone="muted" }
    }
    text value=f.content
    row gap=8 {
      button "Przypnij" tone="ghost" { on click { pinMemoryFact(f.id) } }
      button "Przełącz" tone="ghost" { on click { toggleMemoryFact(f.id) } }
      button "Usuń" tone="danger" { on click { requestApproval("memory.mutate", { id: f.id }) } }
    }
  }
}

// ============================================================================
// SCREENS
// ============================================================================
screen Login {
  AppShell() {
    center {
      stack gap=16 pad=24 {
        text "AL2100" style="heading" size="xxl" align="center"
        text "Prywatny system operacyjny AI" tone="muted" align="center"
        button "Zaloguj (dev)" tone="primary" { on click { devLogin() } }
        text "Sesja 30 dni. Klucze API szyfrowane AES-256-GCM." style="muted" align="center"
      }
    }
  }
}

screen Onboarding {
  AppShell() {
    center {
      stack gap=12 pad=24 {
        text "Witaj w AL2100" style="heading" align="center"
        text "Dodaj dostawcę AI, aby zacząć rozmowę." tone="muted" align="center"
        button "Dodaj dostawcę" tone="primary" { on click { nav.go("Providers") } }
        button "Pomiń i czatuj" tone="ghost" { on click { finishOnboarding() } }
      }
    }
  }
}

screen Chat {
  AppShell() {
    row gap=0 {
      if is_authenticated {
        sidebar {
          text "Rozmowy" style="heading"
          button "Nowa rozmowa" tone="primary" { on click { newConversation() } }
          list items=chat.conversations {
            item {
              button label=item.title tone=(item.id == chat.current_conversation_id ? "primary" : "ghost") {
                on click { chat.current_conversation_id = item.id }
              }
            }
            empty { text "Brak rozmów" tone="muted" }
          }
        }
      }
      main {
        stack gap=12 pad=16 {
          if chat.messages.length == 0 {
            EmptyState("chat", "Zacznij rozmowę", "AL2100 działa na Twoich danych. Nic nie wychodzi poza Twoje konto.")
          }
          for m in chat.messages { MessageBubble(m) }
          card {
            textarea bind=chat.draft rows=3 placeholder="Napisz wiadomość…"
            row gap=8 {
              text value=context_status_label tone="muted"
            }
            row gap=8 {
              button "Wyślij" tone="primary" disabled=(chat.draft == "" || chat.is_streaming) { on click { sendMessage() } }
              if chat.is_streaming { button "Stop" tone="danger" { on click { stopGeneration() } } }
            }
          }
        }
      }
    }
  }
}

screen Memory {
  AppShell() {
    main {
      stack gap=12 pad=16 {
        text "Pamięć" style="heading"
        text "Fakty, decyzje i preferencje. Odpowiedź modelu nigdy nie staje się faktem bez Twojej zgody." tone="muted"
        card {
          select bind=memory.new_kind options=["fact", "preference", "decision", "style"]
          textarea bind=memory.new_content rows=2 placeholder="Nowy fakt…"
          button "Dodaj" tone="primary" disabled=(memory.new_content == "") { on click { addMemoryFact() } }
        }
        for f in memory.facts { MemoryItem(f) }
        if memory.facts.length == 0 { EmptyState("memory", "Brak faktów", "Dodaj pierwszy fakt pamięci powyżej.") }
      }
    }
  }
}

screen Providers {
  AppShell() {
    main {
      stack gap=12 pad=16 {
        text "Dostawcy AI" style="heading"
        text "Klucz jest szyfrowany AES-256-GCM i nigdy nie wraca do przeglądarki." tone="muted"
        card {
          select bind=providers.new_provider options=["mistral", "groq", "openrouter", "openai"]
          input bind=providers.new_model placeholder="Model"
          input bind=providers.new_key placeholder="Klucz API" type="password"
          button "Zapisz" tone="primary" disabled=(providers.new_key == "") { on click { saveProviderKey() } }
        }
        for p in providers.list {
          card {
            row gap=8 {
              badge value=p.provider tone="primary"
              badge value=p.status tone=(p.status == "verified" ? "success" : "warning")
              text value=p.masked mono=true
            }
            row gap=8 {
              button "Testuj" tone="secondary" { on click { testProvider(p.id) } }
              button "Usuń" tone="danger" { on click { requestApproval("provider.delete", { id: p.id }) } }
            }
          }
        }
      }
    }
  }
}

screen Security {
  AppShell() {
    main {
      stack gap=12 pad=16 {
        text "Bezpieczeństwo i sesje" style="heading"
        row gap=8 {
          button "Wyloguj" tone="secondary" { on click { logout() } }
          button "Wyloguj wszystkie urządzenia" tone="danger" { on click { requestApproval("sessions.revoke_all", {}) } }
        }
        for s in auth.sessions {
          card {
            row gap=8 {
              badge value=(s.revoked_at == null ? "aktywna" : "odwołana") tone=(s.revoked_at == null ? "success" : "muted")
              text value=s.user_agent tone="muted"
            }
            if s.revoked_at == null { button "Odwołaj" tone="ghost" { on click { revokeSession(s.id) } } }
          }
        }
      }
    }
  }
}

screen Diagnostics {
  AppShell() {
    main {
      stack gap=12 pad=16 {
        text "Diagnostyka" style="heading"
        card title="Użycie dzisiaj" {
          text value=("Koszt: " + diagnostics.today_cost + " USD") tone="primary"
        }
        text value="Audit log (tylko dane z serwera):" style="muted"
        for l in diagnostics.audit {
          card {
            text value=l.action mono=true
            text value=l.created_at tone="muted"
          }
        }
        button "Odśwież" tone="secondary" { on click { loadDiagnostics() } }
      }
    }
  }
}

screen Approvals {
  AppShell() {
    main {
      stack gap=12 pad=16 {
        text "Zatwierdzenia" style="heading"
        text "Operacje wymagające Twojej zgody. Token jednorazowy, wygasa po 10 minutach." tone="muted"
        for a in approvals.list {
          card {
            text value=a.action mono=true style="heading"
            text value=a.parameters mono=true tone="muted"
            text value=("Wygasa: " + a.expires_at) tone="muted"
            row gap=8 {
              button "Zatwierdź i wykonaj" tone="danger" { on click { approveCurrent(a.id) } }
              button "Odrzuć" tone="ghost" { on click { rejectCurrent(a.id) } }
            }
          }
        }
        if approvals.list.length == 0 { EmptyState("shield", "Brak żądań", "Nie ma nic do zatwierdzenia.") }
      }
    }
  }
}

screen NotFound {
  AppShell() {
    center {
      stack gap=12 pad=24 {
        text "404" style="heading" size="xxl" align="center"
        text "Nie ma takiego ekranu." tone="muted" align="center"
        button "Wróć do czatu" tone="primary" { on click { nav.go("Chat") } }
      }
    }
  }
}

// ============================================================================
// LOGIC (funkcje klienta)
// ============================================================================
logic {

  async function checkSession() {
    auth.checked = true
    await api.get("/api/csrf")
    let r = await api.get("/api/auth/me")
    if r.ok {
      auth.user_id = r.body.id
      auth.login = r.body.login
      auth.name = r.body.name
      auth.onboarding_complete = r.body.onboarding_complete
      loadInitialData()
    } else {
      auth.user_id = null
    }
  }

  async function devLogin() {
    let r = await api.post("/api/auth/dev", { login: "axel" })
    if r.ok {
      auth.user_id = r.body.id
      auth.login = r.body.login
      auth.name = r.body.name
      auth.checked = true
      loadInitialData()
    } else {
      toast("Dev login wyłączony (ustaw AL_DEV_LOGIN=1)", "warning")
    }
  }

  async function logout() {
    await api.post("/api/auth/logout", {})
    auth.user_id = null
    auth.login = null
    auth.name = null
    auth.sessions = []
    chat.conversations = []
    chat.messages = []
    chat.current_conversation_id = null
    nav.go("Login")
    toast("Wylogowano", "info")
  }

  async function loadInitialData() {
    let c = await api.get("/api/conversations")
    if c.ok { chat.conversations = c.body }
    let m = await api.get("/api/memory")
    if m.ok { memory.facts = m.body }
    let p = await api.get("/api/providers")
    if p.ok { providers.list = p.body }
    let s = await api.get("/api/auth/sessions")
    if s.ok { auth.sessions = s.body }
    let u = await api.get("/api/usage/today")
    if u.ok { diagnostics.today_cost = u.body.cost }
    loadApprovals()
  }

  async function newConversation() {
    let r = await api.post("/api/conversations", {})
    if r.ok {
      chat.conversations = [r.body] + chat.conversations
      chat.current_conversation_id = r.body.id
      chat.messages = []
    } else { handleApiError(r) }
  }

  async function loadMessages(id) {
    let r = await api.get("/api/conversations/" + id + "/messages")
    if r.ok { chat.messages = r.body }
  }

  async function sendMessage() {
    if chat.draft == "" { return }
    if chat.is_streaming { return }
    let cid = chat.current_conversation_id
    if cid == null {
      let nc = await api.post("/api/conversations", {})
      if nc.ok {
        chat.conversations = [nc.body] + chat.conversations
        cid = nc.body.id
        chat.current_conversation_id = cid
      } else { handleApiError(nc); return }
    }
    let text = chat.draft
    chat.draft = ""
    chat.is_streaming = true
    let res = await api.post("/api/conversations/" + cid + "/messages", { content: text })
    if res.ok {
      chat.messages = chat.messages + [res.body]
      chat.stream_handle = stream("/api/conversations/" + cid + "/generate", { provider: chat.selected_provider }, {
        onDelta: (ev) => {
          let last = chat.messages[chat.messages.length - 1]
          if last != null {
            if last.role == "assistant" {
              last.content = last.content + ev.delta
            } else {
              chat.messages = chat.messages + [{ id: "stream", role: "assistant", content: ev.delta, status: "streaming" }]
            }
          }
        },
        onDone: (ev) => { chat.is_streaming = false; loadMessages(cid); loadApprovals() },
        onError: (ev) => { chat.is_streaming = false; toast("Błąd generacji", "danger") }
      })
    } else {
      chat.is_streaming = false
      handleApiError(res)
    }
  }

  async function stopGeneration() {
    if chat.stream_handle != null { chat.stream_handle.abort() }
    let cid = chat.current_conversation_id
    chat.is_streaming = false
    if cid != null {
      await api.post("/api/conversations/" + cid + "/stop", {})
      loadMessages(cid)
    }
  }

  async function deleteMessage(id) {
    confirmBox("Usunąć wiadomość?", () => {
      await api.delete("/api/messages/" + id, null, null)
      loadMessages(chat.current_conversation_id)
    })
  }

  function handleApiError(r) {
    if r.status == 401 {
      auth.user_id = null
      nav.go("Login")
      toast("Sesja wygasła. Zaloguj się ponownie.", "warning")
    } else {
      if r.body != null { toast(r.body.error, "danger") } else { toast("Błąd sieci", "danger") }
    }
  }

  async function addMemoryFact() {
    if memory.new_content == "" { return }
    let r = await api.post("/api/memory", { kind: memory.new_kind, content: memory.new_content })
    if r.ok {
      memory.new_content = ""
      loadMemory()
      toast("Fakt zapisany", "success")
    } else { handleApiError(r) }
  }

  async function loadMemory() {
    let r = await api.get("/api/memory")
    if r.ok { memory.facts = r.body }
  }

  async function pinMemoryFact(id) {
    await api.post("/api/memory/" + id + "/pin", {})
    loadMemory()
  }

  async function toggleMemoryFact(id) {
    await api.post("/api/memory/" + id + "/disable", {})
    loadMemory()
  }

  async function saveProviderKey() {
    if providers.new_key == "" { toast("Podaj klucz API", "warning"); return }
    let r = await api.post("/api/providers", { provider: providers.new_provider, api_key: providers.new_key, model: providers.new_model })
    if r.ok {
      providers.new_key = ""
      loadProviders()
      toast("Dostawca zapisany", "success")
    } else { handleApiError(r) }
  }

  async function loadProviders() {
    let r = await api.get("/api/providers")
    if r.ok { providers.list = r.body }
  }

  async function testProvider(id) {
    let r = await api.post("/api/providers/" + id + "/test", {})
    if r.ok {
      if r.body.ok { toast("Połączenie działa", "success") } else { toast("Test nieudany", "danger") }
      loadProviders()
    } else { handleApiError(r) }
  }

  async function revokeSession(id) {
    await api.post("/api/auth/sessions/" + id + "/revoke", {})
    let s = await api.get("/api/auth/sessions")
    if s.ok { auth.sessions = s.body }
  }

  async function loadDiagnostics() {
    let u = await api.get("/api/usage/today")
    if u.ok { diagnostics.today_cost = u.body.cost }
    let a = await api.get("/api/audit")
    if a.ok { diagnostics.audit = a.body }
  }

  async function loadApprovals() {
    let r = await api.get("/api/approvals")
    if r.ok { approvals.list = r.body }
  }

  async function requestApproval(action, parameters) {
    let r = await api.post("/api/approvals", { action: action, parameters: parameters })
    if r.ok {
      approvals.current = r.body
      loadApprovals()
      nav.go("Approvals")
    } else { handleApiError(r) }
  }

  async function approveCurrent(id) {
    let r = await api.post("/api/approvals/" + id + "/approve", {})
    if r.ok {
      let a = r.body
      approvals.current = null
      performAction(a.action, a.parameters, a.token)
    } else { handleApiError(r) }
  }

  async function rejectCurrent(id) {
    await api.post("/api/approvals/" + id + "/reject", {})
    approvals.current = null
    loadApprovals()
  }

  async function performAction(action, parameters, token) {
    if action == "conversation.delete" {
      let r1 = await api.delete("/api/conversations/" + parameters.id, null, { "X-Approval-Token": token })
      if r1.ok { toast("Rozmowa usunięta", "success") } else { handleApiError(r1) }
      approvals.current = null
      loadApprovals()
    } else {
      if action == "memory.mutate" {
        let r2 = await api.delete("/api/memory/" + parameters.id, null, { "X-Approval-Token": token })
        if r2.ok { toast("Fakt usunięty", "success") } else { handleApiError(r2) }
        approvals.current = null
        loadMemory()
        loadApprovals()
      } else {
        if action == "provider.delete" {
          let r3 = await api.delete("/api/providers/" + parameters.id, null, { "X-Approval-Token": token })
          if r3.ok { toast("Dostawca usunięty", "success") } else { handleApiError(r3) }
          approvals.current = null
          loadProviders()
          loadApprovals()
        } else {
          if action == "sessions.revoke_all" {
            let r4 = await api.post("/api/auth/sessions/revoke-all", {}, { "X-Approval-Token": token })
            if r4.ok {
              toast("Wszystkie sesje odwołane", "success")
              auth.user_id = null
              nav.go("Login")
            } else { handleApiError(r4) }
            approvals.current = null
          } else {
            if action == "deploy" {
              let r5 = await api.post("/api/deploy", {}, { "X-Approval-Token": token })
              if r5.ok { toast("Deploy przyjęty", "info") } else { handleApiError(r5) }
              approvals.current = null
            }
          }
        }
      }
    }
  }

  async function finishOnboarding() {
    await api.post("/api/auth/onboarding", {})
    auth.onboarding_complete = true
    nav.go("Chat")
  }
}

// ============================================================================
// FLOW / ON / EVERY
// ============================================================================
flow ApprovalPoll {
  if auth.user_id != null { loadApprovals() }
}

on start { checkSession() }

every 30s {
  if auth.user_id != null { loadApprovals() }
}

// ============================================================================
// API (Cloudflare Workers; user_id zawsze z sesji; audyt/usage tylko serwer)
// ============================================================================
api {

  route GET "/api/csrf" auth=public {
    return { status: 200, body: { ok: true }, set_cookie: csrfCookie() }
  }

  route GET "/api/auth/me" auth=public {
    if session == null { return { status: 401, body: { error: "unauthorized" } } }
    return { status: 200, body: { id: session.userId, login: session.user.github_login, name: session.user.display_name, onboarding_complete: session.user.onboarding_complete } }
  }

  route POST "/api/auth/dev" auth=public rate="5/min" {
    if env.secret("AL_DEV_LOGIN") != "1" { return { status: 404, body: { error: "not_found" } } }
    let rows = await db.list("User", { where: "github_login = ?", args: [body.login] })
    let u = null
    if rows.length > 0 {
      u = rows[0]
    } else {
      u = await db.insert("User", { github_login: body.login, display_name: body.login, onboarding_complete: false })
    }
    let s = await create_session(env, u.id, req.headers.get("user-agent"))
    await audit("auth.dev_login", { id: u.id })
    return { status: 200, body: { id: u.id, login: u.github_login, name: u.display_name }, set_cookie: sessionCookie(s.id) }
  }

  route POST "/api/auth/logout" auth=required csrf=true {
    let sid = session.id
    await db.update("Session", sid, { revoked_at: now_iso() })
    await audit("auth.logout", {})
    return { status: 200, body: { ok: true }, set_cookie: "al_session=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0" }
  }

  route GET "/api/auth/sessions" auth=required {
    let rows = await db.list("Session", { order: "created_at DESC" })
    return { status: 200, body: rows }
  }

  route POST "/api/auth/sessions/revoke-all" auth=required csrf=true approval="sessions.revoke_all" {
    let rows = await db.list("Session", {})
    for s in rows {
      await db.update("Session", s.id, { revoked_at: now_iso() })
    }
    await audit("sessions.revoke_all", { count: rows.length })
    return { status: 200, body: { ok: true } }
  }

  route POST "/api/auth/sessions/:id/revoke" auth=required csrf=true {
    await db.update("Session", params.id, { revoked_at: now_iso() })
    await audit("session.revoke", { id: params.id })
    return { status: 200, body: { ok: true } }
  }

  route POST "/api/auth/onboarding" auth=required csrf=true {
    await db.update("User", session.userId, { onboarding_complete: true })
    return { status: 200, body: { ok: true } }
  }

  route GET "/api/conversations" auth=required {
    let rows = await db.list("Conversation", { order: "updated_at DESC" })
    return { status: 200, body: rows }
  }

  route POST "/api/conversations" auth=required csrf=true rate="30/min" {
    let c = await db.insert("Conversation", { title: "Nowa rozmowa", is_private: false, updated_at: now_iso() })
    await audit("conversation.create", { id: c.id })
    return { status: 201, body: c }
  }

  route GET "/api/conversations/:id/messages" auth=required {
    let rows = await db.list("Message", { where: "conversation_id = ?", args: [params.id], order: "created_at ASC" })
    return { status: 200, body: rows }
  }

  route POST "/api/conversations/:id/messages" auth=required csrf=true rate="60/min" {
    let msg = await db.insert("Message", { conversation_id: params.id, role: "user", content: body.content, status: "completed" })
    await db.update("Conversation", params.id, { updated_at: now_iso() })
    await audit("message.create", { conversation_id: params.id })
    return { status: 201, body: msg }
  }

  route POST "/api/conversations/:id/generate" auth=required csrf=true rate="20/min" {
    let conv = await db.get("Conversation", params.id)
    if conv == null { return { status: 404, body: { error: "no_conversation" } } }
    let msgs = await db.list("Message", { where: "conversation_id = ?", args: [params.id], order: "created_at ASC", limit: 40 })
    await usage.check()
    let out = await ai.stream(body.provider, msgs, { conversation_id: params.id })
    return { status: 200, stream: out }
  }

  route POST "/api/conversations/:id/stop" auth=required csrf=true {
    await ai.interrupt(params.id)
    return { status: 200, body: { ok: true } }
  }

  route DELETE "/api/conversations/:id" auth=required csrf=true approval="conversation.delete" {
    let msgs = await db.list("Message", { where: "conversation_id = ?", args: [params.id] })
    for m in msgs {
      await db.delete("Message", m.id)
    }
    await db.delete("Conversation", params.id)
    await audit("conversation.delete", { id: params.id })
    return { status: 200, body: { ok: true } }
  }

  route DELETE "/api/messages/:id" auth=required csrf=true {
    await db.delete("Message", params.id)
    await audit("message.delete", { id: params.id })
    return { status: 200, body: { ok: true } }
  }

  route GET "/api/memory" auth=required {
    let rows = await db.list("MemoryFact", { order: "created_at DESC" })
    return { status: 200, body: rows }
  }

  route POST "/api/memory" auth=required csrf=true rate="30/min" {
    let f = await db.insert("MemoryFact", { kind: body.kind, content: body.content, source: "manual", pinned: false, disabled: false })
    await audit("memory.create", { kind: body.kind })
    return { status: 201, body: f }
  }

  route POST "/api/memory/:id/pin" auth=required csrf=true {
    let f = await db.get("MemoryFact", params.id)
    if f == null { return { status: 404, body: { error: "not_found" } } }
    let upd = await db.update("MemoryFact", params.id, { pinned: !(f.pinned) })
    return { status: 200, body: upd }
  }

  route POST "/api/memory/:id/disable" auth=required csrf=true {
    let f = await db.get("MemoryFact", params.id)
    if f == null { return { status: 404, body: { error: "not_found" } } }
    let upd = await db.update("MemoryFact", params.id, { disabled: !(f.disabled) })
    return { status: 200, body: upd }
  }

  route DELETE "/api/memory/:id" auth=required csrf=true approval="memory.mutate" {
    await db.delete("MemoryFact", params.id)
    await audit("memory.delete", { id: params.id })
    return { status: 200, body: { ok: true } }
  }

  route GET "/api/providers" auth=required {
    let rows = await db.list("Provider", { order: "created_at DESC" })
    return { status: 200, body: rows.map((p) => ({ id: p.id, provider: p.provider, model: p.model, status: p.status, masked: mask(p.encrypted_key) })) }
  }

  route POST "/api/providers" auth=required csrf=true rate="10/min" {
    let enc = await crypto.encrypt(body.api_key)
    let p = await db.insert("Provider", { provider: body.provider, encrypted_key: enc, model: body.model, status: "unverified" })
    await audit("provider.create", { provider: body.provider })
    return { status: 201, body: { id: p.id, provider: p.provider, status: p.status } }
  }

  route POST "/api/providers/:id/test" auth=required csrf=true {
    let res = await ai.test(params.id)
    await audit("provider.test", { id: params.id })
    return { status: 200, body: res }
  }

  route DELETE "/api/providers/:id" auth=required csrf=true approval="provider.delete" {
    await db.delete("Provider", params.id)
    await audit("provider.delete", { id: params.id })
    return { status: 200, body: { ok: true } }
  }

  route GET "/api/approvals" auth=required {
    let rows = await db.list("Approval", { where: "status IN ('pending','approved')", order: "created_at DESC" })
    return { status: 200, body: rows }
  }

  route POST "/api/approvals" auth=required csrf=true rate="20/min" {
    let a = await approval.require(body.action, body.parameters)
    await audit("approval.request", { action: body.action })
    return { status: 201, body: a }
  }

  route POST "/api/approvals/:id/approve" auth=required csrf=true {
    let a = await approval.approve(params.id)
    await audit("approval.approve", { id: params.id })
    return { status: 200, body: a }
  }

  route POST "/api/approvals/:id/reject" auth=required csrf=true {
    let a = await db.get("Approval", params.id)
    if a == null { return { status: 404, body: { error: "not_found" } } }
    await db.update("Approval", params.id, { status: "rejected" })
    await audit("approval.reject", { id: params.id })
    return { status: 200, body: { ok: true } }
  }

  route GET "/api/usage/today" auth=required {
    let t = await usage.today()
    return { status: 200, body: t }
  }

  route GET "/api/audit" auth=required {
    let rows = await db.list("AuditLog", { order: "created_at DESC", limit: 50 })
    return { status: 200, body: rows }
  }

  route POST "/api/deploy" auth=required csrf=true approval="deploy" {
    await audit("deploy.request", { note: "endpoint not wired" })
    return { status: 501, body: { error: "deploy_not_wired" } }
  }
}

deploy {
  name: "al2100",
  d1: "al2100_db",
  r2: "al2100_files",
  secrets: ["AL_MASTER_ENCRYPTION_KEY", "CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "AL_DEV_LOGIN"]
}

// ============================================================================
// TESTY (realne asercje, wykonywane przez: node axc.js AL2100.ax --test)
// ============================================================================
test "checkSession bez sesji czyści user_id" {
  auth.user_id = "u1"
  await checkSession()
  assert auth.user_id == null
  assert auth.checked == true
}

test "handleApiError 401 wylogowuje" {
  auth.user_id = "u1"
  handleApiError({ ok: false, status: 401, body: { error: "unauthorized" } })
  assert auth.user_id == null
  assert nav.current_screen == "Login"
}

test "handleApiError 403 pokazuje toast" {
  ui.toast = null
  handleApiError({ ok: false, status: 403, body: { error: "approval_required" } })
  assert ui.toast != null
  assert ui.toast.message == "approval_required"
}

test "requestApproval ustawia aktualne zatwierdzenie" {
  await requestApproval("conversation.delete", { id: "c9" })
  assert approvals.current != null
  assert approvals.current.action == "conversation.delete"
  assert nav.current_screen == "Approvals"
}

test "computed current_conversation zwraca null bez rozmów" {
  recompute()
  assert current_conversation == null
  assert is_authenticated == false
}

test "is_authenticated odzwierciedla user_id" {
  auth.user_id = "u9"
  recompute()
  assert is_authenticated == true
  auth.user_id = null
  recompute()
  assert is_authenticated == false
}

test "sendMessage bez treści nie generuje" {
  chat.draft = ""
  chat.is_streaming = false
  await sendMessage()
  assert chat.is_streaming == false
  assert chat.messages.length == 0
}
