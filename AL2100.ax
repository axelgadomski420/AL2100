  shell {
    areas ["sidebar main context"]
    sidebar {
      SidebarNav(nav.current, nav.sidebarCollapsed, approvals.pendingCount)
      ConversationList(chat.conversations, chat.activeConversationId, chat.search, chat.showArchived)
    }
    main {
      TopBar("Czat", chat.activeConversationId)
      if chat.activeConversationId == "" {
        empty {
