component DeployApprovalCard(deployment) {
  card {
    tone surface
    padding lg
    title {
      text "Deploy do " + deployment.environment
      weight semibold
    }
    meta {
      text "target " + deployment.target
      size sm
      muted true
    }
    meta {
      text "status " + deployment.status
      size sm
      muted true
    }
    actions {
      if deployment.status == "requested" {
        button "Zatwierdź" {
          style primary
          action {
            logic.approveRequest(deployment.id)
          }
        }
        button "Odrzuć" {
          style danger
          action {
            logic.rejectRequest(deployment.id)
          }
        }
      }
      if deployment.status == "succeeded" {
        button "Rollback" {
          style danger
          action {
            logic.requestRollback(deployment.id)
          }
        }
      }
    }
  }
}

