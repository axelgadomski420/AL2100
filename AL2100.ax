  route POST /api/diagnostics/ping {
    auth false
    handler {
      return { "ok": true, "body": map { "pong": nowIso() } }
    }
  }

  route GET /api/diagnostics/runtime {
    auth true
    handler {
      return { "ok": true, "body": map {
        "runtime": env.RUNTIME || "cloudflare-worker",
        "compatibilityDate": "2026-10-30",
        "region": request.cf.colo,
        "version": "1.0.0"
      } }
