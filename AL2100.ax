      return { "ok": true, "body": map { "approvalId": id } }
    }
  }

  route POST /api/music/releases/:id/cover {
    auth true
    csrf true
    handler {
      r = db.queryOne("SELECT * FROM MusicRelease WHERE id = ? AND user_id = ?", [params.id, user.id])
      if r == null {
        return { "ok": false, "status": 404 }
      }
      upload = request.file
      if upload == null {
        return { "ok": false, "status": 400 }
      }
      fid = newId("fil")
      key = user.id + "/covers/" + fid + "/" + upload.name
      r2.put(env.AL_BUCKET, key, upload.data, map { "httpMetadata": map { "contentType": upload.mime } })
      db.insert("File", map {
        "id": fid,
        "user_id": user.id,
        "name": upload.name,
        "mime": upload.mime,
        "size": upload.size,
        "r2_key": key,
        "version": 1,
        "status": "ready",
        "extracted_text": "",
        "created_at": nowIso(),
        "updated_at": nowIso()
      })
      db.update("MusicRelease", r.id, map { "cover_file_id": fid, "updated_at": nowIso() })
      return { "ok": true, "body": map { "fileId": fid } }
    }
  }

  route POST /api/music/tracks/:id/analyze {
    auth true
    csrf true
    handler {
      t = db.queryOne("SELECT * FROM MusicTrack WHERE id = ? AND user_id = ?", [params.id, user.id])
      if t == null {
        return { "ok": false, "status": 404 }
      }
      upload = request.file
      if upload == null {
        return { "ok": false, "status": 400 }
      }
      analysis = audio.analyze(upload.data)
      db.update("MusicTrack", t.id, map {
        "bpm": analysis.bpm,
        "key": analysis.key,
        "energy": analysis.energy,
        "duration_seconds": analysis.duration,
        "updated_at": nowIso()
      })
      return { "ok": true, "body": analysis }
    }
  }

  route POST /api/music/tracks/:id/prompt {
    auth true
    csrf true
    handler {
      t = db.queryOne("SELECT * FROM MusicTrack WHERE id = ? AND user_id = ?", [params.id, user.id])
      if t == null {
        return { "ok": false, "status": 404 }
      }
      provider = logic.pickProvider(false, "music").provider
      prompt = "Wygeneruj prompt Suno i ElevenLabs dla utworu o tytule " + t.title + " w gatunku zgodnym z release. Uwzględnij BPM " + t.bpm + ", tonację " + t.key + ", energię " + t.energy + "."
      result = ai.generate(provider, ai.defaultModel(provider), prompt)
      db.update("MusicTrack", t.id, map { "suno_prompt": result, "elevenlabs_prompt": result, "updated_at": nowIso() })
      return { "ok": true, "body": map { "prompt": result } }
    }
  }

  route GET /api/audit {
    auth true
    handler {
      since = request.query["since"]
      if since == "" {
        since = date.subDays(nowIso(), 30)
      }
      items = db.query("SELECT * FROM AuditLog WHERE user_id = ? AND created_at >= ? ORDER BY created_at DESC LIMIT 500", [user.id, since])
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route POST /api/sessions/revoke-all {
    auth true
    csrf true
    requiresApproval "delete"
