        map { "id": "zdrowie", "name": "Tracker zdrowia", "description": "Nawadnianie, sen, aktywność" },
        map { "id": "zadania", "name": "Menedżer zadań", "description": "Zadania i projekty" },
        map { "id": "notatnik", "name": "Notatnik AI", "description": "Notatki z asystentem" },
        map { "id": "muzyka", "name": "Kreator muzyki", "description": "Suno, ElevenLabs, aranżacje" },
        map { "id": "panel", "name": "Panel projektu", "description": "Dashboard projektu" },
        map { "id": "katalog", "name": "Katalog produktów", "description": "Produkty i wyszukiwanie" },
        map { "id": "artysta", "name": "Strona artysty", "description": "Portfolio i kontakt" },
        map { "id": "marketing", "name": "Generator treści", "description": "Teksty marketingowe" },
        map { "id": "research", "name": "Aplikacja researchowa", "description": "Wyszukiwanie z cytowaniami" }
      ]
      return { "ok": true, "body": map { "items": templates } }
    }
  }

  route POST /api/appcreator/generate/plan {
    auth true
    csrf true
    rateLimit "chat:send"
    handler {
      provider = logic.pickProvider(false, body.description).provider
      model = ai.defaultModel(provider)
      prompt = logic.appCreatorPlanPrompt(body.description, body.template)
      plan = ai.generate(provider, model, prompt)
      return { "ok": true, "body": map { "plan": plan } }
    }
  }

  route POST /api/appcreator/generate/code {
    auth true
    csrf true
    rateLimit "chat:send"
