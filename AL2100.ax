  route GET /api/usage {
    auth true
    handler {
      since = date.subDays(nowIso(), 30)
      rows = db.query("SELECT provider, SUM(tokens) as tokens FROM Message WHERE user_id = ? AND created_at >= ? AND role = 'assistant' GROUP BY provider", [user.id, since])
      total = 0
      for r in rows {
        total = total + r.tokens
      }
      return { "ok": true, "body": map { "byProvider": rows, "total": total } }
    }
  }

  route GET /api/usage/daily {
    auth true
    handler {
      since = date.subDays(nowIso(), 30)
      rows = db.query("SELECT DATE(created_at) as day, SUM(tokens) as tokens FROM Message WHERE user_id = ? AND created_at >= ? GROUP BY day ORDER BY day ASC", [user.id, since])
      return { "ok": true, "body": map { "items": rows } }
    }
  }

  route POST /api/github/oauth/start {
    auth true
    csrf true
    handler {
      state = crypto.randomHex(16)
      cache.set("gh_workspace:" + state, user.id, 300)
      url = oauth.github.startUrl(env.GITHUB_OAUTH_CLIENT_ID, env.PUBLIC_URL + "/auth/github/workspace/callback", state)
      return { "ok": true, "body": map { "url": url, "state": state } }
    }
  }

  route GET /auth/github/workspace/callback {
    auth false
    handler {
      code = request.query["code"]
      state = request.query["state"]
      uid = cache.get("gh_workspace:" + state)
      if code == "" || uid == null {
        return redirect("/")
      }
      token = oauth.github.exchange(env.GITHUB_OAUTH_CLIENT_ID, env.GITHUB_OAUTH_CLIENT_SECRET, code, env.PUBLIC_URL + "/auth/github/workspace/callback")
      cache.set("gh_token:" + uid, token.access_token, 3600)
      gh.listRepos(env, uid, token.access_token)
      audit(uid, "github.workspace.connect", "GitHubRepo", "", "success", map {})
      return redirect("/#GitHub")
    }
  }

  route GET /api/github/repos/:owner/:repo/tree {
    auth true
    handler {
      token = cache.get("gh_token:" + user.id)
      if token == null {
        return { "ok": false, "status": 401 }
      }
      tree = gh.tree(env, token, params.owner + "/" + params.repo)
      return { "ok": true, "body": map { "tree": tree } }
    }
  }

  route GET /api/github/repos/:owner/:repo/file {
    auth true
    handler {
      token = cache.get("gh_token:" + user.id)
      if token == null {
        return { "ok": false, "status": 401 }
      }
      path = request.query["path"]
      content = gh.file(env, token, params.owner + "/" + params.repo, path)
      return { "ok": true, "body": map { "path": path, "content": content } }
    }
  }

  route POST /api/github/repos/:owner/:repo/search {
    auth true
    csrf true
    handler {
      token = cache.get("gh_token:" + user.id)
      if token == null {
        return { "ok": false, "status": 401 }
      }
      q = body.query
      items = gh.searchCode(env, token, params.owner + "/" + params.repo, q)
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route GET /api/github/repos/:owner/:repo/prs {
    auth true
    handler {
      token = cache.get("gh_token:" + user.id)
      if token == null {
        return { "ok": false, "status": 401 }
      }
      items = gh.listPRs(env, token, params.owner + "/" + params.repo)
      return { "ok": true, "body": map { "items": items } }
