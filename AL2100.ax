      AiKeysPanel()
    }
    section Wyszukiwanie {
      SearchKeysPanel()
    }
    section OAuth {
      OAuthPanel()
    }
    section Cloudflare {
      CloudflarePanel()
    }
    section Limity {
      LimitsPanel()
    }
    section Audyt {
      AuditTable(settings.auditLog)
    }
    section Język {
      Select(["pl", "en"], user.locale, { user.locale = value })
    }
    section Motyw {
      Select(["dark", "darker", "system"], user.theme, { user.theme = value })
    }
  }
  if credentials.editMode.kind == "ai" {
    AddAiKeyModal(credentials.editMode.provider)
  }
  if credentials.editMode.kind == "search" {
    AddSearchKeyModal(credentials.editMode.provider)
  }
  if credentials.editMode.kind == "oauth" {
    OAuthEditModal(credentials.editMode.provider)
  }
  if credentials.editMode.kind == "cloudflare" {
    CloudflareEditModal()
  }
  if credentials.rotateKeyOpen {
    RotateMasterKeyDialog()
  }
}

screen ProjectDetailScreen {
  title "Projekt"
  TopBar("Projekt", projects.activeId)
  if projects.activeId == "" {
    Empty("Wybierz projekt", "Otwórz projekt z listy")
  } else {
    ProjectDetail(projects.items.find(map { "id": projects.activeId }))
  }
}

screen TaskDetailScreen {
  title "Zadanie"
  TopBar("Zadanie", tasks.filter)
  if tasks.items.length == 0 {
    Empty("Brak zadań", "Dodaj pierwsze zadanie")
  } else {
    TaskDetail(tasks.items[0])
  }
}

screen FilePreviewScreen {
  title "Plik"
  TopBar("Plik", files.selectedId)
  if files.selectedId == "" {
    Empty("Wybierz plik", "Otwórz plik z listy")
  } else {
    FilePreview(files.items.find(map { "id": files.selectedId }))
  }
}

screen MusicReleaseDetailScreen {
  title "Release"
  TopBar("Release", music.activeReleaseId)
  if music.activeReleaseId == "" {
    Empty("Wybierz release", "Otwórz release z listy")
  } else {
    MusicReleaseDetail(music.releases.find(map { "id": music.activeReleaseId }))
  }
}

screen MusicTrackEditorScreen {
  title "Track"
  TopBar("Track", music.activeReleaseId)
  if music.tracks.length == 0 {
    Empty("Brak utworów", "Dodaj pierwszy utwór")
  } else {
    MusicTrackEditor(music.tracks[0])
  }
}

logic {
  function openProjectDetail(id) {
    projects.activeId = id
    nav.current = "ProjectDetailScreen"
  }

  function openTaskDetail(id) {
    tasks.filter = id
    nav.current = "TaskDetailScreen"
  }

  function openFilePreview(id) {
    files.selectedId = id
    nav.current = "FilePreviewScreen"
  }

  function openMusicReleaseDetail(id) {
    music.activeReleaseId = id
    nav.current = "MusicReleaseDetailScreen"
  }

  function openMusicTrackEditor(id) {
    music.activeReleaseId = id
    nav.current = "MusicTrackEditorScreen"
  }

  function saveProject(project) {
    fetch("/api/projects/" + project.id, "PATCH", project, map { "X-CSRF-Token": session.csrfToken })
    logic.loadProjects()
  }

  function requireAiKey() {
    if configuredAiCount == 0 {
      toast("warning", "Dodaj klucz AI w Ustawienia → Klucze AI")
      nav.current = "Ustawienia"
      settings.tab = "Klucze AI"
      return false
    }
    return true
  }

  function sendMessageGuarded() {
    if !logic.requireAiKey() {
      return
    }
    logic.sendMessage()
  }

  event settings.tab changed {
    if settings.tab == "Klucze AI" || settings.tab == "Wyszukiwanie" || settings.tab == "OAuth" || settings.tab == "Cloudflare" {
      logic.loadCredentials()
    }
  }
}

api {
  route PATCH /api/projects/:id {
    auth true
    csrf true
    handler {
      p = db.queryOne("SELECT * FROM Project WHERE id = ? AND user_id = ?", [params.id, user.id])
      if p == null {
        return { "ok": false, "status": 404 }
      }
      patch = map { "updated_at": nowIso() }
      if body.name != null {
        patch.name = body.name
      }
      if body.description != null {
        patch.description = body.description
      }
      if body.status != null {
        patch.status = body.status
      }
      if body.color != null {
        patch.color = body.color
      }
      db.update("Project", params.id, patch)
      audit(user.id, "project.update", "Project", params.id, "success", map {})
      return { "ok": true, "body": db.queryOne("SELECT * FROM Project WHERE id = ?", [params.id]) }
    }
  }
}

logic {
  function applyCredentialDelete(kind, provider) {
    if kind == "ai" || kind == "search" || kind == "oauth" {
      db.query("UPDATE ProviderKey SET status = 'deleted' WHERE user_id = ? AND provider = ? AND kind = ?", [user.id, provider, kind])
    } else if kind == "cloudflare" {
      db.query("UPDATE ProviderKey SET status = 'deleted' WHERE user_id = ? AND kind = 'cloudflare'", [user.id])
    }
    audit(user.id, "credential.delete", "ProviderKey", provider, "success", map { "kind": kind })
    logic.loadCredentials()
  }

  function applyApprovalExtended(a) {
    if a.kind == "delete" && a.resource == "Credential" {
      parts = a.resource_id.split(":")
      logic.applyCredentialDelete(parts[0], parts[1])
    }
  }
}

flow SetupFlow {
  start Czat
  Czat => Ustawienia when configuredAiCount == 0
  Ustawienia => Czat when configuredAiCount > 0
}

queue ALQueue {
  binding "AL_QUEUE"
  consumer {
    on message {
      kind = message.kind
      if kind == "chat.generate" {
        logic.runChatGeneration(message.payload)
      } else if kind == "research.fetch" {
        logic.runResearchJob(message.payload)
      } else if kind == "file.index" {
        logic.runFileIndex(message.payload)
      } else if kind == "agent.run" {
        logic.runAgent(message.payload)
      } else if kind == "deploy.run" {
        logic.runDeploy(message.payload)
      } else if kind == "memory.compact" {
        logic.runMemoryCompaction(message.payload)
      } else if kind == "audit.flush" {
        logic.flushAudit(message.payload)
      } else if kind == "credential.rotate" {
        logic.rotateMasterKeyAsync(message.payload)
      }
    }
  }
}

logic {
  function rotateMasterKeyAsync(payload) {
    audit(payload.user_id, "credential.master.rotate.async", "ProviderKey", "all", "success", map {})
  }
}

cron ALScheduler {
  schedule "*/5 * * * *" {
    on tick {
      db.query("UPDATE Session SET revoked_at = ? WHERE expires_at < ? AND revoked_at IS NULL", [nowIso(), nowIso()])
      db.query("DELETE FROM Approval WHERE status = 'pending' AND created_at < ?", [date.subDays(nowIso(), 14)])
    }
  }
  schedule "0 3 * * *" {
    on tick {
      db.query("DELETE FROM AuditLog WHERE created_at < ?", [date.subDays(nowIso(), 180)])
    }
  }
}
