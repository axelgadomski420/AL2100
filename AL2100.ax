      return { "ok": true, "body": map { "checks": checks, "overall": overall } }
    }
  }
}

queue ALQueue {
  binding "AL_QUEUE"
  consumer {
    on message {
      kind = message.kind
      if kind == "chat.generate" {
        logic.runChatGeneration(message.payload)
      } else if kind == "research.fetch" {
        logic.runResearchJob(message.payload)
      } else if kind == "file.index" {
        logic.runFileIndex(message.payload)
      } else if kind == "agent.run" {
        logic.runAgent(message.payload)
      } else if kind == "deploy.run" {
        logic.runDeploy(message.payload)
      } else if kind == "memory.compact" {
        logic.runMemoryCompaction(message.payload)
      } else if kind == "audit.flush" {
        logic.flushAudit(message.payload)
      }
    }
  }
}

cron ALScheduler {
  schedule "*/5 * * * *" {
    on tick {
      db.query("UPDATE Session SET revoked_at = ? WHERE expires_at < ? AND revoked_at IS NULL", [nowIso(), nowIso()])
      db.query("DELETE FROM Approval WHERE status = 'pending' AND created_at < ?", [date.subDays(nowIso(), 14)])
      expired = db.query("SELECT * FROM File WHERE status = 'uploading' AND created_at < ?", [date.subHours(nowIso(), 2)])
      for f in expired {
        db.update("File", f.id, map { "status": "failed" })
      }
    }
  }
  schedule "0 3 * * *" {
    on tick {
      db.query("DELETE FROM AuditLog WHERE created_at < ?", [date.subDays(nowIso(), 180)])
      db.query("DELETE FROM AgentRun WHERE finished_at < ?", [date.subDays(nowIso(), 30)])
      db.query("DELETE FROM ResearchSource WHERE fetched_at < ?", [date.subDays(nowIso(), 90)])
    }
  }
  schedule "0 * * * *" {
    on tick {
      logic.compactMemoryAllUsers()
      logic.rotateUsageCounters()
    }
  }
}

agents {
  registry [
    map { "name": "Coordinator", "role": "routing", "maxSteps": 4, "maxSeconds": 30, "maxTokens": 4000 },
    map { "name": "Research", "role": "web", "maxSteps": 12, "maxSeconds": 120, "maxTokens": 16000 },
    map { "name": "Code", "role": "code", "maxSteps": 10, "maxSeconds": 120, "maxTokens": 20000 },
    map { "name": "Memory", "role": "memory", "maxSteps": 6, "maxSeconds": 30, "maxTokens": 4000 },
    map { "name": "Files", "role": "files", "maxSteps": 8, "maxSeconds": 60, "maxTokens": 4000 },
    map { "name": "Creative", "role": "creative", "maxSteps": 6, "maxSeconds": 60, "maxTokens": 8000 },
    map { "name": "Ops", "role": "ops", "maxSteps": 8, "maxSeconds": 90, "maxTokens": 6000 },
    map { "name": "AppCreator", "role": "app", "maxSteps": 10, "maxSeconds": 180, "maxTokens": 20000 },
    map { "name": "Deployer", "role": "deploy", "maxSteps": 6, "maxSeconds": 120, "maxTokens": 4000 }
  ]
  router {
    on classify {
      if user.forcedMode != "auto" {
        return map { "agent": user.forcedMode, "reason": "forced" }
      }
      intent = ai.classifyIntent(message)
      if intent == "chat" || intent == "question" {
        return map { "agent": "Coordinator", "reason": "simple" }
      }
      if intent == "research" {
        return map { "agent": "Research", "reason": "web" }
      }
      if intent == "code" {
        return map { "agent": "Code", "reason": "code" }
      }
      if intent == "memory" {
        return map { "agent": "Memory", "reason": "memory" }
      }
      if intent == "app" {
        return map { "agent": "AppCreator", "reason": "app" }
      }
      if intent == "deploy" {
        return map { "agent": "Deployer", "reason": "deploy" }
      }
      return map { "agent": "Coordinator", "reason": "default" }
    }
  }
  limits {
    maxSteps 24
    maxSeconds 180
    maxTokens 32000
    maxConcurrency 1
    abortOnApprovalRequired true
    blockInfiniteLoop true
  }
  audit {
    logEveryStep true
    logCost true
    redactSecrets true
  }
}

logic {
  function buildContext(conversationId, query) {
    if memory.contextMode == "degraded" {
      return ai.contextFromConversation(conversationId, query)
    }
    budget = chat.contextBudget
    recent = db.query("SELECT * FROM Message WHERE conversation_id = ? ORDER BY created_at DESC LIMIT 30", [conversationId])
    mems = db.query("SELECT * FROM MemoryEntry WHERE user_id = ? AND disabled = ? ORDER BY importance DESC LIMIT 100", [user.id, false])
    ranked = rankMemory(mems, query)
    parts = []
    tokens = 0
    for m in ranked {
      if tokens + m.content.length > budget * 0.4 {
        break
      }
      parts = parts + [m]
      tokens = tokens + m.content.length
    }
    sources = db.query("SELECT * FROM ResearchSource WHERE conversation_id = ? ORDER BY fetched_at DESC LIMIT 20", [conversationId])
    return ai.composeContext(recent, parts, sources, query, budget)
  }

  function rankMemory(entries, query) {
    scored = []
    for e in entries {
      score = 0
      if e.pinned {
        score = score + 100
      }
      score = score + e.importance
      if e.scope == "project" {
        score = score + 5
      }
      if e.scope == "global" {
        score = score + 3
      }
      if query != "" && e.content.toLowerCase().includes(query.toLowerCase()) {
        score = score + 20
      }
      age = date.diffHours(nowIso(), e.updated_at)
      if age < 24 {
        score = score + 10
      } else if age < 168 {
        score = score + 5
      }
      scored = scored + [map { "entry": e, "score": score }]
    }
    return sortByDesc(scored, "score")
  }

  function rememberFacts(conversationId, userText, aiText) {
    cn = db.queryOne("SELECT * FROM Conversation WHERE id = ?", [conversationId])
    if cn == null {
      return
    }
    if cn.private_mode {
      return
    }
    extracted = ai.extractMemory(userText + "\n" + aiText)
    for item in extracted.items {
      id = newId("mem")
      db.insert("MemoryEntry", map {
        "id": id,
        "user_id": user.id,
        "scope": item.scope,
        "scope_id": item.scope_id,
        "kind": item.kind,
        "content": item.content,
        "pinned": false,
        "disabled": false,
        "importance": item.importance,
        "created_at": nowIso(),
        "updated_at": nowIso(),
        "source_message_id": null,
        "approval_state": "auto"
      })
    }
  }

  function pickProvider(webSearch, query) {
    rows = db.query("SELECT * FROM ProviderKey WHERE user_id = ? AND status = 'active'", [user.id])
    if rows.length == 0 {
      return null
    }
    intent = ai.classifyIntent(query)
    if intent == "code" {
      for r in rows {
        if r.provider == "mistral" || r.provider == "anthropic" || r.provider == "openai" {
          return map { "provider": r.provider, "model": ai.defaultModel(r.provider) }
        }
      }
    }
    if intent == "research" && webSearch {
      for r in rows {
        if r.provider == "gemini" {
          return map { "provider": "gemini", "model": "gemini-2.5-pro" }
        }
      }
    }
    for r in rows {
      return map { "provider": r.provider, "model": ai.defaultModel(r.provider) }
    }
    return null
  }

  function expandQueries(query) {
    if query.length < 40 {
      return [query]
    }
    parts = ai.splitQuery(query)
    if parts.length == 0 {
      return [query]
    }
    return parts
  }

  function addCitation(result) {
    research.sources = research.sources + [result]
    audit(user.id, "research.cite", "ResearchSource", result.id, "success", map {})
  }

  function setMemoryPinned(id, pinned) {
    fetch("/api/memory/" + id, "PATCH", map { "pinned": pinned }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMemory()
  }

  function setMemoryDisabled(id, disabled) {
    fetch("/api/memory/" + id, "PATCH", map { "disabled": disabled }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMemory()
  }

  function archiveProject(id) {
    fetch("/api/projects/" + id, "PATCH", map { "status": "archived" }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadProjects()
  }

  function requestDeleteProject(id) {
    requestApproval("delete", "Project", id, map { "id": id })
  }

  function requestDeleteSession(id) {
    requestApproval("delete", "Session", id, map { "id": id })
  }

  function requestRollback(targetId) {
    requestApproval("deploy", "Deployment", targetId, map { "target": targetId, "action": "rollback" })
  }

  function saveProvider(provider, key) {
    if provider == "" {
      notify "Wybierz dostawcę"
      return
    }
    fetch("/api/providers", "POST", map { "provider": provider, "key": key }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadProviders()
  }

  function openAgentLog(runId) {
    res = fetch("/api/agents/runs/" + runId, "GET", null, null)
    if res.ok {
      ui.modal = map { "name": "AgentLog", "payload": res.body }
    }
  }

  function cancelAgentRun(runId) {
    fetch("/api/agents/runs/" + runId + "/cancel", "POST", map {}, map { "X-CSRF-Token": session.csrfToken })
    agents.activeRuns = agents.activeRuns.filter(map { "id": runId })
  }

  function indexRepo(repoFullName) {
    github.status = "indexing"
    fetch("/api/github/index", "POST", map { "repo": repoFullName }, map { "X-CSRF-Token": session.csrfToken })
  }

  function syncRepo(repoFullName) {
    github.status = "syncing"
    fetch("/api/github/sync", "POST", map { "repo": repoFullName }, map { "X-CSRF-Token": session.csrfToken })
  }

  function createBranchFromDiff() {
    fetch("/api/github/branch", "POST", map { "diff": github.diff, "repo": github.activeRepo, "branch": "al2100/proposal-" + date.unix() }, map { "X-CSRF-Token": session.csrfToken })
  }

  function commitAndOpenPR() {
    requestApproval("push", "GitHubRepo", github.activeRepo, map { "diff": github.diff, "branch": "al2100/proposal-" + date.unix() })
  }

  function saveMusicTrack(track) {
    fetch("/api/music/tracks/" + track.id, "PATCH", track, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMusicTracks()
  }

  function runAgent(payload) {
    agentName = payload.agent
    runId = newId("run")
    db.insert("AgentRun", map {
      "id": runId,
      "user_id": payload.user_id,
      "agent": agentName,
      "conversation_id": payload.conversation_id,
      "status": "running",
      "steps": 0,
      "tokens": 0,
      "cost": 0,
      "started_at": nowIso(),
      "log": []
    })
    steps = 0
    tokens = 0
    log = []
    while steps < 24 && tokens < 32000 {
      if ai.abortRequested(runId) {
        db.update("AgentRun", runId, map { "status": "cancelled", "finished_at": nowIso() })
        return
      }
      action = ai.agentStep(agentName, payload, log)
      steps = steps + 1
      tokens = tokens + action.tokens
      log = log + [map { "step": steps, "action": action.kind, "tokens": action.tokens }]
      if action.kind == "final" {
        db.update("AgentRun", runId, map {
          "status": "succeeded",
          "steps": steps,
          "tokens": tokens,
          "finished_at": nowIso(),
          "log": log
        })
        return
      }
      if action.kind == "approval_required" {
        requestApproval(action.approval_kind, action.resource, action.resource_id, action.payload)
        db.update("AgentRun", runId, map {
          "status": "succeeded",
          "steps": steps,
          "tokens": tokens,
          "finished_at": nowIso(),
          "log": log
        })
        return
      }
    }
    db.update("AgentRun", runId, map {
      "status": "failed",
      "steps": steps,
      "tokens": tokens,
      "finished_at": nowIso(),
      "log": log
    })
  }

  function runDeploy(payload) {
    deploymentId = payload.deployment_id
    db.update("Deployment", deploymentId, map {
      "status": "running",
      "started_at": nowIso()
    })
    logs = []
    try {
      logs = logs + ["build"]
      buildResult = cloudflare.build()
      logs = logs + ["build ok"]
      logs = logs + ["migrate"]
      migrations = cloudflare.migrate(env.AL_DB)
      logs = logs + ["migrate ok: " + migrations.length]
      logs = logs + ["publish"]
      publish = cloudflare.publish(payload.target, payload.environment)
      logs = logs + ["publish ok: " + publish.url]
      db.update("Deployment", deploymentId, map {
        "status": "succeeded",
        "finished_at": nowIso(),
        "logs": logs
      })
    } catch err {
      db.update("Deployment", deploymentId, map {
        "status": "failed",
        "finished_at": nowIso(),
        "logs": logs + ["error: " + err]
      })
    }
  }

  function runChatGeneration(payload) {
    provider = payload.provider
    keyRow = db.queryOne("SELECT * FROM ProviderKey WHERE user_id = ? AND provider = ?", [payload.user_id, provider])
    if keyRow == null {
      return
    }
    key = decryptSecret(keyRow.encrypted_key)
    ctx = buildContext(payload.conversation_id, payload.content)
    result = ai.generateWithKey(provider, payload.model, key, ctx)
    db.update("Message", payload.message_id, map {
      "content": result.content,
      "status": "completed",
      "tokens": result.tokens
    })
  }

  function runResearchJob(payload) {
    for q in payload.queries {
      search.run(q, map { "maxResults": 8 })
    }
  }

  function runFileIndex(payload) {
    f = db.queryOne("SELECT * FROM File WHERE id = ?", [payload.file_id])
    if f == null {
      return
    }
    text = ""
    if f.mime.startsWith("text/") {
      obj = r2.get(env.AL_BUCKET, f.r2_key)
      text = obj.body.text()
    } else if f.mime == "application/pdf" {
      obj = r2.get(env.AL_BUCKET, f.r2_key)
      text = pdf.extractText(obj.body)
    } else if f.mime.startsWith("audio/") {
      obj = r2.get(env.AL_BUCKET, f.r2_key)
      text = whisper.transcribe(obj.body)
      analysis = audio.analyze(obj.body)
      db.update("File", f.id, map {
        "extracted_text": text + "\nBPM:" + analysis.bpm + " Key:" + analysis.key + " Energy:" + analysis.energy
      })
      return
    }
    db.update("File", f.id, map { "extracted_text": text })
  }

  function runMemoryCompaction(payload) {
    cn = db.queryOne("SELECT * FROM Conversation WHERE id = ?", [payload.conversation_id])
    if cn == null || cn.private_mode {
      return
    }
    msgs = db.query("SELECT * FROM Message WHERE conversation_id = ? ORDER BY created_at ASC", [payload.conversation_id])
    if msgs.length < 20 {
      return
    }
    summary = ai.summarize(msgs)
    db.insert("MemoryEntry", map {
      "id": newId("mem"),
      "user_id": cn.user_id,
      "scope": "conversation",
      "scope_id": cn.id,
      "kind": "summary",
      "content": summary,
      "pinned": false,
      "disabled": false,
      "importance": 7,
      "created_at": nowIso(),
      "updated_at": nowIso(),
      "approval_state": "auto"
    })
  }

  function compactMemoryAllUsers() {
    users = db.query("SELECT id FROM User LIMIT 1000")
    for u in users {
      queue.push(env.AL_QUEUE, map { "kind": "memory.compact", "payload": map { "user_id": u.id } })
    }
  }

  function rotateUsageCounters() {
    cache.set("usage:" + date.today(), 0)
  }

  function flushAudit(payload) {
    return
  }

  function runDiagnosticsServer() {
    checks = []
    dbOk = true
    try {
      db.query("SELECT 1")
    } catch e {
      dbOk = false
    }
    checks = checks + [map { "name": "d1", "status": dbOk ? "ok" : "failed", "message": dbOk ? "D1 reachable" : "D1 failed" }]
    r2Ok = true
    try {
      r2.list(env.AL_BUCKET, map { "limit": 1 })
    } catch e {
      r2Ok = false
    }
    checks = checks + [map { "name": "r2", "status": r2Ok ? "ok" : "failed", "message": r2Ok ? "R2 reachable" : "R2 failed" }]
    provRows = db.query("SELECT * FROM ProviderKey WHERE user_id = ? AND status = 'active'", [user.id])
    checks = checks + [map { "name": "providers", "status": provRows.length > 0 ? "ok" : "warning", "message": provRows.length + " active" }]
    memMode = memory.contextMode
    checks = checks + [map { "name": "memory", "status": memMode == "full" ? "ok" : "warning", "message": memMode }]
    return checks
  }

  function appCreatorPlanPrompt(description, template) {
    return "Jesteś architektem aplikacji AXCode. Zwróć plan w punktach dla aplikacji: " + description + ". Szablon: " + template + ". Uwzględnij ekrany, modele danych, logikę, integracje."
  }

  function appCreatorCodePrompt(plan, template) {
    return "Wygeneruj pełny, produkcyjny plik AXCode dla tej aplikacji. Plan: " + plan + ". Szablon: " + template + ". Zwróć tylko kod AXCode bez komentarzy."
  }

  function safeUrl(url) {
    if !url.startsWith("https://") {
      return false
    }
    blocked = ["localhost", "127.0.0.1", "::1", "0.0.0.0", "10.", "192.168.", "169.254.", "172.16.", "172.17.", "172.18.", "172.19.", "172.20.", "172.21.", "172.22.", "172.23.", "172.24.", "172.25.", "172.26.", "172.27.", "172.28.", "172.29.", "172.30.", "172.31.", "metadata.google", "169.254.169.254"]
    for b in blocked {
      if url.includes(b) {
        return false
      }
    }
    return true
  }

  function nowIso() {
    return date.nowIso()
  }

  function newId(prefix) {
    return prefix + "-" + uuid.v4()
  }

  function hashIp(ip) {
    return crypto.sha256(ip + "::" + env.AL_MASTER_ENCRYPTION_KEY)
  }

  function encryptSecret(plain) {
    nonce = crypto.randomBytes(12)
    cipher = crypto.aesGcm.encrypt(plain, env.AL_MASTER_ENCRYPTION_KEY, nonce)
    return map { "cipher": cipher, "nonce": crypto.hex(nonce), "version": 1 }
  }

  function decryptSecret(payload) {
    nonce = crypto.unhex(payload.nonce)
    return crypto.aesGcm.decrypt(payload.cipher, env.AL_MASTER_ENCRYPTION_KEY, nonce)
  }

  function maskSecret(plain) {
    if plain == null || plain.length <= 6 {
      return "••••••"
    }
    return plain.substring(0, 3) + "••••••" + plain.substring(plain.length - 3)
  }

  function rateCheck(userId, bucket) {
    key = "rate:" + bucket + ":" + userId
    count = cache.incr(key, 60)
    if count > settings.rateLimitPerMinute {
      throw "rate_limit_exceeded"
    }
    return true
  }

  function audit(userId, action, resource, resourceId, result, metadata) {
    db.insert("AuditLog", map {
      "id": newId("aud"),
      "user_id": userId,
      "action": action,
      "resource": resource,
      "resource_id": resourceId,
      "ip_hash": hashIp(request.ip),
      "user_agent": request.headers["user-agent"],
      "result": result,
      "metadata": metadata,
      "created_at": nowIso()
    })
  }

  function requestApproval(kind, resource, resourceId, payload) {
    id = newId("apr")
    db.insert("Approval", map {
      "id": id,
      "user_id": user.id,
      "kind": kind,
      "resource": resource,
      "resource_id": resourceId,
      "payload": payload,
      "status": "pending",
      "created_at": nowIso()
    })
    approvals.items = db.query("SELECT * FROM Approval WHERE user_id = ? AND status = 'pending'", [user.id])
    approvals.pendingCount = approvals.items.length
    audit(user.id, "approval.request", "Approval", id, "success", map { "kind": kind })
    return id
  }

  function applyApproval(id) {
    a = db.queryOne("SELECT * FROM Approval WHERE id = ? AND user_id = ?", [id, user.id])
    if a == null {
      return
    }
    if a.kind == "delete" {
      if a.resource == "Conversation" {
        db.query("DELETE FROM Message WHERE conversation_id = ?", [a.resource_id])
        db.update("Conversation", a.resource_id, map { "archived": true })
      } else if a.resource == "Message" {
        db.query("DELETE FROM Message WHERE id = ?", [a.resource_id])
      } else if a.resource == "Task" {
        db.query("DELETE FROM Task WHERE id = ?", [a.resource_id])
      } else if a.resource == "Project" {
        db.query("DELETE FROM Project WHERE id = ?", [a.resource_id])
      } else if a.resource == "File" {
        db.update("File", a.resource_id, map { "status": "deleted", "deleted_at": nowIso() })
      } else if a.resource == "Session" {
        if a.resource_id == "all" {
          db.query("UPDATE Session SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL", [nowIso(), user.id])
        } else {
          db.update("Session", a.resource_id, map { "revoked_at": nowIso() })
        }
      } else if a.resource == "ProviderKey" {
        db.query("UPDATE ProviderKey SET status = 'deleted' WHERE user_id = ? AND provider = ?", [user.id, a.resource_id])
      }
    } else if a.kind == "deploy" {
      did = newId("dpl")
      db.insert("Deployment", map {
        "id": did,
        "user_id": user.id,
        "target": a.payload.target,
        "environment": "production",
        "status": "approved",
        "approved_by": user.id,
        "approved_at": nowIso(),
        "started_at": nowIso(),
        "logs": []
      })
      queue.push(env.AL_QUEUE, map { "kind": "deploy.run", "payload": map { "deployment_id": did, "user_id": user.id, "target": a.payload.target, "environment": "production" } })
    } else if a.kind == "push" {
      if a.resource == "GitHubRepo" {
        gh.createBranchAndPR(env, user.id, a.payload.repo, a.payload.branch, a.payload.diff, "AL2100 proposal")
      } else if a.resource == "AppCreator" {
        gh.applyAppCreatorDiff(env, user.id, a.payload.diff)
      }
    }
    db.update("Approval", id, map {
      "status": "approved",
      "resolved_at": nowIso(),
      "resolved_by": user.id
    })
    approvals.items = db.query("SELECT * FROM Approval WHERE user_id = ? AND status = 'pending'", [user.id])
    approvals.pendingCount = approvals.items.length
    audit(user.id, "approval.approve", "Approval", id, "success", map {})
  }

  function rejectApproval(id) {
    db.update("Approval", id, map {
      "status": "rejected",
      "resolved_at": nowIso(),
      "resolved_by": user.id
    })
    approvals.items = db.query("SELECT * FROM Approval WHERE user_id = ? AND status = 'pending'", [user.id])
    approvals.pendingCount = approvals.items.length
    audit(user.id, "approval.reject", "Approval", id, "success", map {})
  }

  function sortByDesc(items, key) {
    return items.sort((a, b) => b[key] - a[key])
  }

  event approval.created {
    approvals.pendingCount = approvals.pendingCount + 1
  }

  event session.expired {
    session.id = ""
    session.csrfToken = ""
    nav.current = "Login"
  }

  event ui.online changed {
    if !ui.online && isGenerating {
      chat.generation.status = "interrupted"
      notify "Połączenie utracone — generacja przerwana"
    }
  }

  onStart {
    logic.loadSession()
    logic.loadApprovals()
    logic.loadProviders()
    logic.loadConversations()
    logic.loadProjects()
    logic.loadTasks()
    logic.loadMemory()
    logic.loadFiles()
    logic.loadMusicReleases()
    logic.loadSessions()
  }
}

flow Auth {
  start Login
  Login => Czat when hasActiveSession
  Czat => Login when !hasActiveSession
}

flow Approvals {
  start Zatwierdzenia
  Zatwierdzenia => Deploy when pendingApprovalsCount == 0 && deploy.status == "approved"
  Deploy => Zatwierdzenia when deploy.requiresApproval
}

flow Providers {
  start Ustawienia
  Ustawienia => Czat when settings.providers.length > 0
  Czat => Ustawienia when settings.providers.length == 0
}

flow AppCreator {
  start AppCreator
  AppCreator => GitHub when appCreator.code != ""
  GitHub => Deploy when github.pullRequest.state == "open"
  Deploy => Zatwierdzenia when deploy.requiresApproval
}
component Avatar(user) {
  image {
    src user.avatarUrl
    alt user.name
    radius pill
    size 32
    fallback user.name.substring(0, 1)
  }
}

component Icon(name, size) {
  svg {
    name name
    size size
    tone text
  }
}

component Tabs(items, value, onChange) {
  row {
    gap xs
    for item in items {
      button item {
        style value == item ? "primary" : "ghost"
        action {
          onChange(item)
        }
      }
    }
  }
}

component Toggle(label, value, onChange) {
  row {
    align center
    gap sm
    label {
      text label
      size sm
    }
    switch {
      value value
      onChange {
        onChange(value)
      }
    }
  }
}

component Select(options, value, onChange) {
  dropdown {
    value value
    options options
    onChange {
      onChange(value)
    }
  }
}

component Input(value, placeholder, type, onChange) {
  field {
    input {
      value value
      placeholder placeholder
      type type
      onChange {
        onChange(value)
      }
    }
  }
}

component TextArea(value, placeholder, onChange) {
  field {
    textarea {
      value value
      placeholder placeholder
      autosize true
      maxRows 16
      onChange {
        onChange(value)
      }
    }
  }
}

component ProgressBar(value, tone) {
  progress {
    value value
    tone tone
    radius pill
    height 8
  }
}

component Kbd(keys) {
  pill {
    mono true
    size xs
    text keys
    tone surfaceMuted
  }
}

component Breadcrumb(items) {
  row {
    gap xs
    for i in items {
      text i.label
      size sm
      muted !i.active
      if !i.last {
        text "/"
        muted true
      }
    }
  }
}

component SectionHeader(title, subtitle, actions) {
  row {
    align center
    justify space-between
    left {
      column {
        title {
          text title
          size lg
          weight semibold
        }
        subtitle {
          text subtitle
          size sm
          muted true
        }
      }
    }
    right {
      slot actions
    }
  }
}

component Divider {
  hr {
    tone border
  }
}

component ListRow(label, value, mono) {
  row {
    align center
    justify space-between
    label {
      text label
      size sm
      muted true
    }
    value {
      text value
      size sm
      mono mono
    }
  }
}

component CodeBlock(code, language) {
  card {
    tone surfaceMuted
    padding md
    radius sm
    header {
      row {
        justify space-between
        text language
        size xs
        muted true
        button "Kopiuj" {
          style ghost
          action {
            clipboard.write code
          }
        }
      }
    }
    code {
      value code
      language language
      scrollable true
      mono true
    }
  }
}

component Markdown(content) {
  md {
    value content
    codeBlocks Copyable
    links SafeExternal true
    images Lazy true
  }
}

component ChatMessage(message) {
  row {
    align start
    gap md
    avatar {
      if message.role == "user" {
        Avatar(user)
      } else {
        image {
          src "/assets/al2100-avatar.svg"
          size 32
          radius pill
        }
      }
    }
    body {
      column {
        gap xs
        header {
          row {
            align center
            gap sm
            name {
              text message.role == "user" ? user.name : "AL2100"
              weight semibold
              size sm
            }
            text message.created_at
            size xs
            muted true
            if message.status != "completed" {
              Badge(message.status)
            }
          }
        }
        Markdown(message.content)
        if message.citations != "" && message.citations.length > 0 {
          citations {
            items message.citations
            render CitationChip(item)
          }
        }
        actions {
          button "Kopiuj" {
            style ghost
            action {
              clipboard.write message.content
            }
          }
          if message.role == "user" {
            button "Edytuj" {
              style ghost
              action {
                logic.openEditMessage(message.id)
              }
            }
          }
          if message.role == "assistant" && message.status == "completed" {
            button "Ponów" {
              style ghost
              action {
                logic.retryFromMessage(message.id)
              }
            }
          }
          button "Usuń" {
            style ghost
            action {
              logic.requestDeleteMessage(message.id)
            }
          }
        }
      }
    }
  }
}

component CitationChip(citation) {
  pill {
    tone surfaceMuted
    action {
      if logic.safeUrl(citation.url) {
        window.open(citation.url)
      }
    }
    text citation.title
    size xs
    mono true
  }
}

component StreamingCursor {
  cursor {
    blink true
    tone primary
  }
}

component ChatComposerFull {
  surface {
    tone surfaceElevated
    border top
    padding md
    column {
      gap sm
      if chat.attachments.length > 0 {
        attachments {
          items chat.attachments
          render AttachmentChip(item)
        }
      }
      textarea {
        value chat.draft
        placeholder "Napisz wiadomość… (Cmd/Ctrl + Enter wyśle)"
        autosize true
        maxRows 12
        onChange {
          chat.draft = value
        }
        onKey {
          if key == "Enter" && meta {
            logic.sendMessage()
          }
        }
      }
      row {
        align center
        justify space-between
        left {
          button "Załącz" {
            style ghost
            action {
              logic.openAttachmentPicker()
            }
          }
          button "Głos" {
            style ghost
            action {
              logic.startVoiceCapture()
            }
          }
          Toggle("Web", chat.webSearchEnabled, { chat.webSearchEnabled = value })
          Toggle("Prywatny", chat.privateMode, { chat.privateMode = value })
          if isGenerating {
            text chat.generation.provider + "/" + chat.generation.model
            size xs
            muted true
          }
        }
        right {
          if isGenerating {
            button "Stop" {
              style danger
              action {
                logic.stopGeneration()
              }
            }
          } else {
            button "Wyślij" {
              style primary
              disabled !canSend
              action {
                logic.sendMessage()
              }
            }
          }
        }
      }
    }
  }
}

component AttachmentChip(attachment) {
  pill {
    tone surface
    if attachment.status == "uploading" {
      Spinner("Wysyłanie…")
    }
    text attachment.name
    size xs
    action {
      chat.attachments = chat.attachments.filter(map { "id": attachment.id })
    }
  }
}

component ConversationListItem(conversation, active) {
  row {
    align center
    justify space-between
    padding sm
    tone active ? "surfaceElevated" : "surface"
    radius sm
    action {
      logic.selectConversation(conversation.id)
    }
    body {
      column {
        title {
          text conversation.title
          weight medium
          size sm
        }
        meta {
          text conversation.last_message_at
          size xs
          muted true
        }
      }
    }
    actions {
      if conversation.private_mode {
        Icon("lock", 14)
      }
      menu {
        items [
          map { "id": "rename", "label": "Zmień nazwę" },
          map { "id": "archive", "label": "Archiwizuj" },
          map { "id": "delete", "label": "Usuń" },
          map { "id": "pin", "label": "Przypnij do projektu" },
          map { "id": "export", "label": "Eksportuj" }
        ]
        onSelect {
          if item.id == "rename" {
            logic.renameConversation(conversation.id, prompt "Nowa nazwa")
          } else if item.id == "archive" {
            logic.archiveConversation(conversation.id)
          } else if item.id == "delete" {
            logic.requestDeleteConversation(conversation.id)
          } else if item.id == "pin" {
            logic.pinConversationToProject(conversation.id)
          } else if item.id == "export" {
            logic.exportConversation(conversation.id)
          }
        }
      }
    }
  }
}

component ProjectDetail(project) {
  column {
    gap md
    SectionHeader(project.name, project.description, {
      row {
        button "Edytuj" {
          style ghost
          action {
            logic.openEditProject(project.id)
          }
        }
        button "Archiwizuj" {
          style ghost
          action {
            logic.archiveProject(project.id)
          }
        }
      }
    })
    grid {
      columns 3
      StatCard("Zadania", "{count}", 0.0)
      StatCard("Aktywne", "{activeCount}", 0.0)
      StatCard("Deadline", "{nextDeadline}", 0.0)
    }
    tabs {
      items ["Zadania", "Rozmowy", "Pliki", "Pamięć", "Timeline"]
      section Zadania {
        list {
          items tasks.items.filter(map { "project_id": project.id })
          render TaskRow(item)
        }
      }
      section Rozmowy {
        list {
          items chat.conversations.filter(map { "project_id": project.id })
          render ConversationListItem(item, false)
        }
      }
      section Pliki {
        list {
          items files.items.filter(map { "project_id": project.id })
          render FileRow(item)
        }
      }
      section Pamięć {
        list {
          items memory.entries.filter(map { "scope_id": project.id })
          render MemoryCard(item)
        }
      }
      section Timeline {
        timeline {
          items tasks.items.filter(map { "project_id": project.id })
          render TimelineNode(item)
        }
      }
    }
  }
}

component TaskDetail(task) {
  column {
    gap md
    SectionHeader(task.title, task.description, {
      button "Zapisz" {
        style primary
        action {
          logic.saveTask(task)
        }
      }
    })
    field "status" {
      Select(["todo", "doing", "done", "blocked"], task.status, { task.status = value })
    }
    field "priority" {
      Select(["low", "normal", "high", "critical"], task.priority, { task.priority = value })
    }
    field "deadline" {
      Input(task.deadline, "YYYY-MM-DD", "date", { task.deadline = value })
    }
    field "project" {
      Select(projects.items, task.project_id, { task.project_id = value })
    }
    field "depends_on" {
      multiSelect {
        options tasks.items.filter(map { "id": task.id })
        value task.depends_on
        onChange {
          task.depends_on = value
        }
      }
    }
  }
}

component FilePreview(file) {
  column {
    gap md
    SectionHeader(file.name, "{file.mime} · {file.size} B", {
      row {
        button "Pobierz" {
          style primary
          action {
            logic.downloadFile(file.id)
          }
        }
        button "Usuń" {
          style danger
          action {
            logic.requestDeleteFile(file.id)
          }
        }
      }
    })
    if file.mime.startsWith("image/") {
      image {
        src "/api/files/{file.id}/download"
        alt file.name
        radius md
        fit contain
      }
    } else if file.mime.startsWith("audio/") {
      audio {
        src "/api/files/{file.id}/download"
        controls true
      }
    } else if file.mime.startsWith("video/") {
      video {
        src "/api/files/{file.id}/download"
        controls true
      }
    } else if file.extracted_text != "" {
      CodeBlock(file.extracted_text, "text")
    } else {
      Empty("Brak podglądu", "Ten typ pliku nie ma wbudowanego podglądu")
    }
    list {
      ListRow("Wersja", "{file.version}", false)
      ListRow("Status", file.status, false)
      ListRow("Utworzono", file.created_at, false)
    }
  }
}

component SearchResultsList(items, onSelect) {
  list {
    items items
    onSelect {
      onSelect(item)
    }
    render {
      column {
        gap xs
        title {
          text item.title
          weight medium
        }
        snippet {
          text item.snippet
          size sm
          muted true
        }
        meta {
          text item.url
          size xs
          mono true
        }
      }
    }
  }
}

component MusicReleaseDetail(release) {
  column {
    gap md
    SectionHeader(release.title, "{release.kind} · {release.status}", {
      row {
        button "Zapisz" {
          style primary
          action {
            logic.saveMusicRelease(release)
          }
        }
        button "Usuń" {
          style danger
          action {
            logic.requestDeleteMusicRelease(release.id)
          }
        }
      }
    })
    grid {
      columns 2
      field "Tytuł" {
        Input(release.title, "Tytuł", "text", { release.title = value })
      }
      field "Rodzaj" {
        Select(["single", "album", "ep"], release.kind, { release.kind = value })
      }
      field "Status" {
        Select(["draft", "in_progress", "mixed", "mastered", "released"], release.status, { release.status = value })
      }
      field "Data" {
        Input(release.release_date, "YYYY-MM-DD", "date", { release.release_date = value })
      }
      field "Dystrybucja" {
        Input(release.distribution, "Dystrybutor", "text", { release.distribution = value })
      }
      field "Prawa" {
        Select(["unset", "in_review", "cleared", "blocked"], release.rights_status, { release.rights_status = value })
      }
    }
    field "Opis" {
      TextArea(release.description, "Opis release…", { release.description = value })
    }
    SectionHeader("Tracklista", "", {
      button "Nowy track" {
        style primary
        action {
          logic.createMusicTrack()
        }
      }
    })
    list {
      items music.tracks.filter(map { "release_id": release.id })
      render MusicTrackRow(item)
    }
  }
}

component DeploymentLogs(items) {
