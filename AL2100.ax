component ModalDispatcher(name, payload) {
  if name == "Shortcuts" {
    ShortcutsModal()
  } else if name == "Confirm" {
    ConfirmModal(payload)
  } else if name == "AgentLog" {
    AgentLogModal(payload)
  } else if name == "MemoryFilters" {
    MemoryFiltersModal()
  } else if name == "EditProject" {
    EditProjectModal(payload)
  } else if name == "AddProvider" {
    AiKeysPanelModalWrapper()
  }
}

