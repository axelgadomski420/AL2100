logic {
  function nowIso() {
    return date.nowIso()
  }

  function newId(prefix) {
    return prefix + "-" + uuid.v4()
  }

  function safeUrl(url) {
    if !url.startsWith("https://") {
      return false
    }
    if url.includes("localhost") || url.includes("127.0.0.1") || url.includes("::1") {
      return false
    }
    if url.includes("169.254.") || url.includes("10.") || url.includes("192.168.") {
      return false
    }
    return true
  }

  function hashIp(ip) {
    return crypto.sha256(ip + "::" + env.AL_MASTER_ENCRYPTION_KEY)
  }

  function encryptSecret(plain) {
    return crypto.aesGcm.encrypt(plain, env.AL_MASTER_ENCRYPTION_KEY)
  }

  function decryptSecret(cipher) {
    return crypto.aesGcm.decrypt(cipher, env.AL_MASTER_ENCRYPTION_KEY)
  }

  function maskSecret(plain) {
    if plain.length <= 6 {
      return "••••••"
    }
    return plain.substring(0, 3) + "••••••" + plain.substring(plain.length - 3)
  }

  function rateCheck(userId, bucket) {
    key = "rate:" + bucket + ":" + userId
    count = cache.incr(key, 60)
    if count > settings.rateLimitPerMinute {
      throw "rate_limit_exceeded"
    }
    return true
  }

  function audit(userId, action, resource, resourceId, result, metadata) {
    db.insert("AuditLog", map {
      "user_id": userId,
      "action": action,
      "resource": resource,
      "resource_id": resourceId,
      "result": result,
      "metadata": metadata,
      "created_at": nowIso()
    })
  }

  function requestApproval(kind, resource, resourceId, payload) {
    id = newId("appr")
    db.insert("Approval", map {
      "id": id,
      "user_id": user.id,
      "kind": kind,
      "resource": resource,
      "resource_id": resourceId,
      "payload": payload,
      "status": "pending",
      "created_at": nowIso()
    })
    approvals.items = db.query("SELECT * FROM Approval WHERE user_id = ? AND status = 'pending'", [user.id])
    approvals.pendingCount = approvals.items.length
    return id
  }

  function approveRequest(id) {
    db.update("Approval", id, map { "status": "approved", "resolved_at": nowIso(), "resolved_by": user.id })
    approvals.items = db.query("SELECT * FROM Approval WHERE user_id = ? AND status = 'pending'", [user.id])
    approvals.pendingCount = approvals.items.length
    audit(user.id, "approval.approve", "Approval", id, "success", map {})
  }

  function rejectRequest(id) {
    db.update("Approval", id, map { "status": "rejected", "resolved_at": nowIso(), "resolved_by": user.id })
    approvals.items = db.query("SELECT * FROM Approval WHERE user_id = ? AND status = 'pending'", [user.id])
    approvals.pendingCount = approvals.items.length
    audit(user.id, "approval.reject", "Approval", id, "success", map {})
  }

  function loginWithGitHub() {
    url = oauth.github.startUrl(env.GITHUB_OAUTH_CLIENT_ID, env.PUBLIC_URL + "/auth/github/callback")
    navigate url
  }

  function loginWithGoogle() {
    url = oauth.google.startUrl(env.GOOGLE_OAUTH_CLIENT_ID, env.PUBLIC_URL + "/auth/google/callback")
    navigate url
  }

  function logout() {
    fetch("/api/logout", "POST", map {}, map { "X-CSRF-Token": session.csrfToken })
    session.id = ""
    session.csrfToken = ""
    nav.current = "Login"
  }

  function loadSession() {
    res = fetch("/api/session", "GET", null, null)
    if res.ok {
      session.id = res.body.sessionId
      session.csrfToken = res.body.csrfToken
      session.expiresAt = res.body.expiresAt
      user.id = res.body.user.id
      user.name = res.body.user.name
      user.email = res.body.user.email
      user.avatarUrl = res.body.user.avatarUrl
      user.provider = res.body.user.provider
      nav.current = "Czat"
      logic.loadConversations()
      logic.loadTasks()
      logic.loadProjects()
      logic.loadMemory()
      logic.loadApprovals()
      logic.loadProviders()
    } else {
      nav.current = "Login"
    }
  }

  function loadConversations() {
    res = fetch("/api/conversations", "GET", null, null)
    if res.ok {
      chat.conversations = res.body.items
    }
  }

  function createConversation() {
    rateCheck(user.id, "conversation:create")
    res = fetch("/api/conversations", "POST", map { "title": "Nowa rozmowa", "private_mode": chat.privateMode, "web_search": chat.webSearchEnabled }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      chat.conversations = [res.body] + chat.conversations
      chat.activeConversationId = res.body.id
      chat.messages = []
      audit(user.id, "conversation.create", "Conversation", res.body.id, "success", map {})
    }
  }

  function selectConversation(id) {
    chat.activeConversationId = id
    res = fetch("/api/conversations/" + id + "/messages", "GET", null, null)
    if res.ok {
      chat.messages = res.body.items
    }
  }

  function renameConversation(id, title) {
    fetch("/api/conversations/" + id, "PATCH", map { "title": title }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadConversations()
  }

  function archiveConversation(id) {
    fetch("/api/conversations/" + id, "PATCH", map { "archived": true }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadConversations()
  }

  function requestDeleteConversation(id) {
    requestApproval("delete", "Conversation", id, map { "id": id })
  }

  function pinConversationToProject(id) {
    projectId = prompt "ID projektu"
    fetch("/api/conversations/" + id, "PATCH", map { "project_id": projectId }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadConversations()
  }

  function sendMessage() {
    if !canSend {
      return
    }
    rateCheck(user.id, "chat:send")
    msgId = newId("msg")
    optimistic = map {
      "id": msgId,
      "role": "user",
      "content": chat.draft,
      "status": "completed",
      "created_at": nowIso()
    }
    chat.messages = chat.messages + [optimistic]
    body = map {
      "conversation_id": chat.activeConversationId,
      "content": chat.draft,
      "attachments": chat.attachments,
      "web_search": chat.webSearchEnabled,
      "private_mode": chat.privateMode
    }
    chat.draft = ""
    chat.generation.status = "pending"
    chat.generation.startedAt = nowIso()
    stream = fetchStream("/api/chat/send", "POST", body, map { "X-CSRF-Token": session.csrfToken })
    chat.generation.status = "streaming"
    stream.onChunk {
      if chat.messages.last.status != "streaming" {
        chat.messages = chat.messages + [map {
          "id": newId("msg"),
          "role": "assistant",
          "content": "",
          "status": "streaming",
          "provider": stream.provider,
          "model": stream.model,
          "created_at": nowIso()
        }]
        chat.generation.provider = stream.provider
        chat.generation.model = stream.model
      }
      chat.messages.last.content = chat.messages.last.content + chunk
      chat.generation.tokens = chat.generation.tokens + 1
    }
    stream.onDone {
      chat.messages.last.status = "completed"
      chat.generation.status = "completed"
      logic.loadConversations()
    }
    stream.onError {
      chat.generation.status = "failed"
      chat.lastError = error
      notify "Błąd generacji: {error}"
    }
  }

  function stopGeneration() {
    fetch("/api/chat/stop", "POST", map { "conversation_id": chat.activeConversationId }, map { "X-CSRF-Token": session.csrfToken })
    chat.generation.status = "interrupted"
  }

  function retryFromMessage(messageId) {
    fetch("/api/chat/retry", "POST", map { "message_id": messageId }, map { "X-CSRF-Token": session.csrfToken })
  }

  function openEditMessage(messageId) {
    content = prompt "Nowa treść"
    fetch("/api/messages/" + messageId, "PATCH", map { "content": content }, map { "X-CSRF-Token": session.csrfToken })
    logic.selectConversation(chat.activeConversationId)
  }

  function requestDeleteMessage(messageId) {
    requestApproval("delete", "Message", messageId, map { "id": messageId })
  }

  function openAttachmentPicker() {
    picker = file.pick(map { "multiple": true, "maxSize": 26214400 })
    for f in picker.files {
      logic.uploadAttachment(f)
    }
  }

  function uploadAttachment(file) {
    chat.attachments = chat.attachments + [map { "name": file.name, "status": "uploading" }]
    res = fetchMultipart("/api/files/upload", file, map { "conversation_id": chat.activeConversationId, "kind": file.kind }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      chat.attachments.last.status = "ready"
      chat.attachments.last.file_id = res.body.file_id
    } else {
      chat.attachments.last.status = "failed"
    }
  }

  function startVoiceCapture() {
    audio = media.record(map { "maxSeconds": 120 })
    file = audio.toFile("voice.webm")
    logic.uploadAttachment(file)
  }

  function loadProjects() {
    res = fetch("/api/projects", "GET", null, null)
    if res.ok {
      projects.items = res.body.items
    }
  }

  function createProject() {
    name = prompt "Nazwa projektu"
    res = fetch("/api/projects", "POST", map { "name": name }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      logic.loadProjects()
    }
  }

  function loadTasks() {
    res = fetch("/api/tasks", "GET", null, null)
    if res.ok {
      tasks.items = res.body.items
    }
  }

  function createTask() {
    title = prompt "Tytuł zadania"
    res = fetch("/api/tasks", "POST", map { "title": title, "status": "todo", "priority": "normal" }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      logic.loadTasks()
    }
  }

  function toggleTask(id, done) {
    fetch("/api/tasks/" + id, "PATCH", map { "status": done ? "done" : "todo" }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadTasks()
  }

  function openEditTask(id) {
    title = prompt "Nowy tytuł"
    fetch("/api/tasks/" + id, "PATCH", map { "title": title }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadTasks()
  }

  function requestDeleteTask(id) {
    requestApproval("delete", "Task", id, map { "id": id })
  }

  function loadMemory() {
    res = fetch("/api/memory", "GET", null, null)
    if res.ok {
      memory.entries = res.body.items
    }
  }

  function toggleMemoryEntry(id) {
    fetch("/api/memory/" + id, "PATCH", map { "disabled": true }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMemory()
  }

  function togglePinMemory(id) {
    fetch("/api/memory/" + id, "PATCH", map { "pinned": true }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMemory()
  }

  function runResearch() {
    research.status = "loading"
    res = fetch("/api/research", "POST", map { "query": research.query }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      research.results = res.body.results
      research.sources = res.body.sources
      research.status = "idle"
    } else {
      research.error = res.body.error
      research.status = "idle"
    }
  }

  function openSource(id) {
    src = research.sources.find(id)
    if safeUrl(src.url) {
      window.open(src.url)
    }
  }

  function openUploadDialog() {
    picker = file.pick(map { "multiple": true })
    for f in picker.files {
      logic.uploadFile(f)
    }
  }

  function uploadFile(file) {
    files.uploading = true
    res = fetchMultipart("/api/files/upload", file, map { "kind": file.kind }, map { "X-CSRF-Token": session.csrfToken })
    files.uploading = false
    if res.ok {
      logic.loadFiles()
    }
  }

  function loadFiles() {
    res = fetch("/api/files", "GET", null, null)
    if res.ok {
      files.items = res.body.items
    }
  }

  function downloadFile(id) {
    fetch("/api/files/" + id + "/download", "GET", null, null).then {
      saveAs(blob, name)
    }
  }

  function requestDeleteFile(id) {
    requestApproval("delete", "File", id, map { "id": id })
  }

  function connectGitHub() {
    url = oauth.github.startUrl(env.GITHUB_OAUTH_CLIENT_ID, env.PUBLIC_URL + "/auth/github/workspace/callback", "repo read:user")
    navigate url
  }

  function refreshRepos() {
    res = fetch("/api/github/repos", "GET", null, null)
    if res.ok {
      github.repos = res.body.items
    }
  }

  function requestDeployApproval() {
    requestApproval("deploy", "Deployment", deploy.activeTarget, map { "target": deploy.activeTarget })
  }

  function generateAppPlan() {
    appCreator.status = "generating"
    res = fetch("/api/appcreator/plan", "POST", map { "description": appCreator.description, "template": appCreator.template }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      appCreator.plan = res.body.plan
      appCreator.status = "idle"
    } else {
      appCreator.status = "failed"
    }
  }

  function generateAppCode() {
    appCreator.status = "generating"
    res = fetch("/api/appcreator/code", "POST", map { "plan": appCreator.plan, "template": appCreator.template }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      appCreator.code = res.body.code
      appCreator.diff = res.body.diff
      appCreator.status = "idle"
    } else {
      appCreator.status = "failed"
    }
  }

  function applyDiff() {
    fetch("/api/appcreator/apply", "POST", map { "diff": appCreator.diff }, map { "X-CSRF-Token": session.csrfToken })
  }

  function discardDiff() {
    appCreator.diff = ""
    appCreator.code = ""
  }

  function createMusicRelease() {
    title = prompt "Tytuł release"
    res = fetch("/api/music/releases", "POST", map { "title": title, "kind": "single", "status": "draft" }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      logic.loadMusicReleases()
    }
  }

  function createMusicTrack() {
    title = prompt "Tytuł tracku"
    res = fetch("/api/music/tracks", "POST", map { "title": title, "release_id": music.activeReleaseId, "mix_status": "unmixed" }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      logic.loadMusicTracks()
    }
  }

  function openEditTrack(id) {
    bpm = prompt "BPM"
    fetch("/api/music/tracks/" + id, "PATCH", map { "bpm": bpm }, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMusicTracks()
  }

  function loadMusicReleases() {
    res = fetch("/api/music/releases", "GET", null, null)
    if res.ok {
      music.releases = res.body.items
    }
  }

  function loadMusicTracks() {
    res = fetch("/api/music/tracks", "GET", null, null)
    if res.ok {
      music.tracks = res.body.items
    }
  }

  function loadProviders() {
    res = fetch("/api/providers", "GET", null, null)
    if res.ok {
      settings.providers = res.body.items
    }
  }

  function testProvider(provider) {
    settings.testStatus = "testing"
    res = fetch("/api/providers/" + provider + "/test", "POST", map {}, map { "X-CSRF-Token": session.csrfToken })
    settings.testStatus = res.ok ? "ok" : "failed"
    logic.loadProviders()
  }

  function openAddProvider() {
    provider = prompt "Dostawca (gemini|groq|mistral|openrouter|cloudflare|anthropic|openai)"
    key = prompt "Klucz API"
    res = fetch("/api/providers", "POST", map { "provider": provider, "key": key }, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      logic.loadProviders()
    }
  }

  function requestDeleteProvider(provider) {
    requestApproval("delete", "ProviderKey", provider, map { "provider": provider })
  }

  function loadApprovals() {
    res = fetch("/api/approvals", "GET", null, null)
    if res.ok {
      approvals.items = res.body.items
      approvals.pendingCount = approvals.items.length
    }
  }

  function loadSessions() {
    res = fetch("/api/sessions", "GET", null, null)
    if res.ok {
      session.activeSessions = res.body.items
    }
  }

  function revokeSession(id) {
    fetch("/api/sessions/" + id, "DELETE", null, map { "X-CSRF-Token": session.csrfToken })
    logic.loadSessions()
  }

  function revokeAllSessions() {
    requestApproval("delete", "Session", "all", map {})
  }

  function runDiagnostics() {
    diagnostics.lastRunAt = nowIso()
    res = fetch("/api/diagnostics", "POST", map {}, map { "X-CSRF-Token": session.csrfToken })
    if res.ok {
      diagnostics.checks = res.body.checks
      diagnostics.overall = res.body.overall
    }
  }

  event nav.commandPaletteOpen changed {
    if nav.commandPaletteOpen {
      ui.modal = map { "name": "CommandPalette" }
    }
  }

  event session.id changed {
    if session.id != "" {
      logic.loadSessions()
    }
  }

  event chat.activeConversationId changed {
    if chat.activeConversationId != "" {
      logic.selectConversation(chat.activeConversationId)
    }
  }

  event memory.filter changed {
    logic.loadMemory()
  }

  event tasks.view changed {
    logic.loadTasks()
  }

  event projects.view changed {
    logic.loadProjects()
  }

  event music.view changed {
    if music.view == "releases" {
      logic.loadMusicReleases()
    } else {
      logic.loadMusicTracks()
    }
  }

  onStart {
    logic.loadSession()
    logic.loadApprovals()
  }
}

flow Auth {
  start Login
  Login => Czat {
    when hasActiveSession
  }
  Czat => Login {
    when !hasActiveSession
  }
}

flow Onboarding {
  start Czat
  Czat => Ustawienia {
    when settings.selectedProvider == ""
  }
  Ustawienia => Czat {
    when settings.selectedProvider != ""
  }
}

flow Approval {
  start Zatwierdzenia
  Zatwierdzenia => Deploy {
    when deploy.status == "approved"
  }
  Deploy => Zatwierdzenia {
    when deploy.requiresApproval && deploy.status == "requested"
  }
}
component Toast(type, message) {
  surface {
    tone type
    radius md
    shadow soft
    padding md
    row {
      align center
      gap sm
      text message
      dismiss {
        timeout 4000
        onTimeout {
          ui.toast = map { "id": "", "type": "", "message": "" }
        }
      }
    }
  }
}

component Modal(name, payload) {
  overlay {
    tone overlay
    dialog {
      radius lg
      shadow hard
      padding xl
      renderByName name payload
      close {
        onDismiss {
          ui.modal = map { "name": "", "payload": "" }
        }
      }
    }
  }
}

component Alert(tone, message) {
  surface {
    tone tone
    radius sm
    padding md
    row {
      align center
      gap sm
      text message
      slot actions
    }
  }
}

component Badge(value) {
  pill {
    tone neutral
    size xs
    text value
  }
}

component Empty(title, subtitle) {
  center {
    padding xxl
    title title
    subtitle subtitle
    slot action
  }
}

component Spinner(text) {
  center {
    loader true
    text text
  }
}

component Logs(items) {
  card {
    tone surfaceMuted
    padding md
    code {
      lines items
      mono true
      scrollable true
    }
  }
}

component ProjectCard(project) {
  card {
    padding lg
    radius md
    tone surface
    title {
      text project.name
      weight semibold
      size lg
    }
    badge project.status
    description {
      text project.description
      size sm
      muted true
    }
    meta {
      text "{project.created_at} · {project.color}"
      size xs
      muted true
    }
    actions {
      button "Otwórz" {
        style ghost
        action {
          projects.activeId = project.id
        }
      }
      button "Zadania" {
        style ghost
        action {
          tasks.view = "all"
          nav.current = "Zadania"
        }
      }
      button "Archiwum" {
        style ghost
        action {
          logic.archiveProject(project.id)
        }
      }
      button "Usuń" {
        style danger
