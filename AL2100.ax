// ============================================================================
// AL2100.ax — JEDEN plik = CAŁA aplikacja
// Cloudflare Workers + D1 + R2 + Queues | GitHub Actions deploy
// Sekrety: AL_MASTER_ENCRYPTION_KEY, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
// ============================================================================

app "AL2100" {
  id "pl.axel.al2100"; version 1.0.0; author "Axel G"
  description "Prywatny polskojęzyczny system operacyjny AI"
  category productivity; theme dark; accent neon-cyan
  language ["pl", "en"]; offline false; minWindow 360x640
  platform min web es2022, android 11, ios 15
  signature { verify true; sandbox "strict" }
}

theme {
  mode dark
  colors {
    bg #06080F; bgAlt #0A0F1E; surface #121A2E; surfaceAlt #1A2340
    surfaceHover #222D4F; overlay rgba(0,0,0,0.72)
    text #EAF2FF; textMuted #8A99B8; textDim #5C6A85
    primary #00E5FF; primaryDark #00B8CC; primaryGlow rgba(0,229,255,0.18)
    secondary #7C4DFF; success #22D3A6; warning #FFB020; danger #FF4D6D; info #4D9EFF
    border #2A3550; borderAlt #1E2740
    codeBg #0D1424; codeKeyword #7C4DFF; codeString #22D3A6; codeComment #5C6A85
  }
  gradients {
    primary linear(135deg, #00E5FF, #7C4DFF)
    danger linear(135deg, #FF4D6D, #FFB020)
    surface linear(180deg, #121A2E, #0A0F1E)
  }
  typography {
    base "Inter"; heading "Space Grotesk"; mono "JetBrains Mono"
    size.xs 11; size.small 13; size.base 16; size.lg 18
    size.heading 24; size.xl 32; size.xxl 48; size.hero 64
    weight.normal 400; weight.medium 500; weight.bold 700
    leading.tight 1.2; leading.base 1.55
  }
  spacing { xxs 2; xs 4; sm 8; md 12; lg 16; xl 24; xxl 32; huge 48 }
  shape { radius 14; radiusSmall 8; radiusLarge 24; radiusFull 9999; border subtle; shadow soft }
  elevation {
    xs 0 1px 2px rgba(0,0,0,0.35); sm 0 2px 6px rgba(0,0,0,0.4)
    md 0 6px 18px rgba(0,0,0,0.5); lg 0 14px 40px rgba(0,0,0,0.6)
    glow 0 0 32px rgba(0,229,255,0.35); glowDanger 0 0 32px rgba(255,77,109,0.35)
  }
  motion { speed fast; standard 180ms; slow 320ms; reduceMotion respectSystem }
  breakpoints { mobile 640; tablet 1024; desktop 1280; wide 1920 }
  accessibility {
    minContrast 4.5; dynamicType true; highContrast support; keyboard true
    focusVisible 2px solid #00E5FF; reduceTransparency respectSystem
  }
}

permissions {
  internet: ask hosts [
    "api.github.com", "github.com", "uploads.github.com",
    "api.openai.com", "api.anthropic.com", "generativelanguage.googleapis.com",
    "api.mistral.ai", "api.groq.com", "openrouter.ai",
    "api.cloudflare.com", "api.search.brave.com", "api.serpapi.com"
  ]
  files: read scope "user/*"
  camera: ask reason "Zdjęcia jako kontekst dla AI"
  microphone: ask reason "Notatki głosowe i transkrypcja"
  notifications: ask reason "Zadania, zatwierdzenia i podsumowania"
  clipboard: write; location: never; contacts: never; calendar: never
}

sync {
  provider userCloud
  scope ["Conversation","Message","MemoryFact","ConversationSummary","Project","Task","FileRecord","MusicRelease"]
  conflict lastWriteWins; encrypt endToEnd; offlineQueue true
  retryOnFailure true; maxRetries 5; backoff exponential
}

ai {
  provider userChoice; budget 10.00 USD / day; budgetMonthly 100.00 USD / month
  routing { mode auto; fallback confirm; default "mistral"; preferCheap true; notifyProviderSwitch true }
  guardrails {
    deny code "eval|exec|shell|subprocess|rm -rf|fork bomb"
    deny url "file://|javascript:|data:text/html"
    require review true
    require approval for ["deploy","github.push","github.pr","memory.mutate","file.delete","conversation.delete","provider.delete","sessions.revoke_all"]
    max_output_tokens 8000; max_input_tokens 32000
    forbid system_override true; forbid external_exfiltration true
  }
  memory {
    context_builder_required true; include_summaries true; include_facts true
    include_project_state true; include_search_fragments true
    max_fragments 10; max_tokens 8000; degraded_mode_visible true
  }
  mode propose; context state, storage, theme
}

state {
  // AUTH
  auth.user_id = null; auth.github_login = null; auth.display_name = null
  auth.avatar_url = null; auth.checked = false; auth.sessions = []
  auth.onboarding_step = 0; auth.onboarding_complete = false

  // NAV
  nav.current_screen = "Login"; nav.history = []
  nav.sidebar_open = true; nav.context_panel_open = true
  nav.command_palette = false; nav.mobile_menu = false; nav.command_query = ""

  // CHAT
  chat.current_conversation_id = null; chat.conversations = []; chat.messages = []
  chat.draft = ""; chat.is_streaming = false; chat.stream_handle = null
  chat.context_mode = "full"; chat.context_reason = ""
  chat.search_enabled = true; chat.selected_provider = null; chat.selected_model = null
  chat.conv_search_query = ""; chat.conv_filter = "all"; chat.scroll_to_bottom = false

  // PROJECTS
  projects.list = []; projects.current_id = null; projects.search_query = ""

  // MEMORY
  memory.facts = []; memory.filter_kind = "all"; memory.manual_modal = false
  memory.new_fact = { kind: "fact", content: "" }

  // FILES
  files.list = []; files.uploading = false; files.upload_progress = 0

  // TASKS
  tasks.list = []; tasks.view = "today"

  // PROVIDERS
  providers.list = []; providers.editing = null; providers.testing = null; providers.show_key = false

  // INTEGRATIONS
  integrations.github_connected = false; integrations.github_username = null
  integrations.search_configured = false; integrations.cloudflare_configured = false

  // APPROVALS
  approvals.pending = []; approvals.current = null; approvals.modal_open = false

  // DIAGNOSTICS
  diagnostics.usage_today = { tokens: 0, cost: 0, requests: 0 }
  diagnostics.usage_month = { tokens: 0, cost: 0, requests: 0 }
  diagnostics.usage_by_provider = []; diagnostics.audit_recent = []; diagnostics.last_refresh = null

  // APP CREATOR
  appcreator.description = ""; appcreator.plan = null; appcreator.proposal_id = null
  appcreator.generating = false
  appcreator.templates = [
    { id: "flashcards", name: "Fiszki i nauka" },
    { id: "health", name: "Tracker zdrowia" },
    { id: "tasks", name: "Menedżer zadań" },
    { id: "notes", name: "Notatnik AI" },
    { id: "music", name: "Kreator muzyki" },
    { id: "research", name: "Research z cytowaniami" }
  ]

  // GITHUB
  github.repos = []; github.selected_repo = null; github.branches = []
  github.pulls = []; github.loading = false

  // MUSIC
  music.releases = []; music.current_id = null

  // SEARCH
  search.query = ""; search.results = []; search.loading = false; search.error = null

  // UI
  ui.toast = null; ui.toast_queue = []; ui.loading = false
  ui.modal = null; ui.confirm = null; ui.sidebar_collapsed = false

  computed is_authenticated { return auth.user_id != null }
  computed context_status_label {
    if chat.context_mode == "full" { return "Pełny kontekst" }
    return "Tryb ograniczony: " + chat.context_reason
  }
  computed pending_approvals_count { return approvals.pending.length }
  computed current_conversation { return chat.conversations.find(c -> c.id == chat.current_conversation_id) }
  computed current_project { return projects.list.find(p -> p.id == projects.current_id) }
  computed current_music_release { return music.releases.find(r -> r.id == music.current_id) }
  computed tasks_today { return tasks.list.filter(t -> t.deadline != null && t.status != "done" && isToday(t.deadline)) }
  computed tasks_blockers { return tasks.list.filter(t -> t.status == "blocked") }
  computed tasks_next { return tasks.list.filter(t -> t.status == "todo").slice(0, 5) }
  computed filtered_conversations {
    q = chat.conv_search_query.lower(); items = chat.conversations
    if chat.conv_filter == "archived" { items = items.filter(c -> c.archived_at != null) }
    else if chat.conv_filter == "private" { items = items.filter(c -> c.is_private == true) }
    else { items = items.filter(c -> c.archived_at == null) }
    if q != "" { items = items.filter(c -> c.title.lower().contains(q)) }
    return items
  }
  computed filtered_memory {
    if memory.filter_kind == "all" { return memory.facts }
    return memory.facts.filter(f -> f.kind == memory.filter_kind)
  }
  computed filtered_projects {
    q = projects.search_query.lower()
    if q == "" { return projects.list }
    return projects.list.filter(p -> p.name.lower().contains(q) || p.goal.lower().contains(q))
  }

  event auth.user_id changed {
    if auth.user_id != null { nav.current_screen = "Chat"; loadInitialData() }
    else { nav.current_screen = "Login" }
  }
  event chat.current_conversation_id changed {
    if chat.current_conversation_id != null { loadMessages(chat.current_conversation_id) }
    else { chat.messages = [] }
  }
  event nav.current_screen changed {
    nav.history = nav.history + [nav.current_screen]
    if nav.history.length > 50 { nav.history = nav.history.slice(-50) }
    nav.mobile_menu = false
  }
}

storage local "al2100.axdb" version 1 {
  model User {
    id text primary; github_login text unique; display_name text
    email text optional; avatar_url text optional
    created_at datetime; last_seen_at datetime optional
  }
  model Session {
    id text primary; user_id text; created_at datetime; expires_at datetime
    revoked_at datetime optional; user_agent text optional; ip_hash text optional
  }
  model Conversation {
    id text primary; user_id text; title text; project_id text optional
    is_private bool = false; archived_at datetime optional
    created_at datetime; updated_at datetime
  }
  model Message {
    id text primary; conversation_id text; user_id text
    role enum ["user","assistant","system","tool"]; content text
    generation_id text optional
    status enum ["pending","streaming","completed","interrupted","failed"]
    sources text optional; provider text optional; model text optional
    tokens_in number = 0; tokens_out number = 0; cost_usd number = 0
    created_at datetime
  }
  model MemoryFact {
    id text primary; user_id text
    kind enum ["preference","decision","fact","style"]; content text
    source_conversation_id text optional; source_message_id text optional
    pinned bool = false; disabled bool = false; created_at datetime
  }
  model ConversationSummary {
    id text primary; conversation_id text unique; user_id text
    topic text; decisions text optional; requirements text optional
    open_tasks text optional; next_step text optional; updated_at datetime
  }
  model Provider {
    id text primary; user_id text
    provider enum ["mistral","gemini","groq","openrouter","cloudflare","anthropic","openai"]
    encrypted_key text; key_version number = 1; model text optional
    status enum ["unverified","verified","error"] = "unverified"
    last_tested_at datetime optional; last_error text optional
  }
  model Project {
    id text primary; user_id text; name text; goal text; stage text
    stack text optional; decisions text optional; blockers text optional; updated_at datetime
  }
  model Task {
    id text primary; user_id text; project_id text optional; title text; description text optional
    status enum ["todo","doing","blocked","done"]
    priority enum ["low","normal","high","critical"] = "normal"
    deadline datetime optional; depends_on text optional; conversation_id text optional
    created_at datetime; updated_at datetime
  }
  model FileRecord {
    id text primary; user_id text; project_id text optional; conversation_id text optional
    filename text; mime text; size_bytes number; r2_key text
    indexed_text text optional; created_at datetime
  }
  model Approval {
    id text primary; user_id text; action text; parameters text
    token_hash text unique; consumed_at datetime optional
    expires_at datetime; created_at datetime
  }
  model AuditLog {
    id text primary; user_id text optional; action text
    target_type text optional; target_id text optional
    metadata text optional; ip_hash text optional; created_at datetime
  }
  model UsageRecord {
    id text primary; user_id text
    kind enum ["ai","search","storage","compute"]
    provider text optional; model text optional
    tokens_in number = 0; tokens_out number = 0; cost_usd number = 0; created_at datetime
  }
  model AppProposal {
    id text primary; user_id text; description text; plan text
    status enum ["pending","approved","generated","rejected"]; created_at datetime
  }
  model MusicRelease {
    id text primary; user_id text; title text; artist text
    type enum ["singiel","EP","album","mixtape"]
    status enum ["pomysł","produkcja","mix","master","gotowe","wydane"]
    release_date date optional; tracklist text optional
    bpm number optional; key text optional; suno_prompt text optional
    cover_url text optional; rights_status text optional; notes text optional
    created_at datetime; updated_at datetime
  }
  model RateLimit {
    id text primary; user_id text; bucket text; count number; window_start datetime
  }
  index Session.user_id; index Session.expires_at
  index Conversation.user_id; index Conversation.updated_at; index Conversation.project_id
  index Message.conversation_id; index Message.created_at
  index MemoryFact.user_id; index ConversationSummary.user_id
  index Provider.user_id; index Project.user_id
  index Task.user_id; index Task.project_id
  index FileRecord.user_id
  index Approval.user_id; index Approval.expires_at
  index AuditLog.user_id; index AuditLog.created_at
  index UsageRecord.user_id; index UsageRecord.created_at
  index AppProposal.user_id; index MusicRelease.user_id; index RateLimit.user_id
}

// ============================================================================
// COMPONENTS
// ============================================================================
component AppShell(content) {
  stack {
    if nav.sidebar_open { Sidebar() }
    main { content }
    if nav.context_panel_open { ContextPanel() }
    ToastBanner()
    CommandPalette()
    ConfirmDialog()
  }
}

component Sidebar() {
  sidebar {
    stack {
      image "assets/al2100-logo.svg" { size 28 }
      text "AL2100" { style heading; size lg }
    }
    NavItem("Czat", "message-circle", "Chat")
    NavItem("Projekty", "folder", "Projects")
    NavItem("Pamięć", "brain", "Memory")
    NavItem("Pliki", "file", "Files")
    NavItem("Zadania", "check-square", "Tasks")
    NavItem("Research", "search", "Research")
    NavItem("App Creator", "zap", "AppCreator")
    NavItem("GitHub", "github", "GitHub")
    NavItem("Deploy", "upload-cloud", "Deploy")
    NavItem("Muzyka", "music", "Music")
    NavItem("Ustawienia", "settings", "Settings")
    if pending_approvals_count > 0 { badge "{pending_approvals_count}" { tone warning } }
    if !integrations.github_connected {
      banner { text "GitHub niepołączony"; tone info; action { nav.current_screen = "GitHub" } }
    }
  }
}

component NavItem(label, icon_name, target) {
  button {
    style if nav.current_screen == target "primary" else "ghost"
    icon icon_name; text label
    action { nav.current_screen = target }
    tooltip label
  }
}

component ContextPanel() {
  sidebar {
    text "Kontekst" { style heading; size base }
    text "Projekt: {current_project?.name ?? 'brak'}" { style small }
    text "Rozmowa: {current_conversation?.title ?? 'brak'}" { style small }
    text "Tryb: {context_status_label}" { style small; tone if chat.context_mode == "full" "success" else "warning" }
    text "Zatwierdzenia: {pending_approvals_count}" { style small }
    if chat.selected_provider != null {
      text "AI: {chat.selected_provider} / {chat.selected_model ?? 'default'}" { style small muted }
    }
    button "Otwórz pamięć" { style ghost; action { nav.current_screen = "Memory" } }
    button "Ustawienia" { style ghost; action { nav.current_screen = "Settings" } }
  }
}

component ToastBanner() {
  if ui.toast != null {
    banner {
      text ui.toast.message; tone ui.toast.kind
      auto_dismiss 3s; on_close { ui.toast = null }
    }
  }
}

component EmptyState(icon_name, title, description) {
  center {
    icon icon_name { size 48; tone primary }
    text title { style heading }
    text description { style muted; align center }
  }
}

component LoadingSpinner() { spinner { tone primary } }

component StatCard(title, value, delta) {
  card {
    text title { style small muted }
    text value { style heading }
    if delta != null { text delta { style small; tone if delta.starts_with("-") "danger" else "success" } }
  }
}

component ProviderRow(p) {
  card {
    header {
      title p.provider; subtitle p.model ?? "brak modelu"
      trailing badge p.status { tone if p.status == "verified" "success" else if p.status == "error" "danger" else "warning" }
    }
    text "Ostatni test: {p.last_tested_at ?? 'nigdy'}" { style small muted }
    text "Klucz: {p.masked ?? '••••'}" { style small mono }
    if p.last_error != null { text "Błąd: {p.last_error}" { style small; tone danger } }
    button "Edytuj" { style ghost; action { providers.editing = p; nav.current_screen = "ProviderEdit" } }
    button "Testuj" { style secondary; disabled providers.testing == p.provider; action { testProviderConnection(p.provider) } }
    button "Usuń" { style danger; action { deleteProviderKey(p.provider) } }
  }
}

component ApprovalCard(a) {
  card "Wymaga zatwierdzenia" {
    text a.action { style mono }
    text a.parameters { style mono small muted }
    text "Wygasa: {a.expires_at}" { style small muted }
    button "Zatwierdź" { style primary; action { approveOperation(a.id) } }
    button "Odrzuć" { style danger; action { rejectOperation(a.id) } }
  }
}

component MessageBubble(msg) {
  card {
    header {
      title msg.role; subtitle msg.created_at
      trailing if msg.status != "completed" { badge msg.status { tone if msg.status == "failed" "danger" else "warning" } } else null
    }
    markdown msg.content
    if msg.sources != null { text "Źródła: {msg.sources}" { style small muted } }
    if msg.status == "streaming" { spinner { tone primary; size small } }
    actions {
      icon_button "copy" { action { clipboard.write(msg.content); toast("Skopiowano", "success") } }
      if msg.role == "user" { icon_button "edit" { action { editMessage(msg.id, msg.content) } } }
      if msg.role == "assistant" { icon_button "refresh" { action { retryMessage(msg.id) } } }
      icon_button "trash" { action { deleteMessage(msg.id) } }
    }
  }
}

component MemoryItem(f) {
  card {
    header {
      title f.content
      subtitle "Źródło: {f.source_conversation_id ?? 'ręcznie'} • {f.created_at}"
      trailing badge f.kind
    }
    toggle pinned f.pinned on_change { pinFact(f.id) }
    toggle disabled f.disabled on_change { toggleFactDisabled(f.id) }
    icon_button "trash" { action { deleteFact(f.id) } }
  }
}

component TaskItem(t) {
  card {
    header { title t.title; subtitle "{t.status} • {t.priority} • {t.deadline ?? 'brak terminu'}" }
    button "Przełącz" { style ghost; action { toggleTask(t.id) } }
    button "Usuń" { style danger; action { deleteTask(t.id) } }
  }
}

component ProjectCard(p) {
  card {
    header { title p.name; subtitle p.goal; trailing badge p.stage }
    text "Aktualizacja: {p.updated_at}" { style small muted }
    button "Otwórz" { style primary; action { projects.current_id = p.id; nav.current_screen = "ProjectDetail" } }
  }
}

component FileItem(f) {
  card {
    header { title f.filename; subtitle "{formatBytes(f.size_bytes)} • {f.created_at}"; trailing f.mime }
    icon_button "download" { action { downloadFile(f.id) } }
    icon_button "trash" { action { confirmDeleteFile(f.id) } }
  }
}

component MusicReleaseCard(r) {
  card {
    header { title r.title; subtitle "{r.artist} • {r.type}"; trailing badge r.status }
    text "BPM: {r.bpm ?? '—'} • Tonacja: {r.key ?? '—'}" { style small }
    button "Otwórz" { style primary; action { music.current_id = r.id; nav.current_screen = "MusicDetail" } }
  }
}

component CommandPalette() {
  if nav.command_palette {
    modal {
      title "Command palette"
      input q { placeholder "Szukaj akcji, ekranów, komend..."; value nav.command_query }
      list commands {
        item { title "Nowa rozmowa"; action { newConversation(); nav.command_palette = false } }
        item { title "Czat"; action { nav.current_screen = "Chat"; nav.command_palette = false } }
        item { title "Projekty"; action { nav.current_screen = "Projects"; nav.command_palette = false } }
        item { title "Pamięć"; action { nav.current_screen = "Memory"; nav.command_palette = false } }
        item { title "Zadania"; action { nav.current_screen = "Tasks"; nav.command_palette = false } }
        item { title "Research"; action { nav.current_screen = "Research"; nav.command_palette = false } }
        item { title "App Creator"; action { nav.current_screen = "AppCreator"; nav.command_palette = false } }
        item { title "Ustawienia"; action { nav.current_screen = "Settings"; nav.command_palette = false } }
        item { title "Wyloguj"; action { logout(); nav.command_palette = false } }
      }
      button "Zamknij" { style ghost; action { nav.command_palette = false } }
    }
  }
}

component ConfirmDialog() {
  if ui.confirm != null {
    modal {
      title "Potwierdzenie"; text ui.confirm.message
      button "Tak" { style danger; action { ui.confirm.on_yes(); ui.confirm = null } }
      button "Anuluj" { style ghost; action { ui.confirm = null } }
    }
  }
}

component UsageCard(title, usage) {
  card {
    text title { style heading; size base }
    text "${usage.cost}" { style heading; size lg; tone primary }
    text "{usage.tokens} tokenów • {usage.requests} żądań" { style small muted }
  }
}

// ============================================================================
// SCREENS
// ============================================================================
screen Login {
  title "AL2100"
  center {
    stack {
      image "assets/al2100-logo.svg" { size 72 }
      text "AL2100" { style heading; size xxl }
      text "Prywatny system operacyjny AI" { style muted }
      button "Zaloguj przez GitHub" { style primary; action { startGithubOAuth() } }
      button "Zaloguj przez Google" { style secondary; action { startGoogleOAuth() } }
      text "Sesja 30 dni • Klucze API szyfrowane AES-256-GCM" { style small muted }
    }
  }
}

screen Onboarding {
  title "Onboarding"
  center {
    stack {
      if auth.onboarding_step == 0 {
        text "Witaj w AL2100" { style heading }
        text "Zaczniemy od 3 kroków. Zajmie to 60 sekund." { style muted }
        button "Dalej" { style primary; action { advanceOnboarding() } }
      }
      if auth.onboarding_step == 1 {
        text "Dodaj klucz AI" { style heading }
        text "Możesz pominąć i dodać później w Ustawieniach." { style muted }
        button "Dodaj klucz" { style primary; action { openProviderEdit() } }
        button "Pomiń" { style ghost; action { advanceOnboarding() } }
      }
      if auth.onboarding_step == 2 {
        text "Połącz GitHub (opcjonalnie)" { style heading }
        text "Potrzebne do pracy nad kodem i Pull Requestów." { style muted }
        button "Połącz GitHub" { style primary; action { startGithubOAuth() } }
        button "Pomiń" { style ghost; action { advanceOnboarding() } }
      }
      if auth.onboarding_step >= 3 {
        text "Gotowe" { style heading }
        text "Możesz zacząć pracę." { style muted }
        button "Wejdź do AL2100" { style primary; action { finishOnboarding() } }
      }
    }
  }
}

screen Chat {
  title "Czat"
  AppShell {
    stack {
      sidebar {
        header {
          title "Rozmowy"
          action icon "plus" { action { newConversation() } }
        }
        input conv_search {
          placeholder "Szukaj w historii..."
          value chat.conv_search_query
          on_input { chat.conv_search_query = form.conv_search }
        }
        tabs {
          tab "Aktywne" { action { chat.conv_filter = "all" } }
          tab "Prywatne" { action { chat.conv_filter = "private" } }
          tab "Archiwum" { action { chat.conv_filter = "archived" } }
        }
        list conversations {
          items filtered_conversations
          item {
            title item.title; subtitle item.updated_at
            selected item.id == chat.current_conversation_id
            trailing if item.is_private "🔒" else null
            action { chat.current_conversation_id = item.id }
            actions {
              icon_button "edit" { action { renameConversation(item.id) } }
              icon_button "lock" { action { togglePrivate(item.id) } }
              icon_button "archive" { action { archiveConversation(item.id) } }
              icon_button "trash" { action { deleteConversation(item.id) } }
            }
          }
          empty { text "Brak rozmów" }
        }
      }
      main {
        header {
          title current_conversation?.title ?? "Nowa rozmowa"
          subtitle context_status_label
          actions {
            icon_button "search" { action { nav.command_palette = true } }
            icon_button "settings" { action { nav.current_screen = "Settings" } }
          }
        }
        list messages {
          items chat.messages
          item { MessageBubble(item) }
          empty { EmptyState("message-circle", "Zacznij rozmowę", "AL2100 pamięta Twoje projekty, decyzje i preferencje z poprzednich rozmów.") }
        }
        form composer {
          field message {
            control textarea
            placeholder "Napisz wiadomość… (Cmd/Ctrl+Enter wyśle)"
            value chat.draft
            on_input { chat.draft = form.message }
            on_submit { sendMessage() }
            rows 3
          }
          toggle search_enabled "Web search" { value chat.search_enabled; on_change { chat.search_enabled = !chat.search_enabled } }
          select provider {
            options providers.list.map(p -> p.provider)
            placeholder "Dostawca AI"
            value chat.selected_provider
            on_change { chat.selected_provider = form.provider }
          }
          button "Wyślij" { style primary; disabled chat.draft.trim() == "" || chat.is_streaming; action { sendMessage() } }
          button "Stop" { style danger; visible chat.is_streaming; action { stopGeneration() } }
        }
      }
    }
  }
}

