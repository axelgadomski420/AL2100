  route POST /api/memory {
    auth true
    csrf true
    handler {
      id = newId("mem")
      db.insert("MemoryEntry", map {
        "id": id,
        "user_id": user.id,
        "scope": body.scope,
        "scope_id": body.scope_id,
        "kind": body.kind,
        "content": body.content,
        "pinned": false,
        "disabled": false,
        "importance": body.importance,
        "created_at": nowIso(),
        "updated_at": nowIso(),
        "approval_state": "user_confirmed"
      })
      audit(user.id, "memory.create", "MemoryEntry", id, "success", map {})
      return { "ok": true, "body": db.queryOne("SELECT * FROM MemoryEntry WHERE id = ?", [id]) }
