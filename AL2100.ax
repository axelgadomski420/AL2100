  route GET /api/github/repos/:owner/:repo/prs/:number {
    auth true
    handler {
      token = cache.get("gh_token:" + user.id)
      if token == null {
        return { "ok": false, "status": 401 }
      }
      pr = gh.getPR(env, token, params.owner + "/" + params.repo, params.number)
      diff = gh.getPRDiff(env, token, params.owner + "/" + params.repo, params.number)
      return { "ok": true, "body": map { "pr": pr, "diff": diff } }
    }
  }

  route POST /api/github/repos/:owner/:repo/prs/:number/comment {
    auth true
    csrf true
    handler {
      token = cache.get("gh_token:" + user.id)
      if token == null {
        return { "ok": false, "status": 401 }
      }
      gh.commentPR(env, token, params.owner + "/" + params.repo, params.number, body.comment)
      return { "ok": true, "body": map { "commented": true } }
    }
  }

  route GET /api/deploy/targets {
    auth true
    handler {
      items = db.query("SELECT * FROM Deployment WHERE user_id = ? ORDER BY started_at DESC LIMIT 50", [user.id])
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route POST /api/deploy/request {
    auth true
    csrf true
    requiresApproval "deploy"
    handler {
      target = body.target
      environment = body.environment
      if environment == "production" {
        id = requestApproval("deploy", "Deployment", target, map { "target": target, "environment": environment })
        return { "ok": true, "body": map { "approvalId": id } }
      }
      did = newId("dpl")
      db.insert("Deployment", map {
        "id": did,
        "user_id": user.id,
        "target": target,
        "environment": "preview",
        "status": "running",
        "started_at": nowIso(),
        "logs": []
      })
      queue.push(env.AL_QUEUE, map { "kind": "deploy.run", "payload": map { "deployment_id": did, "user_id": user.id, "target": target, "environment": "preview" } })
      return { "ok": true, "body": map { "deploymentId": did } }
    }
  }

  route GET /api/deploy/:id {
    auth true
    handler {
      d = db.queryOne("SELECT * FROM Deployment WHERE id = ? AND user_id = ?", [params.id, user.id])
      if d == null {
        return { "ok": false, "status": 404 }
      }
      return { "ok": true, "body": d }
    }
  }

