worker AL2100Worker {
  entry "worker.js"
  routes [
    "/api/*",
    "/auth/*"
  ]
  bindings {
    D1 "AL_DB"
    R2 "AL_BUCKET"
    QUEUE "AL_QUEUE"
    KV "AL_KV"
  }
  secrets [
    "AL_MASTER_ENCRYPTION_KEY",
    "GITHUB_OAUTH_CLIENT_ID",
    "GITHUB_OAUTH_CLIENT_SECRET",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "PUBLIC_URL"
  ]
}

api {
  route GET /api/session {
    auth false
    handler {
      c = request.cookies["al_session"]
      if c == "" {
        return { "ok": false, "status": 401 }
      }
      s = db.queryOne("SELECT * FROM Session WHERE id = ? AND revoked_at IS NULL AND expires_at > ?", [c, nowIso()])
      if s == null {
        return { "ok": false, "status": 401 }
      }
      u = db.queryOne("SELECT * FROM User WHERE id = ?", [s.user_id])
      if u == null {
        return { "ok": false, "status": 401 }
      }
      return {
        "ok": true,
        "body": {
          "sessionId": s.id,
          "csrfToken": s.csrf_token,
          "expiresAt": s.expires_at,
          "user": {
            "id": u.id,
            "name": u.name,
            "email": u.email,
            "avatarUrl": u.avatar_url,
            "provider": u.provider
          }
        }
      }
    }
  }

  route POST /api/logout {
    auth true
    csrf true
    handler {
      db.update("Session", session.id, map { "revoked_at": nowIso() })
      audit(user.id, "session.logout", "Session", session.id, "success", map {})
      return { "ok": true, "body": map { "loggedOut": true } }
    }
  }

  route GET /auth/github/callback {
    auth false
    handler {
      code = request.query["code"]
      state = request.query["state"]
      if code == "" {
        return redirect("/")
      }
      token = oauth.github.exchange(env.GITHUB_OAUTH_CLIENT_ID, env.GITHUB_OAUTH_CLIENT_SECRET, code, env.PUBLIC_URL + "/auth/github/callback")
      profile = oauth.github.profile(token.access_token)
      u = db.queryOne("SELECT * FROM User WHERE provider = 'github' AND provider_user_id = ?", [profile.id])
      if u == null {
        uid = newId("usr")
        db.insert("User", map {
          "id": uid,
          "provider": "github",
          "provider_user_id": profile.id,
          "email": profile.email,
          "name": profile.name,
          "avatar_url": profile.avatar_url,
          "locale": "pl",
          "created_at": nowIso(),
          "updated_at": nowIso(),
          "last_login_at": nowIso()
        })
        u = db.queryOne("SELECT * FROM User WHERE id = ?", [uid])
      } else {
        db.update("User", u.id, map { "last_login_at": nowIso() })
      }
      sid = newId("ses")
      csrf = crypto.randomHex(32)
      db.insert("Session", map {
        "id": sid,
        "user_id": u.id,
        "csrf_token": csrf,
        "ip_hash": hashIp(request.ip),
        "user_agent": request.headers["user-agent"],
        "created_at": nowIso(),
        "expires_at": date.addDays(nowIso(), 30),
        "provider": "github"
      })
      audit(u.id, "session.create", "Session", sid, "success", map { "provider": "github" })
      return redirect("/", map { "Set-Cookie": "al_session=" + sid + "; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=2592000" })
    }
  }

  route GET /auth/google/callback {
    auth false
    handler {
      code = request.query["code"]
      if code == "" {
        return redirect("/")
      }
      token = oauth.google.exchange(env.GOOGLE_OAUTH_CLIENT_ID, env.GOOGLE_OAUTH_CLIENT_SECRET, code, env.PUBLIC_URL + "/auth/google/callback")
      profile = oauth.google.profile(token.access_token)
      u = db.queryOne("SELECT * FROM User WHERE provider = 'google' AND provider_user_id = ?", [profile.id])
      if u == null {
        uid = newId("usr")
        db.insert("User", map {
          "id": uid,
          "provider": "google",
          "provider_user_id": profile.id,
          "email": profile.email,
          "name": profile.name,
          "avatar_url": profile.avatar_url,
          "locale": "pl",
          "created_at": nowIso(),
          "updated_at": nowIso(),
          "last_login_at": nowIso()
        })
        u = db.queryOne("SELECT * FROM User WHERE id = ?", [uid])
      } else {
        db.update("User", u.id, map { "last_login_at": nowIso() })
      }
      sid = newId("ses")
      csrf = crypto.randomHex(32)
      db.insert("Session", map {
        "id": sid,
        "user_id": u.id,
        "csrf_token": csrf,
        "ip_hash": hashIp(request.ip),
        "user_agent": request.headers["user-agent"],
        "created_at": nowIso(),
        "expires_at": date.addDays(nowIso(), 30),
        "provider": "google"
      })
      audit(u.id, "session.create", "Session", sid, "success", map { "provider": "google" })
      return redirect("/", map { "Set-Cookie": "al_session=" + sid + "; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=2592000" })
    }
  }

