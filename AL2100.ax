  route GET /api/tasks/today {
    auth true
    handler {
      end = date.endOfDay(nowIso())
      items = db.query("SELECT * FROM Task WHERE user_id = ? AND status != 'done' AND deadline <= ? ORDER BY deadline ASC", [user.id, end])
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route GET /api/tasks/blockers {
    auth true
    handler {
      items = db.query("SELECT * FROM Task WHERE user_id = ? AND status = 'blocked' ORDER BY priority DESC", [user.id])
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route GET /api/tasks/next {
    auth true
    handler {
      items = db.query("SELECT * FROM Task WHERE user_id = ? AND status IN ('todo','doing') ORDER BY priority DESC, deadline ASC LIMIT 5", [user.id])
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route POST /api/tasks/:id/complete {
    auth true
    csrf true
    handler {
      t = db.queryOne("SELECT * FROM Task WHERE id = ? AND user_id = ?", [params.id, user.id])
      if t == null {
        return { "ok": false, "status": 404 }
      }
      db.update("Task", t.id, map { "status": "done", "updated_at": nowIso() })
      audit(user.id, "task.complete", "Task", t.id, "success", map {})
      return { "ok": true, "body": map { "done": true } }
    }
  }

  route POST /api/tasks/:id/block {
    auth true
    csrf true
    handler {
      t = db.queryOne("SELECT * FROM Task WHERE id = ? AND user_id = ?", [params.id, user.id])
      if t == null {
        return { "ok": false, "status": 404 }
      }
      db.update("Task", t.id, map { "status": "blocked", "updated_at": nowIso() })
      return { "ok": true, "body": map { "blocked": true } }
    }
  }

  route GET /api/projects/:id {
