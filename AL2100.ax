  route GET /api/providers {
    auth true
    handler {
      rows = db.query("SELECT * FROM ProviderKey WHERE user_id = ? AND status != 'deleted'", [user.id])
      out = []
      for r in rows {
        plain = decryptSecret(r.encrypted_key)
        out = out + [map {
          "provider": r.provider,
          "status": r.status,
          "maskedKey": maskSecret(plain),
          "lastTested": r.last_tested_at
        }]
      }
      return { "ok": true, "body": map { "items": out } }
    }
  }

  route POST /api/providers {
    auth true
    csrf true
    handler {
      provider = body.provider
      key = body.key
      if provider == "" || key == "" {
        return { "ok": false, "status": 400 }
      }
      if !ai.isKnownProvider(provider) {
        return { "ok": false, "status": 400, "body": map { "error": "unknown_provider" } }
      }
      enc = encryptSecret(key)
      existing = db.queryOne("SELECT * FROM ProviderKey WHERE user_id = ? AND provider = ?", [user.id, provider])
      if existing != null {
        db.update("ProviderKey", existing.id, map {
          "encrypted_key": enc.cipher,
          "nonce": enc.nonce,
          "version": enc.version,
          "status": "active",
          "last_tested_at": null
        })
      } else {
        db.insert("ProviderKey", map {
          "id": newId("pky"),
          "user_id": user.id,
          "provider": provider,
          "encrypted_key": enc.cipher,
          "nonce": enc.nonce,
          "version": enc.version,
          "status": "active",
          "last_tested_at": null,
          "created_at": nowIso()
        })
      }
      audit(user.id, "provider.save", "ProviderKey", provider, "success", map { "provider": provider })
      return { "ok": true, "body": map { "provider": provider } }
    }
  }

  route POST /api/providers/:provider/test {
    auth true
    csrf true
    handler {
      provider = params.provider
      row = db.queryOne("SELECT * FROM ProviderKey WHERE user_id = ? AND provider = ? AND status != 'deleted'", [user.id, provider])
      if row == null {
        return { "ok": false, "status": 404 }
      }
      key = decryptSecret(row.encrypted_key)
      ok = ai.testKey(provider, key)
      db.update("ProviderKey", row.id, map {
        "status": ok ? "active" : "invalid",
        "last_tested_at": nowIso()
      })
      audit(user.id, "provider.test", "ProviderKey", provider, ok ? "success" : "failure", map {})
      return { "ok": ok, "body": map { "provider": provider, "status": ok ? "ok" : "failed" } }
    }
  }

