  route POST /api/research {
    auth true
    csrf true
    rateLimit "research:run"
    handler {
      q = body.query
      queries = logic.expandQueries(q)
      results = []
      for sub in queries {
        r = search.run(sub, map { "maxResults": 8, "maxDomains": 10, "timeoutMs": 4000 })
        for hit in r.results {
          if safeUrl(hit.url) {
            results = results + [hit]
            db.insert("ResearchSource", map {
              "id": newId("src"),
              "user_id": user.id,
              "conversation_id": body.conversation_id,
              "query": sub,
              "url": hit.url,
              "title": hit.title,
              "snippet": hit.snippet,
              "published_at": hit.published_at,
              "fetched_at": nowIso(),
              "trust_score": hit.trust_score
            })
          }
        }
      }
      sources = db.query("SELECT * FROM ResearchSource WHERE user_id = ? ORDER BY fetched_at DESC LIMIT 50", [user.id])
      return { "ok": true, "body": map { "results": results, "sources": sources } }
    }
  }

