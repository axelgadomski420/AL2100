logic {
  function openEditProject(id) {
    p = projects.items.find(map { "id": id })
    ui.modal = map { "name": "EditProject", "payload": p }
  }

  function saveTask(task) {
    fetch("/api/tasks/" + task.id, "PATCH", task, map { "X-CSRF-Token": session.csrfToken })
    logic.loadTasks()
  }

  function saveMusicRelease(release) {
    fetch("/api/music/releases/" + release.id, "PATCH", release, map { "X-CSRF-Token": session.csrfToken })
    logic.loadMusicReleases()
  }

  function requestDeleteMusicRelease(id) {
    requestApproval("delete", "MusicRelease", id, map { "id": id })
  }

  function exportConversation(id) {
    res = fetch("/api/conversations/" + id + "/export", "GET", null, null)
    if res.ok {
      download.blob(res.body.markdown, "conversation-" + id + ".md")
    }
  }

  function openConversationSearch() {
    ui.modal = map { "name": "ConversationSearch" }
  }

  function runAgentForIntent(intent) {
    agents.forcedMode = intent
    logic.sendMessage()
  }

  function setWebSearch(value) {
    chat.webSearchEnabled = value
  }

  function setPrivateMode(value) {
    chat.privateMode = value
  }

  function openMemoryFilters() {
    ui.modal = map { "name": "MemoryFilters" }
  }

  function toggleSidebar() {
    nav.sidebarCollapsed = !nav.sidebarCollapsed
  }

  function openCommandPalette() {
    nav.commandPaletteOpen = true
  }

  function closeCommandPalette() {
    nav.commandPaletteOpen = false
  }

  function navigateTo(screen) {
    nav.previous = nav.current
    nav.current = screen
    ui.modal = map { "name": "", "payload": "" }
  }

  function goBack() {
    nav.current = nav.previous
    nav.previous = ""
  }

  function confirm(message, onConfirm) {
    ui.modal = map { "name": "Confirm", "payload": map { "message": message, "onConfirm": onConfirm } }
  }

  function toast(type, message) {
    ui.toast = map { "id": uuid.v4(), "type": type, "message": message }
  }

  function scheduleAgentRun(agentName, payload) {
    queue.push(env.AL_QUEUE, map { "kind": "agent.run", "payload": map { "agent": agentName, "user_id": user.id, "conversation_id": chat.activeConversationId, "input": payload } })
    agents.lastRunId = ""
  }

  function cancelAllAgents() {
    for r in agents.activeRuns {
      logic.cancelAgentRun(r.id)
    }
  }

  function retryLastGeneration() {
    if chat.messages.length > 0 {
      last = chat.messages.last
      if last.role == "assistant" {
        logic.retryFromMessage(last.id)
      }
    }
  }

  function copyLastMessage() {
    if chat.messages.length > 0 {
      clipboard.write(chat.messages.last.content)
    }
  }

  function clearChatError() {
    chat.lastError = ""
  }

  function refreshAll() {
    logic.loadConversations()
    logic.loadProjects()
    logic.loadTasks()
    logic.loadMemory()
    logic.loadFiles()
    logic.loadApprovals()
    logic.loadProviders()
    logic.loadSessions()
  }

  event nav.current changed {
    if nav.current == "Czat" {
      logic.loadConversations()
    }
    if nav.current == "Zadania" {
      logic.loadTasks()
    }
    if nav.current == "Projekty" {
      logic.loadProjects()
    }
    if nav.current == "Pamięć" {
      logic.loadMemory()
    }
    if nav.current == "Pliki" {
      logic.loadFiles()
    }
    if nav.current == "Zatwierdzenia" {
      logic.loadApprovals()
    }
    if nav.current == "Sesje" {
      logic.loadSessions()
    }
    if nav.current == "Ustawienia" {
      logic.loadProviders()
    }
    if nav.current == "Muzyka" {
      logic.loadMusicReleases()
      logic.loadMusicTracks()
    }
  }

  event chat.lastError changed {
    if chat.lastError != "" {
      toast("danger", chat.lastError)
    }
  }

  event github.connected changed {
    if github.connected {
      logic.refreshRepos()
    }
  }

  event deploy.status changed {
    if deploy.status == "succeeded" {
      toast("success", "Deploy zakończony")
    }
    if deploy.status == "failed" {
      toast("danger", "Deploy nie powiódł się")
    }
  }

  event appCreator.status changed {
    if appCreator.status == "failed" {
      toast("danger", "App Creator nie powiódł się")
    }
  }

  event research.status changed {
    if research.status == "idle" && research.error != "" {
      toast("danger", research.error)
    }
  }

  onStart {
    if !ui.online {
      memory.contextMode = "degraded"
    }
    logic.loadSession()
    logic.loadApprovals()
    logic.loadProviders()
    logic.loadConversations()
    logic.loadProjects()
    logic.loadTasks()
    logic.loadMemory()
    logic.loadFiles()
    logic.loadMusicReleases()
    logic.loadMusicTracks()
    logic.loadSessions()
  }

  onStop {
    if isGenerating {
      logic.stopGeneration()
    }
  }
}

ai {
  context {
    maxRecentMessages 30
    maxMemoryEntries 40
    maxSources 20
    maxAttachments 5
    truncateStrategy tail
    includeSystemPrompt true
  }
  systemPrompt {
    pl "Jesteś AL2100 — ultra-asystentem operacyjnym w prywatnym systemie użytkownika. Odpowiadasz zwięźle, konkretnie, po polsku. Nie wymyślasz faktów. Gdy używasz źródeł, cytujesz je. Gdy proponujesz trwałe zmiany, czekasz na zatwierdzenie."
    en "You are AL2100 — an ultra-operational assistant in the user's private system. Answer concisely, concretely, in English. Never fabricate facts. Cite sources when used. Propose, never execute irreversible actions without approval."
  }
  classifier {
    model "fastestAvailable"
    intents ["chat", "question", "research", "code", "memory", "files", "app", "deploy", "music", "agent", "ops"]
    fallback "chat"
  }
  memoryExtraction {
    model "bestCodeModel"
    kinds ["fact", "decision", "rejection", "question", "blocker", "summary"]
    scopes ["global", "project", "conversation"]
    maxPerCall 12
    minConfidence 0.6
    requireUserConfirmFor ["decision", "rejection"]
  }
  agentSteps {
    defaultModel "bestCodeModel"
    maxStepTokens 4000
    allowedTools ["search", "fetch", "memory", "files", "github", "cloudflare", "music", "appcreator"]
    blockUnsafeUrls true
    requireApprovalFor ["delete", "deploy", "push", "external_call", "memory_promote"]
  }
  streaming {
    chunkSize 32
    flushMs 40
    heartbeatMs 15000
    maxDurationSeconds 180
  }
  retries {
    maxAttempts 3
    backoff "exponential"
    jitter true
    retryOn ["rate_limit", "timeout", "server_error"]
  }
}

search {
  providers {
    brave {
      apiKey from secure "brave_api_key"
      baseUrl "https://api.search.brave.com/res/v1"
    }
    serper {
      apiKey from secure "serper_api_key"
      baseUrl "https://google.serper.dev"
    }
    tavily {
      apiKey from secure "tavily_api_key"
      baseUrl "https://api.tavily.com"
    }
    cloudflare {
      apiKey from secure "cf_api_token"
      accountId from secure "cf_account_id"
    }
  }
  routing {
    default => userChoice
    fallback => fastestAvailable
  }
  limits {
    maxResults 12
    maxDomains 20
    maxBytesPerPage 2000000
    timeoutMs 8000
    blockPrivateIps true
    blockMetadataEndpoints true
    blockLocalhost true
    requireHttps true
  }
  citations {
    requireUrl true
    requireTitle true
    dedupeByUrl true
    storeSources true
  }
}

github {
  oauth {
    scopes ["repo", "read:user", "workflow"]
    callbackPath "/auth/github/workspace/callback"
  }
  safety {
    protectedBranches ["main", "master", "production"]
    requireApprovalForPush true
    requireApprovalForPRToProtected true
    neverForcePush true
    neverDeleteBranchWithoutApproval true
  }
  diff {
    contextLines 3
    maxFilesPerPR 40
    maxBytes 500000
  }
  pr {
    titleTemplate "AL2100: {summary}"
    bodyTemplate "Zmiany wygenerowane przez AL2100.\n\n{details}\n\nZatwierdzone przez {user}."
    draft true
  }
}

cloudflare {
  worker {
    name "al2100"
    compatibilityDate "2026-10-30"
    compatibilityFlags ["nodejs_compat"]
  }
  d1 {
    binding "AL_DB"
    migrationsDir "migrations"
  }
  r2 {
    binding "AL_BUCKET"
  }
  queues {
    binding "AL_QUEUE"
    producer "al2100-jobs"
    consumer "al2100-jobs"
  }
  kv {
    binding "AL_KV"
  }
  safety {
    requireApprovalForDeploy true
    requireApprovalForRollback true
    neverDeleteProductionWithoutApproval true
    redactLogs true
  }
}

audio {
  transcription {
    model "whisper-large-v3"
    language "auto"
    maxDurationSeconds 600
  }
  analysis {
    detectBpm true
    detectKey true
    detectEnergy true
    detectDuration true
  }
}

pdf {
  extraction {
    maxPages 200
    maxBytes 20000000
    ocrFallback true
  }
}

ui {
  layout {
    desktopGrid "280px 1fr 320px"
    mobileBottomNav true
    mobileSafeArea true
    focusRingVisible true
    minTouchTarget 44
  }
  navigation {
    items [
      map { "id": "Czat", "label": "Czat", "icon": "sparkles", "screen": "Czat" },
      map { "id": "Projekty", "label": "Projekty", "icon": "folder", "screen": "Projekty" },
      map { "id": "Zadania", "label": "Zadania", "icon": "check", "screen": "Zadania" },
      map { "id": "Pamięć", "label": "Pamięć", "icon": "brain", "screen": "Pamięć" },
      map { "id": "Pliki", "label": "Pliki", "icon": "file", "screen": "Pliki" },
      map { "id": "Research", "label": "Research", "icon": "search", "screen": "Research" },
      map { "id": "Timeline", "label": "Timeline", "icon": "timeline", "screen": "Timeline" },
      map { "id": "App Creator", "label": "App Creator", "icon": "wrench", "screen": "App Creator" },
      map { "id": "GitHub", "label": "GitHub", "icon": "git", "screen": "GitHub" },
      map { "id": "Deploy", "label": "Deploy", "icon": "rocket", "screen": "Deploy" },
      map { "id": "Muzyka", "label": "Muzyka", "icon": "music", "screen": "Muzyka" },
      map { "id": "Zatwierdzenia", "label": "Zatwierdzenia", "icon": "shield", "screen": "Zatwierdzenia" },
      map { "id": "Sesje", "label": "Sesje", "icon": "user", "screen": "Sesje" },
      map { "id": "Ustawienia", "label": "Ustawienia", "icon": "gear", "screen": "Ustawienia" },
      map { "id": "Diagnostyka", "label": "Diagnostyka", "icon": "pulse", "screen": "Diagnostyka" }
    ]
  }
  shortcuts {
    commandPalette "CmdOrCtrl+K"
    sendMessage "CmdOrCtrl+Enter"
    newConversation "CmdOrCtrl+N"
    toggleSidebar "CmdOrCtrl+B"
    focusSearch "CmdOrCtrl+F"
    closeModal "Escape"
  }
  accessibility {
    keyboardNavigation true
    screenReaderLabels true
    highContrast true
    reducedMotion respectSystem
    focusTrapInModals true
  }
  motion {
    pageTransition 220ms
    modalEnter 220ms
    toastEnter 180ms
    listItemStagger 40ms
    disableOnReducedMotion true
  }
}

security {
  csrf {
    enabled true
    headerName "X-CSRF-Token"
    cookieName "al_csrf"
    rotateOnLogin true
  }
  rateLimiting {
    enabled true
    buckets {
      "chat:send" 30
      "conversation:create" 20
      "files:upload" 20
      "research:run" 10
      "auth:callback" 10
    }
    windowSeconds 60
  }
  headers {
    "Content-Security-Policy" "default-src 'self'; img-src 'self' data: https:; media-src 'self' https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    "Strict-Transport-Security" "max-age=63072000; includeSubDomains; preload"
    "X-Content-Type-Options" "nosniff"
    "X-Frame-Options" "DENY"
    "Referrer-Policy" "strict-origin-when-cross-origin"
    "Permissions-Policy" "camera=(self), microphone=(self), geolocation=()"
    "Cross-Origin-Opener-Policy" "same-origin"
    "Cross-Origin-Resource-Policy" "same-origin"
  }
  encryption {
    masterKeyEnv "AL_MASTER_ENCRYPTION_KEY"
    algorithm "AES-256-GCM"
    nonceBytes 12
    version 1
    rotateEveryDays 90
    keyRetentionVersions 3
  }
  urlGuard {
    allowOnlyHttps true
    blockLocalhost true
    blockPrivateRanges true
    blockMetadataEndpoints true
    blockUserInfoInUrl true
    maxUrlLength 2048
  }
  secrets {
    hideFromLogs true
    hideFromExports true
    hideFromPrompts true
    hideFromAnalytics true
    maskPrefixChars 3
    maskSuffixChars 3
  }
  sessions {
    cookieName "al_session"
    httpOnly true
    secure true
    sameSite "Lax"
    path "/"
    maxAgeDays 30
    rotateOnPrivilegeChange true
    absoluteTimeoutDays 90
  }
}

storage local "al2100.axdb" {
  migrations {
    v1 { apply "initial" }
    v2 { apply "add_indexes" }
    v3 { apply "add_music" }
    v4 { apply "add_agents" }
  }
  retention {
    AuditLog.days 180
    AgentRun.days 30
    ResearchSource.days 90
    Approval.expiredDays 14
  }
}

theme {
  variants {
    darker {
      colors.background #050810
      colors.surface #0A1020
      colors.surfaceElevated #101830
    }
    system {
      colors.auto true
    }
  }
}

flow Chat {
  start Czat
  Czat => Czat when chat.activeConversationId != ""
  Czat => Ustawienia when settings.providers.length == 0
  Ustawienia => Czat when settings.providers.length > 0
}

flow ResearchFlow {
  start Research
  Research => Research when research.status == "loading"
  Research => Czat when research.results.length > 0
}

flow FilesFlow {
  start Pliki
  Pliki => Pliki when files.uploading
  Pliki => Czat when files.selectedId != ""
}

flow MemoryFlow {
  start Pamięć
  Pamięć => Pamięć when memory.filter != "all"
  Pamięć => Czat when memory.entries.length > 0
}

flow DeployFlow {
  start Deploy
  Deploy => Zatwierdzenia when deploy.requiresApproval
  Zatwierdzenia => Deploy when deploy.status == "approved"
  Deploy => Deploy when deploy.status == "running"
}

flow MusicFlow {
  start Muzyka
  Muzyka => Muzyka when music.view == "releases"
  Muzyka => Muzyka when music.view == "tracks"
}

api {
  route GET /api/agents/runs/:id {
    auth true
    handler {
      r = db.queryOne("SELECT * FROM AgentRun WHERE id = ? AND user_id = ?", [params.id, user.id])
      if r == null {
        return { "ok": false, "status": 404 }
      }
      return { "ok": true, "body": r }
    }
  }

  route POST /api/agents/runs/:id/cancel {
    auth true
    csrf true
    handler {
      ai.abortAgent(params.id)
      db.update("AgentRun", params.id, map { "status": "cancelled", "finished_at": nowIso() })
      return { "ok": true, "body": map { "cancelled": true } }
    }
  }

  route POST /api/github/index {
    auth true
    csrf true
    handler {
      gh.indexRepo(env, user.id, body.repo)
      return { "ok": true, "body": map { "indexed": true } }
    }
  }

  route POST /api/github/sync {
    auth true
    csrf true
    handler {
      gh.syncRepo(env, user.id, body.repo)
      return { "ok": true, "body": map { "synced": true } }
    }
  }

  route POST /api/github/branch {
    auth true
    csrf true
    requiresApproval "push"
    handler {
      id = requestApproval("push", "GitHubRepo", body.repo, map { "diff": body.diff, "branch": body.branch, "repo": body.repo })
      return { "ok": true, "body": map { "approvalId": id } }
    }
  }

  route GET /api/conversations/:id/export {
    auth true
    handler {
      cn = db.queryOne("SELECT * FROM Conversation WHERE id = ? AND user_id = ?", [params.id, user.id])
      if cn == null {
        return { "ok": false, "status": 404 }
      }
      msgs = db.query("SELECT * FROM Message WHERE conversation_id = ? ORDER BY created_at ASC", [params.id])
      md = "# " + cn.title + "\n\n"
      for m in msgs {
        md = md + "## " + m.role + " — " + m.created_at + "\n\n" + m.content + "\n\n"
      }
      return { "ok": true, "body": map { "markdown": md } }
    }
  }

  route PATCH /api/music/releases/:id {
    auth true
    csrf true
    handler {
      r = db.queryOne("SELECT * FROM MusicRelease WHERE id = ? AND user_id = ?", [params.id, user.id])
      if r == null {
        return { "ok": false, "status": 404 }
      }
      patch = map { "updated_at": nowIso() }
      if body.title != null {
        patch.title = body.title
      }
      if body.kind != null {
        patch.kind = body.kind
      }
      if body.status != null {
        patch.status = body.status
      }
      if body.release_date != null {
        patch.release_date = body.release_date
      }
      if body.distribution != null {
        patch.distribution = body.distribution
      }
      if body.rights_status != null {
        patch.rights_status = body.rights_status
      }
      if body.description != null {
        patch.description = body.description
      }
      db.update("MusicRelease", params.id, patch)
      return { "ok": true, "body": db.queryOne("SELECT * FROM MusicRelease WHERE id = ?", [params.id]) }
    }
  }

  route PATCH /api/music/tracks/:id {
    auth true
    csrf true
    handler {
      t = db.queryOne("SELECT * FROM MusicTrack WHERE id = ? AND user_id = ?", [params.id, user.id])
      if t == null {
        return { "ok": false, "status": 404 }
      }
      patch = map { "updated_at": nowIso() }
      if body.title != null {
        patch.title = body.title
      }
      if body.bpm != null {
        patch.bpm = body.bpm
      }
      if body.key != null {
        patch.key = body.key
      }
      if body.mix_status != null {
        patch.mix_status = body.mix_status
      }
      if body.suno_prompt != null {
        patch.suno_prompt = body.suno_prompt
      }
      if body.elevenlabs_prompt != null {
        patch.elevenlabs_prompt = body.elevenlabs_prompt
      }
      if body.energy != null {
        patch.energy = body.energy
      }
      if body.duration_seconds != null {
        patch.duration_seconds = body.duration_seconds
      }
      db.update("MusicTrack", params.id, patch)
      return { "ok": true, "body": db.queryOne("SELECT * FROM MusicTrack WHERE id = ?", [params.id]) }
    }
  }

  route PATCH /api/projects/:id {
    auth true
    csrf true
    handler {
      p = db.queryOne("SELECT * FROM Project WHERE id = ? AND user_id = ?", [params.id, user.id])
      if p == null {
        return { "ok": false, "status": 404 }
      }
      patch = map { "updated_at": nowIso() }
      if body.name != null {
        patch.name = body.name
      }
      if body.description != null {
        patch.description = body.description
      }
      if body.status != null {
        patch.status = body.status
      }
      if body.color != null {
        patch.color = body.color
      }
      db.update("Project", params.id, patch)
      return { "ok": true, "body": db.queryOne("SELECT * FROM Project WHERE id = ?", [params.id]) }
    }
  }

  route POST /api/approvals/:id/approve {
    auth true
    csrf true
    handler {
      applyApproval(params.id)
      return { "ok": true, "body": map { "approved": true } }
    }
  }

  route POST /api/approvals/:id/reject {
    auth true
    csrf true
    handler {
      rejectApproval(params.id)
      return { "ok": true, "body": map { "rejected": true } }
    }
  }

  route POST /api/search/run {
    auth true
    csrf true
    rateLimit "research:run"
    handler {
      provider = body.provider
      query = body.query
      result = search.run(query, map { "provider": provider, "maxResults": 8 })
      return { "ok": true, "body": result }
    }
  }

  route GET /api/health {
    auth false
    handler {
      return { "ok": true, "body": map { "status": "ok", "version": "1.0.0", "time": nowIso() } }
    }
  }
}
api {
  route POST /api/auth/login/github {
    auth false
    handler {
      state = crypto.randomHex(16)
      cache.set("oauth:" + state, "github", 300)
      url = oauth.github.startUrl(env.GITHUB_OAUTH_CLIENT_ID, env.PUBLIC_URL + "/auth/github/callback", state)
      return redirect(url)
    }
  }

  route POST /api/auth/login/google {
    auth false
    handler {
      state = crypto.randomHex(16)
      cache.set("oauth:" + state, "google", 300)
      url = oauth.google.startUrl(env.GOOGLE_OAUTH_CLIENT_ID, env.PUBLIC_URL + "/auth/google/callback", state)
      return redirect(url)
    }
  }

  route POST /api/auth/refresh {
    auth true
    csrf true
    handler {
      s = db.queryOne("SELECT * FROM Session WHERE id = ? AND user_id = ? AND revoked_at IS NULL", [session.id, user.id])
      if s == null {
        return { "ok": false, "status": 401 }
      }
      newCsrf = crypto.randomHex(32)
      db.update("Session", s.id, map { "csrf_token": newCsrf, "expires_at": date.addDays(nowIso(), 30) })
      return { "ok": true, "body": map { "csrfToken": newCsrf } }
    }
  }

  route GET /api/me {
    auth true
    handler {
      u = db.queryOne("SELECT * FROM User WHERE id = ?", [user.id])
      return { "ok": true, "body": map {
        "id": u.id,
        "name": u.name,
        "email": u.email,
        "avatarUrl": u.avatar_url,
        "provider": u.provider,
        "locale": u.locale
      } }
    }
  }

  route PATCH /api/me {
    auth true
    csrf true
    handler {
      patch = map { "updated_at": nowIso() }
      if body.name != null {
        patch.name = body.name
      }
      if body.locale != null {
        patch.locale = body.locale
      }
      db.update("User", user.id, patch)
      return { "ok": true, "body": map { "updated": true } }
    }
  }

  route GET /api/conversations/:id {
    auth true
    handler {
      c = db.queryOne("SELECT * FROM Conversation WHERE id = ? AND user_id = ?", [params.id, user.id])
      if c == null {
        return { "ok": false, "status": 404 }
      }
      return { "ok": true, "body": c }
    }
  }

  route DELETE /api/conversations/:id {
    auth true
    csrf true
    requiresApproval "delete"
    handler {
      id = requestApproval("delete", "Conversation", params.id, map { "id": params.id })
      return { "ok": true, "body": map { "approvalId": id } }
    }
  }

  route POST /api/conversations/:id/archive {
    auth true
    csrf true
    handler {
      c = db.queryOne("SELECT * FROM Conversation WHERE id = ? AND user_id = ?", [params.id, user.id])
      if c == null {
        return { "ok": false, "status": 404 }
      }
      db.update("Conversation", params.id, map { "archived": true, "updated_at": nowIso() })
      return { "ok": true, "body": map { "archived": true } }
    }
  }

  route POST /api/conversations/:id/unarchive {
    auth true
    csrf true
    handler {
      c = db.queryOne("SELECT * FROM Conversation WHERE id = ? AND user_id = ?", [params.id, user.id])
      if c == null {
        return { "ok": false, "status": 404 }
      }
      db.update("Conversation", params.id, map { "archived": false, "updated_at": nowIso() })
      return { "ok": true, "body": map { "archived": false } }
    }
  }

  route GET /api/conversations/search {
    auth true
    handler {
      q = request.query["q"]
      if q == "" {
        return { "ok": true, "body": map { "items": [] } }
      }
      like = "%" + q + "%"
      items = db.query("SELECT * FROM Conversation WHERE user_id = ? AND title LIKE ? ORDER BY last_message_at DESC LIMIT 50", [user.id, like])
      return { "ok": true, "body": map { "items": items } }
    }
  }

  route POST /api/messages/:id/copy {
    auth true
    handler {
      m = db.queryOne("SELECT * FROM Message WHERE id = ? AND user_id = ?", [params.id, user.id])
      if m == null {
        return { "ok": false, "status": 404 }
      }
      audit(user.id, "message.copy", "Message", params.id, "success", map {})
      return { "ok": true, "body": map { "content": m.content } }
    }
  }

  route DELETE /api/messages/:id {
    auth true
    csrf true
    requiresApproval "delete"
    handler {
      id = requestApproval("delete", "Message", params.id, map { "id": params.id })
      return { "ok": true, "body": map { "approvalId": id } }
    }
  }

  route GET /api/files/:id {
    auth true
    handler {
      f = db.queryOne("SELECT * FROM File WHERE id = ? AND user_id = ? AND status != 'deleted'", [params.id, user.id])
      if f == null {
        return { "ok": false, "status": 404 }
      }
      return { "ok": true, "body": f }
    }
  }

  route PATCH /api/files/:id {
    auth true
    csrf true
    handler {
      f = db.queryOne("SELECT * FROM File WHERE id = ? AND user_id = ?", [params.id, user.id])
      if f == null {
        return { "ok": false, "status": 404 }
      }
      patch = map { "updated_at": nowIso() }
      if body.name != null {
        patch.name = body.name
      }
      if body.project_id != null {
        patch.project_id = body.project_id
      }
      if body.conversation_id != null {
        patch.conversation_id = body.conversation_id
      }
      if body.task_id != null {
        patch.task_id = body.task_id
      }
      db.update("File", params.id, patch)
      return { "ok": true, "body": db.queryOne("SELECT * FROM File WHERE id = ?", [params.id]) }
    }
  }

  route POST /api/files/:id/version {
    auth true
    csrf true
    handler {
      f = db.queryOne("SELECT * FROM File WHERE id = ? AND user_id = ?", [params.id, user.id])
      if f == null {
        return { "ok": false, "status": 404 }
      }
      upload = request.file
      if upload == null {
        return { "ok": false, "status": 400 }
      }
      key = user.id + "/" + f.id + "/v" + (f.version + 1) + "/" + upload.name
      r2.put(env.AL_BUCKET, key, upload.data, map { "httpMetadata": map { "contentType": upload.mime } })
      db.update("File", f.id, map {
        "r2_key": key,
        "version": f.version + 1,
        "size": upload.size,
        "mime": upload.mime,
        "updated_at": nowIso()
      })
      return { "ok": true, "body": map { "version": f.version + 1 } }
    }
  }

  route DELETE /api/files/:id {
    auth true
    csrf true
    requiresApproval "delete"
    handler {
      id = requestApproval("delete", "File", params.id, map { "id": params.id })
      return { "ok": true, "body": map { "approvalId": id } }
    }
  }

