  route GET /api/memory/search {
    auth true
    handler {
      q = request.query["q"]
      if q == "" {
        return { "ok": true, "body": map { "items": [] } }
      }
      like = "%" + q + "%"
      items = db.query("SELECT * FROM MemoryEntry WHERE user_id = ? AND content LIKE ? ORDER BY importance DESC LIMIT 100", [user.id, like])
      return { "ok": true, "body": map { "items": items } }
    }
  }

