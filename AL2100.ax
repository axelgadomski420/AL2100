  route POST /api/files/upload {
    auth true
    csrf true
    rateLimit "files:upload"
    handler {
      f = request.file
      if f == null {
        return { "ok": false, "status": 400 }
      }
      if f.size > 26214400 {
        return { "ok": false, "status": 413 }
      }
      fid = newId("fil")
      key = user.id + "/" + fid + "/" + f.name
      r2.put(env.AL_BUCKET, key, f.data, map { "httpMetadata": map { "contentType": f.mime } })
      text = ""
      if f.mime.startsWith("text/") {
        text = f.text()
      }
      if f.mime == "application/pdf" {
        text = pdf.extractText(f.data)
      }
      db.insert("File", map {
        "id": fid,
        "user_id": user.id,
        "conversation_id": body.conversation_id,
        "name": f.name,
        "mime": f.mime,
        "size": f.size,
        "r2_key": key,
        "version": 1,
        "status": "ready",
        "extracted_text": text,
        "created_at": nowIso(),
        "updated_at": nowIso()
      })
      audit(user.id, "file.upload", "File", fid, "success", map { "size": f.size })
      return { "ok": true, "body": map { "file_id": fid } }
    }
  }

