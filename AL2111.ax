  route POST /api/chat/send {
    auth true
    csrf true
    rateLimit "chat:send"
    stream true
    handler {
      cid = body.conversation_id
      content = body.content
      if cid == "" || content == "" {
        return { "ok": false, "status": 400 }
      }
      cn = db.queryOne("SELECT * FROM Conversation WHERE id = ? AND user_id = ?", [cid, user.id])
      if cn == null {
        return { "ok": false, "status": 404 }
      }
      uid = newId("msg")
      db.insert("Message", map {
        "id": uid,
        "conversation_id": cid,
        "user_id": user.id,
        "role": "user",
        "content": content,
        "status": "completed",
        "tokens": 0,
        "provider": "",
        "model": "",
        "citations": [],
        "created_at": nowIso()
      })
      context = logic.buildContext(cid, content)
      router = logic.pickProvider(body.web_search, content)
      if router == null {
        return { "ok": false, "status": 503, "body": map { "error": "no_provider" } }
      }
      aid = newId("msg")
      db.insert("Message", map {
        "id": aid,
        "conversation_id": cid,
        "user_id": user.id,
        "role": "assistant",
        "content": "",
        "status": "streaming",
        "tokens": 0,
        "provider": router.provider,
        "model": router.model,
        "citations": [],
        "created_at": nowIso()
      })
      stream = ai.stream(router.provider, router.model, context, body.attachments)
      full = ""
      stream.onChunk {
        full = full + chunk
        db.update("Message", aid, map { "content": full })
        sse.emit(map { "delta": chunk, "provider": router.provider, "model": router.model })
      }
      stream.onDone {
        db.update("Message", aid, map { "content": full, "status": "completed", "tokens": stream.tokens })
        db.update("Conversation", cid, map { "last_message_at": nowIso(), "updated_at": nowIso(), "provider": router.provider, "model": router.model })
        logic.rememberFacts(cid, content, full)
        audit(user.id, "chat.send", "Conversation", cid, "success", map { "tokens": stream.tokens })
      }
      stream.onError {
        db.update("Message", aid, map { "status": "failed" })
        sse.emit(map { "error": "generation_failed" })
      }
      return stream
    }
  }

  route POST /api/chat/stop {
    auth true
