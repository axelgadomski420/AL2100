app "AL2100" {
  id "pl.axel.al2100"
  version 1.0.0
  author "Axel G"
  theme dark
  accent neon-cyan
  offline true
  language ["pl", "en"]
}

theme {
  mode dark
  colors {
    background #0A0F1E
    surface #121A2E
    surfaceElevated #17213A
    surfaceMuted #0E1526
    border #1F2A44
    borderFocus #00E5FF
    text #EAF2FF
    textMuted #93A1C4
    textInverse #04121B
    primary #00E5FF
    primaryPressed #00B8CC
    secondary #7C4DFF
    secondaryPressed #6A3FE0
    success #22E39A
    warning #FFB547
    danger #FF4D6D
    info #4DA3FF
    overlay #000000CC
    shadow #00000080
  }
  typography {
    base "Inter"
    heading "Space Grotesk"
    mono "JetBrains Mono"
    size.xs 12
    size.sm 14
    size.base 16
    size.md 18
    size.lg 22
    size.xl 28
    size.xxl 36
    weight.regular 400
    weight.medium 500
    weight.semibold 600
    weight.bold 700
    lineHeight.tight 1.2
    lineHeight.normal 1.5
    lineHeight.loose 1.75
    tracking.tight -0.01
    tracking.normal 0
    tracking.wide 0.02
  }
  shape {
    radius.xs 6
    radius.sm 10
    radius.md 14
    radius.lg 20
    radius.xl 28
    radius.pill 999
    shadow.soft "0 8px 24px rgba(0,0,0,0.35)"
    shadow.medium "0 16px 48px rgba(0,0,0,0.45)"
    shadow.hard "0 24px 72px rgba(0,0,0,0.55)"
  }
  motion {
    speed normal
    duration.fast 140ms
    duration.normal 220ms
    duration.slow 320ms
    duration.slower 480ms
    easing.standard "cubic-bezier(0.2, 0.0, 0.0, 1.0)"
    easing.enter "cubic-bezier(0.0, 0.0, 0.2, 1.0)"
    easing.exit "cubic-bezier(0.4, 0.0, 1.0, 1.0)"
    reduceMotion respectSystem
  }
  spacing {
    xxs 4
    xs 8
    sm 12
    md 16
    lg 24
    xl 32
    xxl 48
    xxxl 64
  }
}

permissions {
  internet: ask reason "Do wyszukiwania w sieci, dostawców AI, GitHuba i Cloudflare"
  camera: ask reason "Aby robić zdjęcia i załączać do rozmów"
  microphone: ask reason "Aby nagrywać głos i transkrybować"
  notifications: ask reason "Aby powiadamiać o zadaniach, deployach i zakończonych generacjach"
  files: read
  files.write: ask
  clipboard.write: ask
  clipboard.read: ask
  storage.persistent: allow
  location: deny
  contacts: deny
}

sync {
  provider userChoice
  scope ["Note", "Task", "Project", "MemoryEntry", "Conversation", "Message", "File", "MusicRelease", "MusicTrack", "Deployment", "GitHubRepo"]
  conflict lastWriteWins
  encrypt endToEnd
  offlineQueue true
  maxRetries 5
  backoff "exponential"
}

ai {
  name "AL2100"
  role "Ultra-asystent operacyjny"
  mode propose
  providers {
    gemini {
      apiKey from secure "gemini_key"
      baseUrl "https://generativelanguage.googleapis.com/v1beta"
      models ["gemini-2.5-pro", "gemini-2.5-flash"]
      defaultModel "gemini-2.5-flash"
      streaming true
    }
    groq {
      apiKey from secure "groq_key"
      baseUrl "https://api.groq.com/openai/v1"
      models ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"]
      defaultModel "llama-3.3-70b-versatile"
      streaming true
    }
    mistral {
      apiKey from secure "mistral_key"
      baseUrl "https://api.mistral.ai/v1"
      models ["mistral-large-latest", "mistral-small-latest", "codestral-latest"]
      defaultModel "mistral-large-latest"
      streaming true
    }
    openrouter {
      apiKey from secure "openrouter_key"
      baseUrl "https://openrouter.ai/api/v1"
      models ["openrouter/auto"]
      defaultModel "openrouter/auto"
      streaming true
    }
    cloudflare {
      accountId from secure "cf_account_id"
      apiKey from secure "cf_api_token"
      baseUrl "https://api.cloudflare.com/client/v4/accounts"
      models ["@cf/meta/llama-3.1-70b-instruct", "@cf/meta/llama-3.1-8b-instruct"]
      defaultModel "@cf/meta/llama-3.1-70b-instruct"
      streaming true
    }
    anthropic {
      apiKey from secure "anthropic_key"
      baseUrl "https://api.anthropic.com/v1"
      models ["claude-sonnet-4-5", "claude-haiku-4-5"]
      defaultModel "claude-sonnet-4-5"
      streaming true
    }
    openai {
      apiKey from secure "openai_key"
      baseUrl "https://api.openai.com/v1"
      models ["gpt-5", "gpt-5-mini"]
      defaultModel "gpt-5-mini"
      streaming true
    }
  }
  routing {
    chat => fastestAvailable
    code => bestCodeModel
    research => longestContextModel
    vision => bestVisionModel
    audio => bestAudioModel
  }
  limits {
    maxTokensPerRequest 32000
    maxTokensPerConversation 200000
    maxDailyCost 5.00
    maxConcurrentGenerations 1
    maxAgentSteps 24
    maxAgentSeconds 180
  }
  safety {
    confirmBeforeDelete true
    confirmBeforeDeploy true
    confirmBeforePush true
    confirmBeforeExternalCall true
    hideSecrets true
    redactLogs true
    blockUnknownProviders true
    blockSsrf true
  }
}

state {
  user.id = ""
  user.name = ""
  user.email = ""
  user.avatarUrl = ""
  user.provider = ""
  user.locale = "pl"
  user.theme = "dark"
  user.createdAt = ""
  session.id = ""
  session.expiresAt = ""
  session.csrfToken = ""
  session.rateBucket = "normal"
  session.activeSessions = list<map> []
  nav.current = "Czat"
  nav.previous = ""
  nav.commandPaletteOpen = false
  nav.sidebarCollapsed = false
  nav.mobileSheet = ""
  chat.conversations = list<map> []
  chat.activeConversationId = ""
  chat.messages = list<map> []
  chat.draft = ""
  chat.attachments = list<map> []
  chat.search = ""
  chat.showArchived = false
  chat.generation.status = "idle"
  chat.generation.tokens = 0
  chat.generation.abortController = ""
  chat.generation.startedAt = ""
  chat.generation.provider = ""
  chat.generation.model = ""
  chat.privateMode = false
  chat.webSearchEnabled = true
  chat.contextBudget = 24000
  chat.lastError = ""
  memory.entries = list<map> []
  memory.search = ""
  memory.filter = "all"
  memory.showDisabled = false
  memory.contextMode = "normal"
  memory.lastBuildAt = ""
  memory.lastBuildTokens = 0
  projects.items = list<map> []
  projects.activeId = ""
  projects.view = "all"
  tasks.items = list<map> []
  tasks.view = "today"
  tasks.filter = "all"
  files.items = list<map> []
  files.uploading = false
  files.uploadProgress = 0
  files.selectedId = ""
  files.filter = "all"
  research.query = ""
  research.results = list<map> []
  research.sources = list<map> []
  research.status = "idle"
  research.error = ""
  github.connected = false
  github.login = ""
  github.repos = list<map> []
  github.activeRepo = ""
  github.branch = "main"
  github.diff = ""
  github.pullRequest = map { "url": "", "number": 0, "state": "" }
  github.status = "idle"
  deploy.targets = list<map> []
  deploy.activeTarget = ""
  deploy.logs = list<text> []
  deploy.status = "idle"
  deploy.requiresApproval = true
  deploy.lastDeploymentId = ""
  appCreator.description = ""
  appCreator.plan = ""
  appCreator.code = ""
  appCreator.template = ""
  appCreator.status = "idle"
  appCreator.diff = ""
  appCreator.requiresApproval = true
  music.releases = list<map> []
  music.activeReleaseId = ""
  music.tracks = list<map> []
  music.view = "releases"
  settings.providers = list<map> []
  settings.selectedProvider = ""
  settings.testStatus = "idle"
  settings.rateLimitPerMinute = 60
  settings.auditLog = list<map> []
  settings.diagnostics = map {}
  agents.registry = list<map> []
  agents.activeRuns = list<map> []
  agents.lastRunId = ""
  agents.forcedMode = "auto"
  approvals.items = list<map> []
  approvals.pendingCount = 0
  diagnostics.checks = list<map> []
  diagnostics.lastRunAt = ""
  diagnostics.overall = "unknown"
  ui.toast = map { "id": "", "type": "", "message": "" }
  ui.modal = map { "name": "", "payload": "" }
  ui.online = true
  ui.loading = false
  ui.error = ""

  computed progress {
    return chat.messages.length / 100
  }
  computed hasActiveSession {
    return session.id != ""
  }
  computed pendingApprovalsCount {
    return approvals.items.length
  }
  computed activeProviderLabel {
    if settings.selectedProvider == "" {
      return "brak"
    }
    return settings.selectedProvider
  }
  computed currentRoute {
    return nav.current
  }
  computed isGenerating {
    return chat.generation.status == "streaming" || chat.generation.status == "pending"
  }
  computed canSend {
    return chat.draft != "" && !isGenerating
  }
  computed memoryStatus {
    if memory.contextMode == "degraded" {
      return "ograniczony"
    }
    return "pełny"
  }
  computed nextStep {
    if tasks.items.length == 0 {
      return "Brak zadań — dodaj pierwsze"
    }
    return tasks.items[0].title
  }

  event chat.draft changed {
    if chat.draft.length > 8000 {
      notify "Szkic przekracza 8000 znaków"
    }
  }
  event chat.generation.status changed {
    if chat.generation.status == "completed" {
      notify "Odpowiedź gotowa"
    }
    if chat.generation.status == "failed" {
      notify "Generacja nie powiodła się"
    }
  }
  event approvals.pendingCount changed {
    if approvals.pendingCount > 0 {
      notify "Masz {approvals.pendingCount} zatwierdzeń do przejrzenia"
    }
  }
  event ui.online changed {
    if !ui.online {
      notify "Tryb offline — operacje sieciowe wstrzymane"
    }
  }
}

storage local "al2100.axdb" {
  model User {
    id auto
    provider text
    provider_user_id text
    email text
    name text
    avatar_url text
    locale text
    created_at datetime
    updated_at datetime
    last_login_at datetime
  }
  model Session {
    id auto
    user_id text
    csrf_token text
    ip_hash text
    user_agent text
    created_at datetime
    expires_at datetime
    revoked_at datetime optional
    provider text
  }
  model Conversation {
    id auto
    user_id text
    project_id text optional
    title text
    archived bool
    private_mode bool
    web_search bool
    created_at datetime
    updated_at datetime
    last_message_at datetime
    tokens_used number
    provider text
    model text
  }
  model Message {
    id auto
    conversation_id text
    user_id text
    role enum ["user", "assistant", "system", "tool"]
    content text
    status enum ["pending", "streaming", "completed", "interrupted", "failed"]
    tokens number
    provider text
    model text
    citations json
    created_at datetime
    edited_at datetime optional
    parent_id text optional
  }
  model Attachment {
    id auto
    user_id text
    conversation_id text optional
    file_id text
    kind enum ["text", "image", "pdf", "audio", "other"]
    mime text
    size number
    created_at datetime
  }
  model MemoryEntry {
    id auto
    user_id text
    scope enum ["global", "project", "conversation"]
    scope_id text optional
    kind enum ["fact", "decision", "rejection", "question", "blocker", "summary"]
    content text
    pinned bool
    disabled bool
    importance number
    created_at datetime
    updated_at datetime
    source_message_id text optional
    approval_state enum ["auto", "user_confirmed", "user_rejected"]
  }
  model Project {
    id auto
    user_id text
    name text
    description text
    status enum ["active", "paused", "archived"]
    color text
    created_at datetime
    updated_at datetime
  }
  model Task {
    id auto
    user_id text
    project_id text optional
    conversation_id text optional
    file_id text optional
    title text
    description text
    status enum ["todo", "doing", "done", "blocked"]
    priority enum ["low", "normal", "high", "critical"]
    deadline datetime optional
    depends_on json
    created_at datetime
    updated_at datetime
  }
  model File {
    id auto
    user_id text
    project_id text optional
    conversation_id text optional
    task_id text optional
    name text
    mime text
    size number
    r2_key text
    version number
    status enum ["uploading", "ready", "failed", "deleted"]
    extracted_text text optional
    created_at datetime
    updated_at datetime
    deleted_at datetime optional
  }
  model ResearchSource {
    id auto
    user_id text
    conversation_id text optional
    query text
    url text
    title text
    snippet text
    published_at datetime optional
    fetched_at datetime
    trust_score number
  }
  model ProviderKey {
    id auto
    user_id text
    provider text
    encrypted_key text
    nonce text
    version number
    status enum ["active", "invalid", "deleted"]
    last_tested_at datetime optional
    created_at datetime
  }
  model GitHubRepo {
    id auto
    user_id text
    repo_full_name text
    default_branch text
    connected_at datetime
    last_sync_at datetime optional
    scope json
    status enum ["active", "revoked"]
  }
  model Deployment {
    id auto
    user_id text
    target text
    environment enum ["preview", "production"]
    status enum ["requested", "approved", "running", "succeeded", "failed", "rolled_back"]
    approved_by text optional
    approved_at datetime optional
    started_at datetime
    finished_at datetime optional
    logs json
    commit_sha text optional
  }
  model MusicRelease {
    id auto
    user_id text
    title text
    kind enum ["single", "album", "ep"]
    release_date date optional
    status enum ["draft", "in_progress", "mixed", "mastered", "released"]
    cover_file_id text optional
    distribution text
    rights_status enum ["unset", "in_review", "cleared", "blocked"]
    description text
    created_at datetime
    updated_at datetime
  }
  model MusicTrack {
    id auto
    user_id text
    release_id text
    title text
    position number
    bpm number
    key text
    energy number
    duration_seconds number
    version text
    mix_status enum ["unmixed", "mixing", "mixed", "mastered"]
    references json
    suno_prompt text
    elevenlabs_prompt text
    created_at datetime
    updated_at datetime
  }
  model AuditLog {
    id auto
    user_id text optional
    action text
    resource text
    resource_id text optional
    ip_hash text
    user_agent text
    result enum ["success", "failure", "denied"]
    created_at datetime
    metadata json
  }
  model AgentRun {
    id auto
    user_id text
    agent text
    conversation_id text optional
    status enum ["queued", "running", "succeeded", "failed", "cancelled"]
    steps number
    tokens number
    cost number
    started_at datetime
    finished_at datetime optional
    log json
  }
  model Approval {
    id auto
    user_id text
    kind enum ["delete", "deploy", "push", "external_call", "memory_promote", "task_accept"]
    resource text
    resource_id text optional
    payload json
    status enum ["pending", "approved", "rejected", "expired"]
    created_at datetime
    resolved_at datetime optional
    resolved_by text optional
  }
  index User.provider
  index User.email
  index Session.user_id
  index Session.expires_at
  index Conversation.user_id
  index Conversation.last_message_at
  index Conversation.project_id
  index Message.conversation_id
  index Message.created_at
  index Message.status
  index Attachment.conversation_id
  index MemoryEntry.user_id
  index MemoryEntry.scope
  index MemoryEntry.importance
  index Project.user_id
  index Project.status
  index Task.user_id
  index Task.status
  index Task.priority
  index Task.deadline
  index File.user_id
  index File.project_id
  index File.conversation_id
  index File.status
  index ResearchSource.user_id
  index ResearchSource.conversation_id
  index ProviderKey.user_id
  index ProviderKey.provider
  index GitHubRepo.user_id
  index Deployment.user_id
  index Deployment.status
  index MusicRelease.user_id
  index MusicTrack.release_id
  index AuditLog.user_id
  index AuditLog.created_at
  index AgentRun.user_id
  index AgentRun.status
  index Approval.user_id
  index Approval.status
}

component AppShell {
  layout {
    mode responsive
    desktop {
      grid "280px 1fr 320px"
      areas ["sidebar main context"]
    }
    mobile {
      stack vertical
      bottomNav true
    }
  }
}

component SidebarNav(active, collapsed, pendingCount) {
  surface {
    tone surface
    border right
    width 280
    padding lg
  }
  brand {
    title "AL2100"
    subtitle "System operacyjny AI"
    accent primary
  }
  nav {
    items [
      map { "id": "Czat", "label": "Czat", "icon": "sparkles" },
      map { "id": "Projekty", "label": "Projekty", "icon": "folder" },
      map { "id": "Zadania", "label": "Zadania", "icon": "check" },
      map { "id": "Pamięć", "label": "Pamięć", "icon": "brain" },
      map { "id": "Pliki", "label": "Pliki", "icon": "file" },
      map { "id": "Research", "label": "Research", "icon": "search" },
      map { "id": "Timeline", "label": "Timeline", "icon": "timeline" },
      map { "id": "App Creator", "label": "App Creator", "icon": "wrench" },
      map { "id": "GitHub", "label": "GitHub", "icon": "git" },
      map { "id": "Deploy", "label": "Deploy", "icon": "rocket" },
      map { "id": "Muzyka", "label": "Muzyka", "icon": "music" },
      map { "id": "Zatwierdzenia", "label": "Zatwierdzenia", "icon": "shield" },
      map { "id": "Sesje", "label": "Sesje", "icon": "user" },
      map { "id": "Ustawienia", "label": "Ustawienia", "icon": "gear" },
      map { "id": "Diagnostyka", "label": "Diagnostyka", "icon": "pulse" }
    ]
    active active
    collapsed collapsed
    onSelect {
      nav.current = item.id
    }
  }
  footer {
    badge pendingCount
    shortcut "Cmd/Ctrl + K"
  }
}

component TopBar(title, subtitle) {
  surface {
    tone surfaceElevated
    border bottom
    padding md
    sticky true
  }
  row {
    align center
    justify space-between
    title title
    subtitle subtitle
    actions {
      button "Cmd+K" {
        style ghost
        action {
          nav.commandPaletteOpen = true
        }
      }
    }
  }
}

component CommandPalette(open, onClose) {
  if open {
    overlay {
      tone overlay
      onDismiss onClose
    }
    dialog {
      radius lg
      shadow hard
      width 640
      input {
        placeholder "Szukaj ekranów, rozmów, zadań, plików, wspomnień…"
        autofocus true
      }
      list {
        items [
          map { "id": "chat", "label": "Przejdź do Czatu", "screen": "Czat" },
          map { "id": "projects", "label": "Przejdź do Projektów", "screen": "Projekty" },
          map { "id": "tasks", "label": "Przejdź do Zadań", "screen": "Zadania" },
          map { "id": "memory", "label": "Przejdź do Pamięci", "screen": "Pamięć" },
          map { "id": "files", "label": "Przejdź do Plików", "screen": "Pliki" },
          map { "id": "research", "label": "Przejdź do Research", "screen": "Research" },
          map { "id": "creator", "label": "Przejdź do App Creator", "screen": "App Creator" },
          map { "id": "github", "label": "Przejdź do GitHub", "screen": "GitHub" },
          map { "id": "deploy", "label": "Przejdź do Deploy", "screen": "Deploy" },
          map { "id": "music", "label": "Przejdź do Muzyka", "screen": "Muzyka" },
          map { "id": "approvals", "label": "Przejdź do Zatwierdzeń", "screen": "Zatwierdzenia" },
          map { "id": "sessions", "label": "Przejdź do Sesji", "screen": "Sesje" },
          map { "id": "settings", "label": "Przejdź do Ustawień", "screen": "Ustawienia" },
          map { "id": "diagnostics", "label": "Przejdź do Diagnostyki", "screen": "Diagnostyka" }
        ]
        onSelect {
          nav.current = item.screen
          onClose
        }
      }
    }
  }
}

component StatCard(title, value, progress) {
  card {
    padding lg
    radius md
    tone surface
    title {
      text title
      muted true
    }
    value {
      text value
      size xxl
      weight bold
    }
    progress {
      value progress
      tone primary
    }
  }
}

component ProviderRow(provider, status, maskedKey, lastTested) {
  row {
    align center
    justify space-between
    left {
      name {
        text provider
        weight semibold
      }
      key {
        text maskedKey
        mono true
        muted true
      }
      meta {
        text "Ostatni test: {lastTested}"
        size xs
        muted true
      }
    }
    right {
      badge status
      button "Test" {
        style ghost
        action {
          logic.testProvider(provider)
        }
      }
      button "Usuń" {
        style danger
        action {
          logic.requestDeleteProvider(provider)
        }
      }
    }
  }
}

component MessageBubble(message) {
  row {
    align start
    gap md
    role message.role
    bubble {
      radius md
      padding md
      tone message.role
      content {
        markdown message.content
        codeBlocksCopy true
      }
      meta {
        text "{message.created_at} · {message.provider}/{message.model} · {message.tokens} tok"
        size xs
        muted true
      }
      actions {
        button "Kopiuj" {
          style ghost
          action {
            clipboard.write message.content
          }
        }
        if message.role == "user" {
          button "Edytuj" {
            style ghost
            action {
              logic.openEditMessage(message.id)
            }
          }
        }
        if message.role == "assistant" && message.status == "completed" {
          button "Ponów" {
            style ghost
            action {
              logic.retryFromMessage(message.id)
            }
          }
        }
        button "Usuń" {
          style danger
          action {
            logic.requestDeleteMessage(message.id)
          }
        }
      }
      if message.citations != "" {
        citations {
          items message.citations
        }
      }
    }
  }
}

component Composer(draft, canSend, isGenerating) {
  surface {
    tone surfaceElevated
    border top
    padding md
    textarea {
      value draft
      placeholder "Napisz wiadomość… (Cmd/Ctrl + Enter)"
      autosize true
      maxRows 12
      onChange {
        chat.draft = value
      }
      onKey {
        if key == "Enter" && meta {
          logic.sendMessage()
        }
      }
    }
    row {
      align center
      justify space-between
      left {
        button "Załącz" {
          style ghost
          action {
            logic.openAttachmentPicker()
          }
        }
        button "Głos" {
          style ghost
          action {
            logic.startVoiceCapture()
          }
        }
        toggle "Web" {
          value chat.webSearchEnabled
          onChange {
            chat.webSearchEnabled = value
          }
        }
        toggle "Prywatny" {
          value chat.privateMode
          onChange {
            chat.privateMode = value
          }
        }
      }
      right {
        if isGenerating {
          button "Stop" {
            style danger
            action {
              logic.stopGeneration()
            }
          }
        } else {
          button "Wyślij" {
            style primary
            disabled !canSend
            action {
              logic.sendMessage()
            }
          }
        }
      }
    }
  }
}

component ConversationList(items, activeId, search, showArchived) {
  column {
    gap sm
    toolbar {
      input {
        value search
        placeholder "Szukaj rozmów"
        onChange {
          chat.search = value
        }
      }
      toggle "Archiwum" {
        value showArchived
        onChange {
          chat.showArchived = value
        }
      }
      button "Nowa" {
        style primary
        action {
          logic.createConversation()
        }
      }
    }
    list {
      items items
      active activeId
      onSelect {
        logic.selectConversation(item.id)
      }
      onRename {
        logic.renameConversation(item.id, item.title)
      }
      onArchive {
        logic.archiveConversation(item.id)
      }
      onDelete {
        logic.requestDeleteConversation(item.id)
      }
      onPinToProject {
        logic.pinConversationToProject(item.id)
      }
    }
  }
}

component ContextPanel(conversationId, memoryStatus, contextTokens, sourcesCount) {
  surface {
    tone surface
    border left
    padding md
    tabs {
      items ["Kontekst", "Pamięć", "Źródła", "Agenci"]
      section Kontekst {
        row {
          label "Rozmowa"
          value conversationId
        }
        row {
          label "Pamięć"
          value memoryStatus
        }
        row {
          label "Tokeny kontekstu"
          value contextTokens
        }
      }
      section Pamięć {
        list {
          items memory.entries
          onToggleDisabled {
            logic.toggleMemoryEntry(item.id)
          }
          onPin {
            logic.togglePinMemory(item.id)
          }
        }
      }
      section Źródła {
        text "Źródła: {sourcesCount}"
        list {
          items research.sources
          onOpen {
            logic.openSource(item.id)
          }
        }
      }
      section Agenci {
        list {
          items agents.activeRuns
        }
      }
    }
  }
}

component TaskRow(task) {
  row {
    align center
    justify space-between
    left {
      checkbox {
        value task.status == "done"
        onChange {
          logic.toggleTask(task.id, value)
        }
      }
      title {
        text task.title
        weight medium
      }
      meta {
        text "{task.priority} · {task.deadline}"
        size xs
        muted true
      }
    }
    right {
      badge task.status
      button "Edytuj" {
        style ghost
        action {
          logic.openEditTask(task.id)
        }
      }
      button "Usuń" {
        style danger
        action {
          logic.requestDeleteTask(task.id)
        }
      }
    }
  }
}

component FileRow(file) {
