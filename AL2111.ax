      justify space-between
      badge entry.kind
      controls {
        toggle "Pin" {
          value entry.pinned
          onChange {
            logic.setMemoryPinned(entry.id, value)
          }
        }
        toggle "Aktywne" {
          value !entry.disabled
          onChange {
            logic.setMemoryDisabled(entry.id, !value)
          }
        }
      }
    }
    content {
      text entry.content
      size sm
    }
    meta {
      text "{entry.scope} · importance {entry.importance} · {entry.approval_state}"
      size xs
      muted true
    }
  }
}

