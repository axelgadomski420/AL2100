{
  "name": "al2100",
  "version": "1.0.0",
  "private": true,
  "description": "AX2100 — prywatny system AxL (AI OS 2100)",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute al2100 --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute al2100 --local --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
