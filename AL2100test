fn openSafe(url) {
  if isSafeUrl(url) {
    location.href = url
  } else {
    toastMsg("URL zablokowany przez ochronę SSRF", "error")
  }
}

fn isSafeUrl(url) {
  if !url.starts_with("https://") { return false }
  if url.contains("localhost") { return false }
  if url.contains("127.0.0.1") { return false }
  if url.contains("0.0.0.0") { return false }
  if url.contains("10.") { return false }
  if url.contains("192.168.") { return false }
  if url.contains("169.254.") { return false }
  if url.contains("metadata.google") { return false }
  return true
}

