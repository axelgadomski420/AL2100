model User {
  id: text primary
  github_login: text unique
  display_name: text
  email: text
  avatar_url: text
  created_at: datetime
  last_seen_at: datetime
}

model Session {
  id: text primary
  user_id: ref User index
  created_at: datetime
  expires_at: datetime
  revoked_at: datetime
  user_agent: text
}

model Conversation {
  id: text primary
  user_id: ref User owner
  title: text
  project_id: text
  is_private: bool
  archived_at: datetime
  created_at: datetime
  updated_at: datetime
}

model Message {
  id: text primary
  conversation_id: ref Conversation index
  user_id: ref User owner
  role: text
  content: text
  status: text
  provider: text
  model: text
  tokens_in: int
  tokens_out: int
  cost_usd: real
  created_at: datetime
}

model MemoryFact {
  id: text primary
  user_id: ref User owner
  kind: text
  content: text
  source_conversation_id: text
  pinned: bool
  disabled: bool
  created_at: datetime
}

model ConversationSummary {
  id: text primary
  conversation_id: text unique
  user_id: ref User owner
  topic: text
  decisions: text
  next_step: text
  updated_at: datetime
}

model Provider {
  id: text primary
  user_id: ref User owner
  provider: text
  encrypted_key: text
  key_version: int
  model: text
  status: text
  last_tested_at: datetime
  last_error: text
}

model Project {
  id: text primary
  user_id: ref User owner
  name: text
  goal: text
  stage: text
  decisions: text
  blockers: text
  created_at: datetime
  updated_at: datetime
}

model Task {
  id: text primary
  user_id: ref User owner
  project_id: text
  title: text
  description: text
  status: text
  priority: text
  deadline: datetime
  created_at: datetime
  updated_at: datetime
}

model FileRecord {
  id: text primary
  user_id: ref User owner
  project_id: text
  filename: text
  mime: text
  size_bytes: int
  r2_key: text
  created_at: datetime
}

model Approval {
  id: text primary
  user_id: ref User owner
  action: text
  parameters: text
  token_hash: text unique
  consumed_at: datetime
  expires_at: datetime
  created_at: datetime
}

model AuditLog {
  id: text primary
  user_id: ref User index
  action: text
  target_type: text
  target_id: text
  metadata: text
  created_at: datetime
}

model UsageRecord {
  id: text primary
  user_id: ref User index
  kind: text
  provider: text
  model: text
  tokens_in: int
  tokens_out: int
  cost_usd: real
  created_at: datetime
}

model AppProposal {
  id: text primary
  user_id: ref User owner
  description: text
  plan: text
  status: text
  created_at: datetime
}

model MusicRelease {
  id: text primary
  user_id: ref User owner
  title: text
  artist: text
  type: text
  status: text
  release_date: text
  tracklist: text
  bpm: int
  key: text
  suno_prompt: text
  rights_status: text
  notes: text
  created_at: datetime
  updated_at: datetime
}

model RateLimit {
  id: text primary
  user_id: text index
  bucket: text
  count: int
  window_start: datetime
}

// ============================================================================
// COMPONENTS
// ============================================================================
component NavItem(label, target) {
  button "{label}" tone="ghost" {
    on click { navGo("{target}") }
  }
}

component StatCard(title, value, delta) {
  card {
    text "{title}" tone="muted"
    text "{value}"
    if delta != null { text "{delta}" tone="success" }
  }
}

component MessageBubble(role, content, status, created_at) {
  card {
    text "{role} • {created_at}" tone="muted"
    markdown "{content}"
    if status == "streaming" { progress 0 }
    button "Kopiuj" tone="ghost" {
      on click { copyToClipboard("{content}") }
    }
  }
}

component MemoryItemCard(kind, content, pinned, created_at) {
  card {
    badge "{kind}"
    text "{content}"
    text "{created_at}" tone="muted"
    if pinned { badge "przypięte" }
    button "Usuń" tone="danger" {
      on click { confirmAction("Usunąć wpis pamięci?", "{content}") }
    }
  }
}

component TaskItemCard(title, status, priority, deadline) {
  card {
    text "{title}"
    badge "{status}"
    badge "{priority}"
    text "{deadline}" tone="muted"
    button "Przełącz" tone="ghost" {
      on click { toggleTask("{title}") }
    }
  }
}

component ProjectCard(name, goal, stage) {
  card {
    text "{name}"
    text "{goal}" tone="muted"
    badge "{stage}"
    button "Otwórz" tone="primary" {
      on click { openProject("{name}") }
    }
  }
}

component FileItemCard(filename, size, mime) {
  card {
    text "{filename}"
    text "{size} • {mime}" tone="muted"
    button "Usuń" tone="danger" {
      on click { confirmDeleteFile("{filename}") }
    }
  }
}

component ProviderCard(provider, model, status, last_error) {
  card {
    text "{provider}"
    text "{model}" tone="muted"
    badge "{status}"
    if last_error != null { text "{last_error}" tone="danger" }
    button "Edytuj" tone="ghost" {
      on click { editProvider("{provider}") }
    }
    button "Testuj" tone="secondary" {
      on click { testProvider("{provider}") }
    }
    button "Usuń" tone="danger" {
      on click { deleteProvider("{provider}") }
    }
  }
}

component ApprovalCard(action, parameters) {
  card {
    text "Wymaga zatwierdzenia: {action}" tone="warning"
    text "{parameters}" tone="muted"
    button "Zatwierdź" tone="primary" {
      on click { approvePending("{action}") }
    }
    button "Odrzuć" tone="danger" {
      on click { rejectPending("{action}") }
    }
  }
}

component ToastBar() {
  if ui.toast_message != null {
    card {
      text "{ui.toast_message}"
      button "OK" tone="ghost" {
        on click { closeToast() }
      }
    }
  }
}

component MusicCard(title, artist, type, status) {
  card {
    text "{title}"
    text "{artist} • {type}" tone="muted"
    badge "{status}"
    button "Otwórz" tone="primary" {
      on click { openMusic("{title}") }
    }
  }
}

component Sidebar() {
  stack {
    text "AL2100"
    NavItem("Czat", "Chat")
    NavItem("Projekty", "Projects")
    NavItem("Pamięć", "Memory")
    NavItem("Pliki", "Files")
    NavItem("Zadania", "Tasks")
    NavItem("Research", "Research")
    NavItem("Timeline", "Timeline")
    NavItem("App Creator", "AppCreator")
    NavItem("GitHub", "GitHub")
    NavItem("Deploy", "Deploy")
    NavItem("Muzyka", "Music")
    NavItem("Ustawienia", "Settings")
    NavItem("Diagnostyka", "Diagnostics")
  }
}

component ContextPanel() {
  stack {
    text "Kontekst"
    text "Tryb: {chat.context_mode}" tone="muted"
    text "Dostawca: {chat.selected_provider}" tone="muted"
    text "Zatwierdzenia: {approvals.pending}" tone="warning"
  }
}

component CommandPalette() {
  if nav.command_open {
    card {
      text "Command palette"
      input query placeholder="Szukaj..." value=""
      button "Czat" tone="ghost" { on click { navGo("Chat") } }
      button "Projekty" tone="ghost" { on click { navGo("Projects") } }
      button "Pamięć" tone="ghost" { on click { navGo("Memory") } }
      button "Ustawienia" tone="ghost" { on click { navGo("Settings") } }
      button "Zamknij" tone="danger" { on click { closeCommand() } }
    }
  }
}

component ConfirmDialog() {
  if ui.confirm_message != null {
    card {
      text "{ui.confirm_message}"
      button "Tak" tone="danger" { on click { confirmYes() } }
      button "Anuluj" tone="ghost" { on click { confirmNo() } }
    }
  }
}

