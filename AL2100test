// ============================================================================
// FUNCTIONS — top-level (klient + testy)
// ============================================================================
fn navGo(target) {
  nav.current = target
}

fn closeCommand() {
  nav.command_open = false
}

fn openCommand() {
  nav.command_open = true
}

fn toastMsg(message, kind) {
  ui.toast_message = message
  ui.toast_kind = kind
}

fn closeToast() {
  ui.toast_message = null
}

fn confirmAction(message, token) {
  ui.confirm_message = message
}

fn confirmYes() {
  ui.confirm_message = null
}

fn confirmNo() {
  ui.confirm_message = null
}

fn copyToClipboard(text) {
  clipboard.write(text)
  toastMsg("Skopiowano", "success")
}

async fn checkSession() {
  r = await api.get("/api/auth/me")
  if r.ok {
    auth.user_id = r.body.id
    auth.login = r.body.github_login
    auth.display_name = r.body.display_name
    auth.avatar_url = r.body.avatar_url
    auth.onboarding_done = r.body.onboarding_complete
  } else {
    auth.user_id = null
  }
  auth.checked = true
}

